            while ((k >= 0) && (lastB < 0.0)) {
                def kel:EVGElement (itemAt items k)
                if ((((itemAt placedRow k) + (itemAt rowSpans k)) - 1) == lastRow) {
                    def kb:double (this.lastBaselineOffsetOf(lay kel))
                    if (kb < 0.0) {
