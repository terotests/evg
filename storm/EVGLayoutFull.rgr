                        ; (its margin bottom edge that far above the row's end)
                        def wantBottom:double (rowEnd - (maxD - (mOuter - mLb)))
                        def nowBottom:double ((mel2.calculatedY + mel2.calculatedHeight) + mel2.box.marginBottomPx)
                        def shiftL:double (wantBottom - nowBottom)
                        ; (safe: not above the row's start)
                        def topNow:double (mel2.calculatedY - mel2.box.marginTopPx)
                        def rowTop:double ((startY + rowShift) + (lay.gridRowOffset(rowSizes (itemAt placedRow lm) rowGapPx)))
                        if ((topNow + shiftL) < rowTop) {
                            shiftL = (rowTop - topNow)
                        }
                        if (shiftL != 0.0) {
                            lay.translateSubtree(mel2 0.0 shiftL)
                        }
                    }
                    lm = (lm + 1)
                }
            }
        }
        lp = (lp + 1)
    }
    this.gridFirstBaseline(lay parent items placedRow rowSpans)
    }

    ; a grid's first (last) baseline is the shared baseline of the items of
    ; its first (last) row that align by a baseline, if there are any (CSS
    ; Grid 10.8); otherwise the first (last) item's, the first as in the
    ; core. The last is kept in calculatedLastBaseline for
    ; lastBaselineOffsetOf.
    fn gridFirstBaseline:void (lay:EVGLayout parent:EVGElement items:[EVGElement] placedRow:[int] rowSpans:[int]) {
        def itemCount:int (array_length items)
        if (itemCount == 0) {
            return
        }
        def firstRow:int -1
        def lastRow:int -1
        def i:int 0
        while (i < itemCount) {
            def r:int (itemAt placedRow i)
            if ((firstRow < 0) || (r < firstRow)) {
                firstRow = r
            }
            def re:int ((r + (itemAt rowSpans i)) - 1)
            if (re > lastRow) {
                lastRow = re
            }
            i = (i + 1)
        }
        def firstDone:boolean false
        def lastB:double -1.0
        def j:int 0
        while (j < itemCount) {
            def el:EVGElement (itemAt items j)
            def ga:string el.alignSelf
            if (((strlen ga) == 0) || (ga == "auto")) {
                ga = parent.alignItems
            }
            def byFirst:boolean ((ga == "baseline") || (ga == "first baseline"))
            def byLast:boolean (ga == "last baseline")
            if ((byFirst || byLast) && ((el.marginAutoTop || el.marginAutoBottom) == false)) {
                def top:double ((el.calculatedY - el.box.marginTopPx) - parent.calculatedY)
                def b:double (lay.baselineOffsetOf(el))
                if byLast {
                    b = (this.lastBaselineOffsetOf(lay el))
                    if (b < 0.0) {
                        b = (el.box.marginTopPx + el.calculatedHeight)
                    }
                }
                if ((firstDone == false) && ((itemAt placedRow j) == firstRow)) {
                    parent.calculatedBaseline = (top + b)
                    parent.calculatedDescent = 0.0
                    parent.hasBaseline = true
                    firstDone = true
                }
                if ((lastB < 0.0) && ((((itemAt placedRow j) + (itemAt rowSpans j)) - 1) == lastRow)) {
                    lastB = (top + b)
                }
            }
            j = (j + 1)
        }
        if (lastB < 0.0) {
            def k:int (itemCount - 1)
            while ((k >= 0) && (lastB < 0.0)) {
                def kel:EVGElement (itemAt items k)
                if ((((itemAt placedRow k) + (itemAt rowSpans k)) - 1) == lastRow) {
                    def kb:double (this.lastBaselineOffsetOf(lay kel))
                    if (kb < 0.0) {
                        kb = (kel.box.marginTopPx + kel.calculatedHeight)
                    }
                    lastB = (((kel.calculatedY - kel.box.marginTopPx) - parent.calculatedY) + kb)
                }
                k = (k - 1)
            }
        }
        parent.calculatedLastBaseline = lastB
    }

    fn gridAbsAreas:boolean (lay:EVGLayout parent:EVGElement cols:EVGGridTemplate colGap:double rowSizes:[double] rowGap:double rowTemplate:EVGGridTemplate innerWidth:double contentHeight:double startX:double startY:double colShift:double rowShift:double) {
        this.layoutGridAbsAreas(lay parent cols colGap rowSizes rowGap rowTemplate innerWidth contentHeight startX startY colShift rowShift)
        return true
    }

    ; the column flow's placements (CSS Grid 8.5) of `kids` into cs and
    ; rs, from their lines there (-1 auto) and spans
    fn columnFlowPlace:void (parent:EVGElement kids:[EVGElement] cs:[int] csp:[int] rs:[int] rsp:[int]) {
        def colTpl:EVGGridTemplate (EVGGridTemplate.parse(parent.gridTemplateColumns))
        def rowSpec:string parent.gridTemplateRows
        if ((rowSpec == "none") || (rowSpec == "subgrid")) {
            rowSpec = ""
        }
        ; (auto repeats count as many rows as the core expands them to)
        if ((indexOf rowSpec "auto-f") >= 0) {
            def rlay (new EVGLayout())
            def rgaps:[double] (rlay.gridGaps(parent parent.calculatedInnerWidth parent.calculatedInnerHeight))
            rowSpec = (rlay.gridRowRepeat(parent rowSpec parent.calculatedInnerHeight (itemAt rgaps 1)))
        }
        def rowTpl:EVGGridTemplate (EVGGridTemplate.parse(rowSpec))
        def nRows:int (rowTpl.count())
        if ((strlen rowSpec) == 0) {
            nRows = 0
        }
        def areas:EVGGridAreas (EVGGridAreas.parse(parent.gridTemplateAreas))
        if ((strlen parent.gridTemplateAreas) > 0) {
            if (areas.rows > nRows) {
                nRows = areas.rows
            }
        }
        def k:int (array_length kids)
        def j:int 0
        while (j < k) {
            def c:EVGElement (itemAt kids j)
            def cp:EVGGridPlacement (EVGGridPlacement.parse(c.gridColumn))
            cp.resolveNames(colTpl)
            def rp:EVGGridPlacement (EVGGridPlacement.parse(c.gridRow))
            rp.resolveNames(rowTpl)
            push cs (cp.start - 1)
            push csp cp.span
            push rs (rp.start - 1)
            push rsp rp.span
            if ((rp.start > 0) && (((rp.start - 1) + rp.span) > nRows)) {
                nRows = ((rp.start - 1) + rp.span)
            }
            if ((rp.start <= 0) && (rp.span > nRows)) {
                nRows = rp.span
            }
            j = (j + 1)
        }
        if (nRows < 1) {
            nRows = 1
        }
        def taken:[string:boolean]
        def dense:boolean ((indexOf parent.gridAutoFlow "dense") >= 0)
        ; (where the items put in a column by the second pass end, the
        ; next one there goes past them unless dense)
        def lockEnd:[int]
        ; the items with both lines first, then the ones with a column,
        ; then the rest from the cursor
        def pass:int 0
        def curC:int 0
        def curR:int 0
        while (pass < 3) {
            def q:int 0
            while (q < k) {
                def c0:int (itemAt cs q)
                def r0:int (itemAt rs q)
                def sc:int (itemAt csp q)
                def sr:int (itemAt rsp q)
                def mine:boolean false
                if ((pass == 0) && ((c0 >= 0) && (r0 >= 0))) {
                    mine = true
                }
                if ((pass == 1) && ((c0 >= 0) && (r0 < 0))) {
                    mine = true
                    while ((array_length lockEnd) <= c0) {
                        push lockEnd 0
                    }
                    def rr:int 0
                    if (dense == false) {
                        rr = (itemAt lockEnd c0)
                    }
                    while ((EVGLayoutFull.areaTaken(taken c0 rr sc sr)) && (rr < 10000)) {
                        rr = (rr + 1)
                    }
                    r0 = rr
                    set lockEnd c0 (rr + sr)
                    ; (its rows are the implicit grid's before the rest
                    ; are placed, CSS Grid 8.5 step 3)
                    if ((rr + sr) > nRows) {
                        nRows = (rr + sr)
                    }
                }
                if ((pass == 2) && (c0 < 0)) {
                    mine = true
                    ; (dense: every item from the start of the grid)
                    if dense {
                        curC = 0
                        curR = 0
                    }
                    if (r0 >= 0) {
                        if (r0 < curR) {
                            curC = (curC + 1)
                        }
                        while ((EVGLayoutFull.areaTaken(taken curC r0 sc sr)) && (curC < 10000)) {
                            curC = (curC + 1)
                        }
                        c0 = curC
                        curR = (r0 + sr)
                    } {
                        def found:boolean false
                        while ((found == false) && (curC < 10000)) {
                            if ((curR + sr) > nRows) {
                                curC = (curC + 1)
                                curR = 0
                            } {
                                if (EVGLayoutFull.areaTaken(taken curC curR sc sr)) {
                                    curR = (curR + 1)
                                } {
                                    found = true
                                }
                            }
                        }
                        c0 = curC
                        r0 = curR
                        curR = (curR + sr)
                    }
                }
                if mine {
                    def a:int 0
                    while (a < sc) {
                        def b:int 0
                        while (b < sr) {
                            set taken (((to_string (c0 + a)) + ",") + (to_string (r0 + b))) true
                            b = (b + 1)
                        }
                        a = (a + 1)
                    }
                    set cs q c0
                    set rs q r0
                }
                q = (q + 1)
            }
            pass = (pass + 1)
        }
