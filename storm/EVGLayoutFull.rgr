                        fixX = (fixX + freeX)
                    }
                }
            } {
                if child.marginAutoLeft {
                    fixX = (fixX + freeX)
                }
            }
        }
        if ((child.top.isSet && child.bottom.isSet) && (child.marginAutoTop || child.marginAutoBottom)) {
            def freeY:double ((((innerHeight - child.top.pixels) - child.bottom.pixels) - child.calculatedHeight) - (child.box.marginTopPx + child.box.marginBottomPx))
            if (child.marginAutoTop && child.marginAutoBottom) {
                fixY = (fixY + (freeY / 2.0))
            } {
                if child.marginAutoTop {
                    fixY = (fixY + freeY)
                }
            }
        }
