                    set lockEnd c0 (rr + sr)
                    ; (its rows are the implicit grid's before the rest
                    ; are placed, CSS Grid 8.5 step 3)
                    if ((rr + sr) > nRows) {
                        nRows = (rr + sr)
                    }
                }
                if ((pass == 2) && (c0 < 0)) {
                    mine = true
                    ; (dense: every item from the start of the grid)
                    if dense {
                        curC = 0
                        curR = 0
                    }
                    if (r0 >= 0) {
                        if (r0 < curR) {
                            curC = (curC + 1)
                        }
                        while ((EVGLayoutFull.areaTaken(taken curC r0 sc sr)) && (curC < 10000)) {
                            curC = (curC + 1)
                        }
                        c0 = curC
                        curR = (r0 + sr)
                    } {
                        def found:boolean false
                        while ((found == false) && (curC < 10000)) {
                            if ((curR + sr) > nRows) {
                                curC = (curC + 1)
                                curR = 0
                            } {
                                if (EVGLayoutFull.areaTaken(taken curC curR sc sr)) {
                                    curR = (curR + 1)
                                } {
                                    found = true
                                }
                            }
                        }
                        c0 = curC
                        r0 = curR
                        curR = (curR + sr)
                    }
                }
                if mine {
                    def a:int 0
                    while (a < sc) {
                        def b:int 0
                        while (b < sr) {
                            set taken (((to_string (c0 + a)) + ",") + (to_string (r0 + b))) true
                            b = (b + 1)
                        }
                        a = (a + 1)
                    }
                    set cs q c0
                    set rs q r0
                }
                q = (q + 1)
            }
            pass = (pass + 1)
        }
    }

    ; grid-auto-flow: column: the items placed down the columns (CSS Grid
