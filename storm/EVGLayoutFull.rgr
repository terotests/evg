        def n:int (parent.getChildCount())
        def i:int 0
        while (i < n) {
            def c:EVGElement (parent.getChild(i))
            if c.isAbsolute {
                def ax:double 0.0
                def ay:double 0.0
                def aw:double innerWidth
                def ah:double contentHeight
                def colStarts:[double]
                def colEnds:[double]
                def cn:int 0
                ; (with no template and no item there is no track)
                def noItems:boolean true
                for parent.children ck:EVGElement cki {
                    if (ck.isAbsolute == false) {
                        noItems = false
                    }
                }
                def colsN:int (cols.count())
                if (noItems && (((strlen parent.gridTemplateColumns) == 0) || (parent.gridTemplateColumns == "none"))) {
                    colsN = 0
                }
                while (cn < colsN) {
                    push colStarts (colShift + (cols.offsetOf(cn colGap)))
                    push colEnds ((colShift + (cols.offsetOf(cn colGap))) + (cols.extentOf(cn 1 colGap)))
                    cn = (cn + 1)
                }
                ; (the padding edge: inside the border sides given as padding)
                def pcx:EVGCssExtra (EVGLayoutFull.cx(parent))
                def padS:double (parent.box.paddingLeftPx - pcx.foldL)
                def padE:double (parent.box.paddingRightPx - pcx.foldR)
                if parent.resolvedRtl {
                    padS = (parent.box.paddingRightPx - pcx.foldR)
                    padE = (parent.box.paddingLeftPx - pcx.foldL)
                }
                def colAuto:[double] (EVGLayoutFull.absAutoArea(c.gridColumn cols colStarts colEnds padS padE innerWidth))
                if ((array_length colAuto) == 2) {
                    ax = (itemAt colAuto 0)
                    aw = (itemAt colAuto 1)
                    if parent.resolvedRtl {
                        ax = ((innerWidth - ax) - aw)
                    }
                }
                if (((strlen c.gridColumn) > 0) && ((array_length colAuto) == 0)) {
                    def cp:EVGGridPlacement (EVGGridPlacement.parse(c.gridColumn))
                    cp.resolveNames(cols)
                    if (cp.start > 0) {
                        ; (lines past the tracks there are, the collapsed
                        ; ones of an auto-fit repeat, are at the grid's end)
                        def nc:int (cols.count())
                        def c0:int (cp.start - 1)
                        def cspan:int cp.span
                        if (c0 > nc) {
                            c0 = nc
                        }
                        if ((c0 + cspan) > nc) {
                            cspan = (nc - c0)
                        }
                        ax = (colShift + (cols.offsetOf(c0 colGap)))
                        aw = 0.0
                        if (cspan > 0) {
                            aw = (cols.extentOf(c0 cspan colGap))
                        }
                        ; (right to left the in-flow items are mirrored
                        ; afterwards; an area is mirrored here)
                        if parent.resolvedRtl {
                            ax = ((innerWidth - ax) - aw)
                        }
                    }
                }
                def rowStarts:[double]
                def rowEnds:[double]
                def rn:int 0
                def rowsN:int (array_length rowSizes)
                if (noItems && (((strlen parent.gridTemplateRows) == 0) || (parent.gridTemplateRows == "none"))) {
                    rowsN = 0
                }
                while (rn < rowsN) {
                    push rowStarts (rowShift + (lay.gridRowOffset(rowSizes rn rowGap)))
                    push rowEnds ((rowShift + (lay.gridRowOffset(rowSizes rn rowGap))) + (itemAt rowSizes rn))
                    rn = (rn + 1)
                }
                def rowAuto:[double] (EVGLayoutFull.absAutoArea(c.gridRow rowTemplate rowStarts rowEnds (parent.box.paddingTopPx - pcx.foldT) (parent.box.paddingBottomPx - pcx.foldB) contentHeight))
                if ((array_length rowAuto) == 2) {
                    ay = (itemAt rowAuto 0)
                    ah = (itemAt rowAuto 1)
                }
                if (((strlen c.gridRow) > 0) && ((array_length rowAuto) == 0)) {
                    def rp:EVGGridPlacement (EVGGridPlacement.parse(c.gridRow))
                    rp.resolveNames(rowTemplate)
                    if (rp.start > 0) {
                        ay = (rowShift + (lay.gridRowOffset(rowSizes (rp.start - 1) rowGap)))
                        ah = (lay.gridRowExtent(rowSizes (rp.start - 1) rp.span rowGap))
                    }
                }
                c.unitsResolved = false
                c.resolveUnits(aw ah)
                lay.layoutOutOfFlowChild(parent c aw ah (startX + ax) (startY + ay) true)
                if ((EVGLayoutFull.cx(c)).staticFlex || ((strlen ((EVGLayoutFull.cx(c)).staticAxis)) > 0)) {
                    def alongX:boolean ((EVGLayoutFull.cx(c)).staticFlex || ((EVGLayoutFull.cx(c)).staticAxis == "x"))
                    def alongY:boolean ((EVGLayoutFull.cx(c)).staticFlex || ((EVGLayoutFull.cx(c)).staticAxis == "y"))
                    def outW:double ((c.calculatedWidth + c.box.marginLeftPx) + c.box.marginRightPx)
                    def outH:double ((c.calculatedHeight + c.box.marginTopPx) + c.box.marginBottomPx)
                    def gj:string c.justifySelf
                    if ((strlen gj) == 0) {
                        gj = parent.justifyItems
                    }
                    def ga:string c.alignSelf
                    if ((strlen ga) == 0) {
                        ga = parent.alignItems
                    }
                    def dx:double 0.0
                    def dy:double 0.0
                    def toEndA:boolean ((gj == "end") || ((gj == "flex-end") || (gj == "self-end")))
                    if parent.resolvedRtl {
                        toEndA = ((toEndA == false) && (gj != "center"))
                    }
                    if (gj == "right") {
                        toEndA = true
                    }
                    if (gj == "left") {
                        toEndA = false
                    }
                    if (gj == "center") {
                        dx = ((aw - outW) / 2.0)
                    }
                    if toEndA {
                        dx = (aw - outW)
                    }
                    if (ga == "center") {
                        dy = ((ah - outH) / 2.0)
                    }
                    if ((ga == "end") || ((ga == "flex-end") || (ga == "self-end"))) {
                        dy = (ah - outH)
                    }
                    if (alongX == false) {
                        dx = 0.0
                    }
                    if (alongY == false) {
                        dy = 0.0
                    }
                    if ((dx != 0.0) || (dy != 0.0)) {
                        lay.translateSubtree(c dx dy)
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; an absolutely positioned grid item's area along one axis when a side
    ; of its placement is auto: that side is the grid container's padding
    ; edge (CSS Grid 1, 10.1; "auto / auto", the padding box, CSS Grid 2,
    ; 9.2). [from size] from the content edge, or nothing with no
    ; placement (EVG's content box) or a line name alone (an area's,
    ; resolved by the placement)
    sfn absAutoArea:[double] (spec0:string tpl:EVGGridTemplate starts:[double] ends:[double] padS:double padE:double inner:double) {
        def res:[double]
        def spec:string (trim spec0)
        if ((strlen spec) == 0) {
            return res
        }
        def lhs:string spec
        def rhs:string "auto"
        def slash:int (indexOf spec "/")
        if (slash >= 0) {
            lhs = (trim (substring spec 0 slash))
            rhs = (trim (substring spec (slash + 1) (strlen spec)))
        } {
            if ((lhs != "auto") && (EVGGridPlacement.isSpan(lhs) == false)) {
                if (EVGGridPlacement.isNumericToken(lhs) == false) {
                    return res
                }
                rhs = "span 1"
            }
        }
        def n:int (array_length starts)
        def lines:int (n + 1)
        def sLine:int 0
        def eLine:int 0
        if ((lhs != "auto") && (EVGGridPlacement.isSpan(lhs) == false)) {
            sLine = (EVGLayoutFull.lineOf(lhs tpl lines))
        }
        if ((rhs != "auto") && (EVGGridPlacement.isSpan(rhs) == false)) {
            eLine = (EVGLayoutFull.lineOf(rhs tpl lines))
        }
        if ((sLine > 0) && EVGGridPlacement.isSpan(rhs)) {
            eLine = (sLine + (EVGGridPlacement.spanCount(rhs)))
        }
        if ((eLine > 0) && EVGGridPlacement.isSpan(lhs)) {
            sLine = (eLine - (EVGGridPlacement.spanCount(lhs)))
            if (sLine < 1) {
                sLine = 0
            }
        }
        if (sLine < 0) {
            sLine = 0
        }
        if (eLine < 0) {
            eLine = 0
        }
        if (((sLine > 0) && (eLine > 0)) && (sLine > eLine)) {
            def sw:int sLine
            sLine = eLine
            eLine = sw
        }
        ; (a line past the grid's is auto)
        if (sLine > lines) {
            sLine = 0
        }
        if (eLine > lines) {
            eLine = 0
        }
        def from:double (0.0 - padS)
        def to:double (inner + padE)
        if (n == 0) {
            ; (only line 1, at the content edge)
            if (sLine == 1) {
                from = 0.0
            }
            if (eLine == 1) {
                to = 0.0
            }
            if (to < from) {
                to = from
            }
            push res from
            push res (to - from)
            return res
        }
        if (sLine > 0) {
            if (sLine <= n) {
                from = (itemAt starts (sLine - 1))
            } {
                from = (itemAt ends (n - 1))
            }
        }
        if (eLine > 0) {
            if (eLine >= 2) {
                to = (itemAt ends (eLine - 2))
            } {
                to = (itemAt starts 0)
            }
        }
        if (to < from) {
            to = from
        }
        push res from
        push res (to - from)
        return res
    }

    ; a grid line a placement's side names: a number (negative from the
    ; end) or a name, or 0 when it is none of the grid's
    sfn lineOf:int (tok:string tpl:EVGGridTemplate lines:int) {
        if (EVGGridPlacement.isNumericToken(tok)) {
            def v:int (EVGGridPlacement.lineNumber(tok))
            if (v < 0) {
                v = ((lines + 1) + v)
                if (v < 1) {
                    return 0
                }
            }
            return v
        }
        def named:int (tpl.lineNumberNamed(tok))
        if (named == 0) {
            named = (tpl.lineNumberNamed((tok + "-start")))
        }
        ; (a name the grid does not have is a line past it)
        if (named == 0) {
            named = (lines + 1)
        }
        return named
    }

    sfn areaTaken:boolean (taken:[string:boolean] c:int r:int sc:int sr:int) {
        def a:int 0
        while (a < sc) {
            def b:int 0
            while (b < sr) {
                if (has taken (((to_string (c + a)) + ",") + (to_string (r + b)))) {
                    return true
                }
                b = (b + 1)
            }
            a = (a + 1)
        }
        return false
    }

}
