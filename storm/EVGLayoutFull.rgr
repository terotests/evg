        ; then the rest from the cursor
        def pass:int 0
        def curC:int 0
        def curR:int 0
        while (pass < 3) {
            def q:int 0
            while (q < k) {
                def c0:int (itemAt cs q)
                def r0:int (itemAt rs q)
                def sc:int (itemAt csp q)
                def sr:int (itemAt rsp q)
                def mine:boolean false
                if ((pass == 0) && ((c0 >= 0) && (r0 >= 0))) {
                    mine = true
                }
                if ((pass == 1) && ((c0 >= 0) && (r0 < 0))) {
                    mine = true
                    while ((array_length lockEnd) <= c0) {
                        push lockEnd 0
                    }
                    def rr:int 0
                    if (dense == false) {
                        rr = (itemAt lockEnd c0)
                    }
                    while ((EVGLayoutFull.areaTaken(taken c0 rr sc sr)) && (rr < 10000)) {
                        rr = (rr + 1)
                    }
