        return staticY
    }

    ; Grid item placement (CSS Grid 8.5, row flow, sparse) for the grid's
    ; own intrinsic width: the items with both lines first, then those with
    ; a row, then the rest by the cursor. A placement past the explicit
    ; columns or a dense or column flow gives up (empty).
    fn gridItemColumns:[int] (lay:EVGLayout el:EVGElement tpl:EVGGridTemplate) {
        def none:[int]
        if (((indexOf el.gridAutoFlow "column") >= 0) || ((indexOf el.gridAutoFlow "dense") >= 0)) {
            return none
        }
        def nc:int (tpl.count())
        def rowTpl:EVGGridTemplate (EVGGridTemplate.parse(el.gridTemplateRows))
        def n:int (el.getChildCount())
        def cols:[int]
        def colSpan:[int]
        def rows:[int]
        def rowSpan:[int]
        def i:int 0
        while (i < n) {
            def kid:EVGElement (el.getChild(i))
            if (kid.isAbsolute || (kid.isHidden())) {
                push cols (0 - 2)
                push colSpan 1
                push rows -1
                push rowSpan 1
            } {
                def cp:EVGGridPlacement (EVGGridPlacement.parse(kid.gridColumn))
                cp.resolveNames(tpl)
