                        def m:double ((lay.minIntrinsicWidthOf(it)) - (fixed + curMin))
                        def w:double ((lay.intrinsicWidthOf(it)) - (fixed + curMax))
                        ; (the max-content part goes to the tracks no item
                        ; sizes yet, their growth limits being infinite,
                        ; when there are such)
                        def nE:int 0
                        def e:int c0
                        while (e < (c0 + span)) {
