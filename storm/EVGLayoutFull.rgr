                    def rpl:EVGGridPlacement (EVGGridPlacement.parse(rc.gridRow))
                    if ((rpl.start > 0) && (cpl.start == 0) && ((strlen cpl.startName) == 0) && (cpl.endLine == 0)) {
                        def rr:int (rpl.start - 1)
                        while (rr < ((rpl.start - 1) + rpl.span)) {
                            while ((array_length perRow) <= rr) {
                                push perRow 0
                            }
                            set perRow rr ((itemAt perRow rr) + cpl.span)
                            if ((itemAt perRow rr) > lastLine) {
                                lastLine = (itemAt perRow rr)
                            }
                            rr = (rr + 1)
                        }
                    }
                }
                ri = (ri + 1)
            }
        }
        ; (in a column flow, as many as the placement fills)
        if ((indexOf parent.gridAutoFlow "column") >= 0) {
            def fk:[EVGElement]
            def fi:int 0
            while (fi < (parent.getChildCount())) {
                def fc:EVGElement (parent.getChild(fi))
                if ((fc.hasAbsolutePosition()) == false) {
