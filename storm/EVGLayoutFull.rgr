                def ow:double ((c2.calculatedWidth + ml) + c2.box.marginRightPx)
                def oh:double ((c2.calculatedHeight + c2.box.marginTopPx) + c2.box.marginBottomPx)
                def y:double minTop
                def x:double 0.0
                def found:boolean false
                def guard:int 0
                while ((found == false) && (guard <= (array_length fx))) {
                    def le:double 0.0
                    def re:double W
                    def any:boolean false
                    def nextY:double -1.0
                    def band:double oh
                    if (band < 0.01) {
                        band = 0.01
                    }
                    def j:int 0
                    while (j < (array_length fx)) {
                        def top:double (itemAt fy j)
                        def bot:double (top + (itemAt fh j))
                        if ((top < (y + band)) && (bot > y)) {
                            any = true
