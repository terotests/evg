        }
        while (i < n) {
            def c:EVGElement (el.getChild(i))
            if ((c.isAbsolute == false) && ((c.isHidden()) == false)) {
                def cb:double (this.lastBaselineOffsetOf(lay c))
                if (cb >= 0.0) {
                    def bottom:double (c.calculatedY + c.calculatedHeight)
                    if (bottom >= bestBottom) {
