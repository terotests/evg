            }
            def nx:double (((startX + (itemAt lineX ln)) + dxIn) + it.box.marginLeftPx)
            def ny:double ((startY + y) + it.box.marginTopPx)
            lay.translateSubtree(it (nx - it.calculatedX) (ny - it.calculatedY))
            y = ((((y + it.calculatedHeight) + it.box.marginTopPx) + it.box.marginBottomPx) + gapPx)
            m = (m + 1)
        }
