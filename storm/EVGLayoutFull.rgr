    ; Floats by CSS 2.1 9.5.1: each as high as it fits, no higher than the
    ; one before it, a left one as far left and a right one as far right
    ; as the floats beside it allow; the row is as tall as its floats
    ; unless it is given a height. A row holding anything but floats
    ; keeps its flex lines.
    sfn placeFloats:void (row:EVGElement childCount:int) {
        def i:int 0
        while (i < childCount) {
            def c:EVGElement (row.getChild(i))
            if (c.isAbsolute == false) {
                def fs:string ((EVGLayoutFull.cx(c)).floatSide)
                if ((fs != "left") && (fs != "right")) {
                    return
                }
            }
            i = (i + 1)
        }
        def sx:double ((row.calculatedX + row.box.borderWidthPx) + row.box.paddingLeftPx)
        def sy:double ((row.calculatedY + row.box.borderWidthPx) + row.box.paddingTopPx)
        def W:double row.calculatedInnerWidth
        def fx:[double]
        def fy:[double]
        def fw:[double]
        def fh:[double]
        def fr:[boolean]
        def minTop:double 0.0
        def bottom:double 0.0
        i = 0
        while (i < childCount) {
            def c2:EVGElement (row.getChild(i))
            if (c2.isAbsolute == false) {
                def right:boolean (((EVGLayoutFull.cx(c2)).floatSide) == "right")
                ; (an auto margin is nothing on a float)
                def ml:double c2.box.marginLeftPx
                if c2.marginAutoLeft {
