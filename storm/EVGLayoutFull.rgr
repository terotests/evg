                } {
                    def c:int (charAt tok 0)
                    def c1:int c
                    if (((c == 45) || (c == 43)) && ((strlen tok) > 1)) {
                        c1 = (charAt tok 1)
                    }
                    ; ("-start" is a name)
                    if ((c1 >= 48) && (c1 <= 57)) {
                        def v@(optional):double (to_double tok)
                        if v {
                            p.n = (to_int (unwrap v))
                        }
                        if (p.n == 0) {
                            p.kind = (0 - 1)
                        }
                    } {
                        p.name = tok
                    }
                }
            }
        }
        if ((p.kind == 2) && (p.n == 0)) {
            p.n = 1
        }
        if ((p.kind == 2) && (p.n < 0)) {
            p.kind = (0 - 1)
        }
        if ((p.kind == 1) && ((p.n == 0) && ((strlen p.name) == 0))) {
            p.kind = (0 - 1)
        }
        return p
    }

    ; the line, `last` being the explicit grid's last
    fn lineIn:int (tpl:EVGGridTemplate last:int isStart:boolean) {
        if ((strlen name) == 0) {
            if (n > 0) {
                return n
            }
            return ((last + 1) + n)
        }
        ; (a lone name is an area's edge first: name-start or name-end)
        if (n == 0) {
            def edge:string (name + "-end")
            if isStart {
                edge = (name + "-start")
            }
            def el:int (tpl.lineNumberNamed(edge))
            if (el > 0) {
                return el
            }
        }
        def k:int n
        if (k == 0) {
            k = 1
        }
        return (tpl.nthLineNamed(name k))
    }

    ; the line `n` lines (or lines of the name) on from `from` in `dir`;
    ; past the explicit grid's edge in that direction every line has the
    ; name
    fn spanFrom:int (tpl:EVGGridTemplate last:int from:int dir:int) {
        if ((strlen name) == 0) {
            return (from + (dir * n))
        }
        def found:int 0
        def x:int from
        def guard:int 0
        while (guard < 100000) {
            x = (x + dir)
            def past:boolean (((dir > 0) && (x > last)) || ((dir < 0) && (x < 1)))
            if (past || (tpl.hasLineNamed(x name))) {
                found = (found + 1)
                if (found == n) {
                    return x
                }
            }
            guard = (guard + 1)
        }
        return x
    }
}
