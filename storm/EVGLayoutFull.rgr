                    }
                    return ((((lc.calculatedY - lc.box.marginTopPx) - el.calculatedY) + lcb) + el.box.marginTopPx)
                }
                li = (li - 1)
            }
            return -1.0
        }
        ; (a grid's, gridFirstBaseline's)
        if ((el.display == "grid") && (el.calculatedLastBaseline >= 0.0)) {
            def inFlow:boolean false
            def gi:int 0
            while (gi < n) {
                def gc:EVGElement (el.getChild(gi))
                if ((gc.isAbsolute == false) && ((gc.isHidden()) == false)) {
                    inFlow = true
                }
                gi = (gi + 1)
            }
            if inFlow {
                return (el.box.marginTopPx + el.calculatedLastBaseline)
