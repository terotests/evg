                }
            }
            def align:string (lay.crossAlignIn(true it parent.alignItems))
            def mX:double (it.box.marginLeftPx + it.box.marginRightPx)
            def w:double (itemAt ownW m)
            def stretch:boolean (((align == "stretch") || ((align == "normal") || ((strlen align) == 0))) && (it.width.isSet == false))
            if stretch {
