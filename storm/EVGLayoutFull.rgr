        ; item's border box when it has none)
        if ((EVGLayoutFull.cx(el)).flexBox && (el.display == "flex")) {
            def li:int (n - 1)
            while (li >= 0) {
                def lc:EVGElement (el.getChild(li))
                if ((lc.isAbsolute == false) && ((lc.isHidden()) == false)) {
