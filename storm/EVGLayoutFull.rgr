    fn gridFrRowMin:void (lay:EVGLayout rows:EVGGridTemplate items:[EVGElement] placedRow:[int] rowSpans:[int] placedCol:[int] colSpans:[int] cols:EVGGridTemplate colGap:double innerHeight:double) {
        def nr:int (rows.count())
        def any:boolean false
        def t0:int 0
        while (t0 < nr) {
            def tk:EVGGridTrack (rows.trackAt(t0))
            if ((tk.kind == 2) && (tk.hasMin == false)) {
                any = true
            }
            push rows.frMin 0.0
            t0 = (t0 + 1)
        }
        if (any == false) {
            return
        }
        rows.frAutoMin = true
        for items it:EVGElement k {
            def r:int (itemAt placedRow k)
            if ((((itemAt rowSpans k) == 1) && (r < nr)) && (it.gridTemplateRows != "subgrid")) {
                def tk2:EVGGridTrack (rows.trackAt(r))
                if (((tk2.kind == 2) && (tk2.hasMin == false)) && ((it.overflow == "visible") || (tk2.minIntrinsic > 1))) {
                    def w:double (cols.extentOf((itemAt placedCol k) (itemAt colSpans k) colGap))
                    it.calculatedFlexHeight = 0.0
                    it.unitsResolved = false
                    it.resolveUnits(w innerHeight)
