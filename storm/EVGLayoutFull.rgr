                                        }
                                    }
                                }
                                if ((itemAt content u) < (itemAt minContent u)) {
                                    set content u (itemAt minContent u)
                                }
                            }
                            u = (u + 1)
                        }
                    }
                }
                k = (k + 1)
            }
            span = (span + 1)
        }
    }

    ; a row track that keeps its size whatever its items need
    sfn fixedRow:boolean (r:int declared:EVGGridTemplate autoRows:EVGGridTemplate) {
