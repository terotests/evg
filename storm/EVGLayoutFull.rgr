    ; place is under the in-flow boxes before it and the margin under the
    ; last of them
    fn staticTop:double (lay:EVGLayout parent:EVGElement index:int currentY:double startY:double) {
        if ((EVGLayoutFull.cx((parent.getChild(index)))).staticFlow == false) {
            return startY
        }
        def staticY:double currentY
        def pi:int (index - 1)
        while (pi >= 0) {
