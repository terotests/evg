        def lb:double (this.lastBaselineOffsetOf(lay el))
        if (lb >= 0.0) {
            return lb
        }
        if lay.synthBorder {
            return (el.box.marginTopPx + el.calculatedHeight)
        }
        return ((el.box.marginTopPx + el.calculatedHeight) + el.box.marginBottomPx)
    }

    ; Distance from an element's top margin edge to its LAST baseline: the
