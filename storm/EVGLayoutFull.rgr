        if (el.hasBaseline && (n == 0)) {
            return (el.box.marginTopPx + el.calculatedLastBaseline)
        }
        ; (a line of boxes with no text: its one baseline is its last)
        if el.hasBaseline {
            return (el.box.marginTopPx + el.calculatedBaseline)
        }
        return -1.0
    }

    ; The out-of-flow children once the tracks are sized. One with grid
    ; lines has its grid area for its containing block (CSS Grid 9.1): it is
    ; laid out against the area and placed from the area's corner, and one
    ; with no inset of its own (static-flex) is aligned in it by
    ; justify-self and align-self as an item would be. Lines left auto are
    ; the grid's own edges.
    fn layoutGridAbsAreas:void (lay:EVGLayout parent:EVGElement cols:EVGGridTemplate colGap:double rowSizes:[double] rowGap:double rowTemplate:EVGGridTemplate innerWidth:double contentHeight:double startX:double startY:double colShift:double rowShift:double) {
        def n:int (parent.getChildCount())
        def i:int 0
        while (i < n) {
            def c:EVGElement (parent.getChild(i))
            if c.isAbsolute {
                def ax:double 0.0
                def ay:double 0.0
                def aw:double innerWidth
                def ah:double contentHeight
                def colStarts:[double]
                def colEnds:[double]
                def cn:int 0
                ; (with no template and no item there is no track)
                def noItems:boolean true
                for parent.children ck:EVGElement cki {
                    if (ck.isAbsolute == false) {
                        noItems = false
                    }
                }
                def colsN:int (cols.count())
                if (noItems && (((strlen parent.gridTemplateColumns) == 0) || (parent.gridTemplateColumns == "none"))) {
                    colsN = 0
                }
                while (cn < colsN) {
                    push colStarts (colShift + (cols.offsetOf(cn colGap)))
                    push colEnds ((colShift + (cols.offsetOf(cn colGap))) + (cols.extentOf(cn 1 colGap)))
                    cn = (cn + 1)
                }
