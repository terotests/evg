                def rs:int (itemAt rowSpan i)
                if ((itemAt cols i) >= 0) {
                    def fc:int (itemAt cols i)
                    if (fc < curC) {
                        curR = (curR + 1)
                    }
                    while ((EVGLayoutFull.cellsFree(occ nRows nc curR rs fc sp)) == false) {
                        curR = (curR + 1)
                    }
                    curC = fc
                } {
                    def placed:boolean false
                    while (placed == false) {
                        if ((curC + sp) > nc) {
                            curC = 0
                            curR = (curR + 1)
                        } {
                            if (EVGLayoutFull.cellsFree(occ nRows nc curR rs curC sp)) {
                                placed = true
                            } {
                                curC = (curC + 1)
                            }
                        }
                    }
                    set cols i curC
                }
                nRows = (EVGLayoutFull.markCells(occ nRows nc curR rs (itemAt cols i) sp))
                curC = ((itemAt cols i) + sp)
            }
            i = (i + 1)
        }
        i = 0
