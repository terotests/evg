                def pcx:EVGCssExtra (EVGLayoutFull.cx(parent))
                def padS:double (parent.box.paddingLeftPx - pcx.foldL)
                def padE:double (parent.box.paddingRightPx - pcx.foldR)
                if parent.resolvedRtl {
                    padS = (parent.box.paddingRightPx - pcx.foldR)
                    padE = (parent.box.paddingLeftPx - pcx.foldL)
                }
                def colAuto:[double] (EVGLayoutFull.absAutoArea(c.gridColumn cols colStarts colEnds padS padE innerWidth))
                if ((array_length colAuto) == 2) {
                    ax = (itemAt colAuto 0)
                    aw = (itemAt colAuto 1)
                    if parent.resolvedRtl {
                        ax = ((innerWidth - ax) - aw)
                    }
                }
                if (((strlen c.gridColumn) > 0) && ((array_length colAuto) == 0)) {
                    def cp:EVGGridPlacement (EVGGridPlacement.parse(c.gridColumn))
                    cp.resolveNames(cols)
                    if (cp.start > 0) {
                        ; (lines past the tracks there are, the collapsed
                        ; ones of an auto-fit repeat, are at the grid's end)
                        def nc:int (cols.count())
                        def c0:int (cp.start - 1)
                        def cspan:int cp.span
                        if (c0 > nc) {
                            c0 = nc
                        }
                        if ((c0 + cspan) > nc) {
                            cspan = (nc - c0)
                        }
                        ax = (colShift + (cols.offsetOf(c0 colGap)))
                        aw = 0.0
                        if (cspan > 0) {
                            aw = (cols.extentOf(c0 cspan colGap))
                        }
