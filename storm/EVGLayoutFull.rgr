; ==============================================================================
; EVGLayoutFull — the CSS conformance layer over the core layout
; ==============================================================================
;
; What a browser's CSS needs and a native EVG document does not: the hooks of
; EVGLayoutExt answered the CSS way. A front end that lays CSS out (MfdDomView
; through web/dom) installs it once, before its first layout:
;
;     EVGLayoutFull.install()
;
; and every EVGLayout made after that consults it. The flags it reads are on
; the elements' EVGCssExtra (EVGElement.css), which only such a front end sets.
;
; Here: containing blocks above the parent and the page's (cb, cb-outer,
; icb), static positions of absolute boxes in flex containers and blocks
; (static-flex, static-flow), line rows (height-through, line-join, baseline-
; from-bottom), synthesized baselines of flex and grid items and containers,
; last baselines, wrapping columns, absolute boxes in grid areas, grid-auto-
; flow: column and the implicit columns placements make.

Import "EVGLayout.rgr"

class EVGLayoutFull {
    Extends(EVGLayoutExt)

    ; installs the CSS layer for the layouts made from now on
    sfn install:void () {
        EVGLayoutExtDefault.install((new EVGLayoutFull()))
    }

    ; an element's CSS flags, or none set
    sfn cx:EVGCssExtra (el:EVGElement) {
        if (!null? el.css) {
            return (unwrap el.css)
        }
        return (new EVGCssExtra())
    }

    fn autoInnerHeight:void (lay:EVGLayout el:EVGElement parentHeight:double) {
        if ((EVGLayoutFull.cx(el)).heightThrough) {
            el.calculatedInnerHeight = parentHeight
        }
    }

    ; a line with no text has its baseline above its bottom
    ; (baseline-from-bottom); a CSS flex container's baseline is its first
    ; item's, synthesized from that item's border box when it has none; a
    ; positioned box is the containing block of the absolute boxes inside
    ; whose parents are not
    fn finishElement:void (lay:EVGLayout element:EVGElement childCount:int) {
        def css:EVGCssExtra (EVGLayoutFull.cx(element))
        if (css.skipFirst && (element.hasBaseline == false)) {
            def si:int 1
            while ((si < childCount) && (element.hasBaseline == false)) {
                def sc:EVGElement (element.getChild(si))
                if ((sc.isAbsolute == false) && sc.hasBaseline) {
                    element.calculatedBaseline = ((sc.calculatedY - element.calculatedY) + sc.calculatedBaseline)
                    element.calculatedDescent = sc.calculatedDescent
                    element.hasBaseline = true
                }
                si = (si + 1)
            }
        }
        ; (its lines are equally tall: one is the content's height less
        ; the distance between the first and the last baseline)
        if ((css.central && element.hasBaseline) && ((childCount == 0) && ((strlen element.textContent) > 0))) {
            def top:double (element.box.paddingTopPx + element.box.borderWidthPx)
            def contentH:double ((element.calculatedHeight - top) - (element.box.paddingBottomPx + element.box.borderWidthPx))
            def spread:double 0.0
            if (element.calculatedLastBaseline > element.calculatedBaseline) {
                spread = (element.calculatedLastBaseline - element.calculatedBaseline)
            }
            def lineH:double (contentH - spread)
            element.calculatedBaseline = (top + (lineH / 2.0))
            element.calculatedLastBaseline = (element.calculatedBaseline + spread)
            element.calculatedDescent = (lineH / 2.0)
        }
        if ((element.hasBaseline == false) && (css.baseFromBottom >= 0.0)) {
            element.calculatedBaseline = (element.calculatedHeight - css.baseFromBottom)
            element.calculatedDescent = css.baseFromBottom
            element.hasBaseline = true
        }
        if ((element.hasBaseline == false) && (childCount > 0)) {
            def i:int 0
            def n:int childCount
            if (css.flexBox && (element.display == "flex")) {
                while (i < n) {
                    def f:EVGElement (element.getChild(i))
                    if ((f.isAbsolute == false) && ((f.isHidden()) == false)) {
                        if f.hasBaseline {
                            element.calculatedBaseline = ((f.calculatedY - element.calculatedY) + f.calculatedBaseline)
                            element.calculatedDescent = f.calculatedDescent
                        } {
                            element.calculatedBaseline = ((f.calculatedY - element.calculatedY) + f.calculatedHeight)
                            element.calculatedDescent = 0.0
                        }
                        element.hasBaseline = true
                        i = n
                    }
                    i = (i + 1)
                }
            }
        }
        if (css.isCb && (childCount > 0)) {
            this.placeOuterAbs(lay element element)
        }
        if css.flipBase {
            css.flipDone = false
            if ((element.hasBaseline == false) && (childCount > 0)) {
                lay.inheritBaselineFromFirstChild(element)
            }
            if element.hasBaseline {
                def h:double element.calculatedHeight
                def b1:double element.calculatedBaseline
                def b2:double ((this.lastBaselineOffsetOf(lay element)) - element.box.marginTopPx)
                if (b2 < 0.0) {
                    b2 = b1
                }
                element.calculatedBaseline = (h - b2)
                css.flipLast = (h - b1)
                element.calculatedLastBaseline = css.flipLast
                css.flipDone = true
            }
        }
    }

    ; a grid whose first item has no baseline (a picture) synthesizes it
    ; from that item's bottom margin edge (CSS Align 9.1)
    fn gridBaseline:void (lay:EVGLayout element:EVGElement) {
        if element.hasBaseline {
            return
        }
        def n:int (element.getChildCount())
        def j:int 0
        while (j < n) {
            def g:EVGElement (element.getChild(j))
            if ((g.isAbsolute == false) && ((g.isHidden()) == false)) {
                element.calculatedBaseline = (((g.calculatedY - element.calculatedY) + g.calculatedHeight) + g.box.marginBottomPx)
                element.calculatedDescent = 0.0
                element.hasBaseline = true
                return
            }
            j = (j + 1)
        }
    }

    ; with no positioned box around it, an absolute box's insets are from
    ; the page's corner: the initial containing block (icb)
    fn absFrame:EVGAbsFrame (lay:EVGLayout child:EVGElement startX:double startY:double innerWidth:double innerHeight:double) {
        def f (new EVGAbsFrame())
        f.x = startX
        f.y = startY
        f.w = innerWidth
        f.h = innerHeight
        def css:EVGCssExtra (EVGLayoutFull.cx(child))
        if ((css.icbX || css.icbY) && (child.viewportW > 0.0)) {
            if css.icbX {
                f.x = child.viewportX
                f.w = child.viewportW
            }
            if css.icbY {
                f.y = child.viewportY
                f.h = child.viewportH
            }
        }
        return f
    }

    ; an absolute child of a flex container with no inset (static-flex):
    ; its static position is where justify-content and align-self put it
    ; as the container's only item (CSS Flexbox 4.1)
    fn absStatic:EVGAbsFrame (lay:EVGLayout parent:EVGElement child:EVGElement innerWidth:double innerHeight:double fixX0:double fixY0:double) {
        def f (new EVGAbsFrame())
        def fixX:double fixX0
        def fixY:double fixY0
        if ((EVGLayoutFull.cx(child)).staticFlex && (parent.display != "grid")) {
        def outW:double ((child.calculatedWidth + child.box.marginLeftPx) + child.box.marginRightPx)
        def outH:double ((child.calculatedHeight + child.box.marginTopPx) + child.box.marginBottomPx)
        def mainFree:double (innerWidth - outW)
        def crossFree:double (innerHeight - outH)
        if ((parent.flexDirection == "column") || (parent.flexDirection == "column-reverse")) {
            mainFree = (innerHeight - outH)
            crossFree = (innerWidth - outW)
        }
        def jc:string parent.justifyContent
        def safeJ:boolean ((indexOf jc "safe ") == 0)
        if (((indexOf jc "safe ") == 0) || ((indexOf jc "unsafe ") == 0)) {
            jc = (substring jc ((indexOf jc " ") + 1) (strlen jc))
        }
        if (safeJ && (mainFree < 0.0)) {
            jc = "flex-start"
        }
        def isColS:boolean ((parent.flexDirection == "column") || (parent.flexDirection == "column-reverse"))
        def revS:boolean ((parent.flexDirection == "row-reverse") || (parent.flexDirection == "column-reverse"))
        ; (left and right place along a row only; down a column
        ; they are the start)
        if (isColS && ((jc == "left") || (jc == "right"))) {
            jc = "start"
        }
        def mainOff:double 0.0
        if ((jc == "center") || ((jc == "space-around") || (jc == "space-evenly"))) {
            mainOff = (mainFree / 2.0)
        }
        if ((jc == "flex-end") || ((jc == "end") || (jc == "right"))) {
            mainOff = mainFree
        }
        ; a reversed direction starts at the other end for the
        ; flex- values (and normal and the distributions); start
        ; and end follow the writing direction, left and right
        ; nothing
        def flexKw:boolean ((jc != "start") && ((jc != "end") && ((jc != "left") && (jc != "right"))))
        def flipMain:boolean (revS && flexKw)
        if ((isColS == false) && (parent.resolvedRtl && ((jc != "left") && (jc != "right")))) {
            flipMain = (flipMain == false)
        }
        if flipMain {
            mainOff = (mainFree - mainOff)
        }
        def ca:string (lay.crossAlignIn(((parent.flexDirection == "column") || (parent.flexDirection == "column-reverse")) child parent.alignItems))
        ; `safe` falls back to the start when the box does not fit
        def safeA:boolean ((indexOf ca "safe ") == 0)
        if (((indexOf ca "safe ") == 0) || ((indexOf ca "unsafe ") == 0)) {
            ca = (substring ca ((indexOf ca " ") + 1) (strlen ca))
        }
        def toEnd:boolean ((ca == "flex-end") || ((ca == "end") || ((ca == "self-end") || (ca == "last baseline"))))
        ; wrap-reverse swaps the cross axis' start and end for
        ; the flex- values and the stretch (normal)
        if (parent.flexWrap == "wrap-reverse") {
            if (ca == "flex-end") {
                toEnd = false
            }
            if ((ca == "flex-start") || ((ca == "stretch") || ((ca == "normal") || ((strlen ca) == 0)))) {
                toEnd = true
            }
        }
        def crossOff:double 0.0
        if (ca == "center") {
            crossOff = (crossFree / 2.0)
        }
        if toEnd {
            crossOff = crossFree
        }
        if (safeA && (crossFree < 0.0)) {
            crossOff = 0.0
        }
        ; right to left the inline axis starts on the right: a
        ; column's cross axis, a row's main axis (left and right
        ; are where they say)
        ; (self-start and self-end by the item's own direction)
        def crossRtl:boolean parent.resolvedRtl
        if ((ca == "self-start") || (ca == "self-end")) {
            crossRtl = child.resolvedRtl
        }
        if (crossRtl && isColS) {
            crossOff = (crossFree - crossOff)
        }
        if isColS {
            fixX = (fixX + crossOff)
            fixY = (fixY + mainOff)
        } {
            fixX = (fixX + mainOff)
            fixY = (fixY + crossOff)
        }
        }
        f.x = fixX
        f.y = fixY
        return f
    }

    ; an absolute child of a block with no inset (static-flow): its static
    ; place is under the in-flow boxes before it and the margin under the
    ; last of them
    fn staticTop:double (lay:EVGLayout parent:EVGElement index:int currentY:double startY:double) {
        if ((EVGLayoutFull.cx((parent.getChild(index)))).staticFlow == false) {
            return startY
        }
        def staticY:double currentY
        def pi:int (index - 1)
        while (pi >= 0) {
            def pc:EVGElement (parent.getChild(pi))
            if ((pc.isAbsolute == false) && ((pc.isHidden()) == false)) {
                def pb:double (((pc.calculatedY + pc.calculatedHeight) + pc.box.marginBottomPx))
                if (pb > staticY) {
                    staticY = pb
                }
                pi = -1
            }
            pi = (pi - 1)
        }
        return staticY
    }

    ; an item joined to the one before (line-join) takes the gap back with
    ; its margin, so a line it starts gives that gap to it
    fn lineStartGap:double (child:EVGElement gap:double) {
        if ((EVGLayoutFull.cx(child)).lineJoin) {
            return gap
        }
        return 0.0
    }

    ; a flex or grid item's baseline is synthesized from its border box
    ; (CSS Align 9.1), except in a line of text (height-through)
    ; text metrics rounded to the pixel for the baseline (browsers'),
    ; or as the painter draws them
    fn pixelMetrics:boolean () {
        return true
    }

    fn synthBorder:boolean (parent:EVGElement) {
        return ((EVGLayoutFull.cx(parent)).heightThrough == false)
    }

    fn lastBaselineLine:EVGLastLine (lay:EVGLayout row:[EVGElement] align:string) {
        def ll (new EVGLastLine())
        for row bel:EVGElement b {
            if ((lay.rowAlignOf(bel align)) == "last baseline") {
                ll.used = true
                def lo:double (this.lastBaselineOf(lay bel))
                if (lo > ll.above) {
                    ll.above = lo
                }
                def underL:double (((bel.calculatedHeight + bel.box.marginTopPx) + bel.box.marginBottomPx) - lo)
                if (underL > ll.below) {
                    ll.below = underL
                }
            }
        }
        return ll
    }

    ; a wrapping column breaks where its height ends; one line of it is as
    ; wide as its items and placed by align-content
    fn wrapColumn:boolean (lay:EVGLayout parent:EVGElement totalHeight:double startX:double startY:double innerWidth:double innerHeight:double gapPx:double) {
        def childCount:int (parent.getChildCount())
        def wrapped:boolean false
        if (parent.flexWrap != "nowrap") {
            ; a wrapping column breaks where its height ends: a definite
            ; one, or max-height
            def limit:double -1.0
            if parent.hasDefiniteHeight {
                limit = innerHeight
            } {
                if (parent.maxHeight.isSet && ((parent.maxHeight.isPercent()) == false)) {
                    limit = (parent.maxHeight.pixels - (parent.box.getVerticalChrome()))
                }
            }
            if ((limit >= 0.0) && (totalHeight > (limit + 0.01))) {
                def cg:double 0.0
                if parent.columnGap.isSet {
                    parent.columnGap.resolve(innerWidth parent.inheritedFontSize)
                    cg = parent.columnGap.pixels
                } {
                    if parent.gap.isSet {
                        cg = parent.gap.pixels
                    }
                }
                wrapped = (this.wrapLines(lay parent limit startX startY innerWidth gapPx cg))
            }
        }
        if (wrapped == false) {
            ; a wrapping column of one line is as wide as its items,
            ; and align-content places that line (CSS Flexbox 9.4)
            def lineX:double 0.0
            def lineW:double innerWidth
            def acL:string parent.alignContent
            def revL:boolean (parent.flexWrap == "wrap-reverse")
            if ((parent.flexWrap != "nowrap") && ((acL == "center") || ((acL == "flex-end") || ((acL == "end") || ((acL == "space-around") || ((acL == "space-evenly") || (revL && ((acL == "flex-start") || (acL == "space-between"))))))))) {
                def widest:double 0.0
                def wi:int 0
                while (wi < childCount) {
                    def wc:EVGElement (parent.getChild(wi))
                    if (wc.isAbsolute == false) {
                        def ow:double ((wc.calculatedWidth + wc.box.marginLeftPx) + wc.box.marginRightPx)
                        if (ow > widest) {
                            widest = ow
                        }
                    }
                    wi = (wi + 1)
                }
                if (widest < innerWidth) {
                    lineW = widest
                    def freeL:double (innerWidth - widest)
                    lineX = (freeL / 2.0)
                    if ((acL == "flex-end") || (acL == "end")) {
                        lineX = freeL
                    }
                    if ((acL == "flex-start") || (acL == "space-between")) {
                        lineX = 0.0
                    }
                    ; (wrap-reverse: the flex- ends the other way round)
                    if (revL && ((acL == "flex-start") || ((acL == "flex-end") || (acL == "space-between")))) {
                        lineX = (freeL - lineX)
                    }
                }
            }
            ; the one line of a wrapping column is as wide as its widest
            ; item when that is wider than the box, and a stretched item
            ; fills the line (CSS Flexbox 9.4, 9.6)
            if ((parent.flexWrapSet && (parent.flexWrap != "nowrap")) && (((strlen acL) == 0) || ((acL == "normal") || ((acL == "stretch") || (acL == "flex-start"))))) {
                def widestS:double 0.0
                def si0:int 0
                while (si0 < childCount) {
                    def sc:EVGElement (parent.getChild(si0))
                    if ((sc.isAbsolute == false) && ((sc.isHidden()) == false)) {
                        def sa:string (lay.crossAlignIn(true sc parent.alignItems))
                        def stretchy:boolean ((sc.width.isSet == false) && ((sa == "stretch") || ((sa == "normal") || ((sa == "") || (sa == "flex-start")))))
                        def sw:double ((sc.calculatedWidth + sc.box.marginLeftPx) + sc.box.marginRightPx)
                        ; (a stretched item's own width is its fit-content
                        ; one, at most the box's)
                        if stretchy {
                            sw = (lay.intrinsicWidth(sc false))
                            if (sw > innerWidth) {
                                sw = innerWidth
                            }
                        }
                        if (sw > widestS) {
                            widestS = sw
                        }
                    }
                    si0 = (si0 + 1)
                }
                if (widestS > (innerWidth + 0.01)) {
                    lineW = widestS
                    def si1:int 0
                    while (si1 < childCount) {
                        def sc1:EVGElement (parent.getChild(si1))
                        if ((sc1.isAbsolute == false) && ((sc1.isHidden()) == false)) {
                            def sa1:string (lay.crossAlignIn(true sc1 parent.alignItems))
                            if ((sc1.width.isSet == false) && ((sa1 == "stretch") || ((sa1 == "normal") || ((sa1 == "") || (sa1 == "flex-start"))))) {
                                def tw:double ((widestS - sc1.box.marginLeftPx) - sc1.box.marginRightPx)
                                def sx1:double sc1.calculatedX
                                def sy1:double sc1.calculatedY
                                sc1.hasFlexWidth = true
                                sc1.calculatedFlexWidth = tw
                                if (sc1.keepLayout == false) {
                                    def sk1:int 0
                                    while (sk1 < (sc1.getChildCount())) {
                                        def sk1c:EVGElement (sc1.getChild(sk1))
                                        sk1c.resetLayoutState()
                                        sk1 = (sk1 + 1)
                                    }
                                }
                                lay.layoutElement(sc1 sx1 sy1 sc1.lastParentW sc1.lastParentH)
                            }
                        }
                        si1 = (si1 + 1)
                    }
                }
            }
            lay.alignColumn(parent totalHeight startX startY lineW innerHeight)
            if (lineX != 0.0) {
                def wj:int 0
                while (wj < childCount) {
                    def wk:EVGElement (parent.getChild(wj))
                    if (wk.isAbsolute == false) {
                        wk.calculatedX = (wk.calculatedX + lineX)
                        lay.propagateOffsetToChildren(wk lineX 0.0)
                    }
                    wj = (wj + 1)
                }
            }
        }
        return true
    }

    ; align-self: last baseline: the items share their last baselines, the
    ; group at the end of the row they end in (its fallback is safe end)
    fn gridLastBaselines:void (lay:EVGLayout parent:EVGElement items:[EVGElement] placedRow:[int] rowSpans:[int] rowSizes:[double] rowGapPx:double startY:double rowShift:double) {
        def itemCount:int (array_length items)
    def lp:int 0
    while (lp < itemCount) {
        def lel:EVGElement (itemAt items lp)
        def lga:string lel.alignSelf
        if (((strlen lga) == 0) || (lga == "auto")) {
            lga = parent.alignItems
        }
        if ((lga == "last baseline") && ((lel.marginAutoTop || lel.marginAutoBottom) == false)) {
            def lrow:int (((itemAt placedRow lp) + (itemAt rowSpans lp)) - 1)
            def ldone:boolean false
            def lq:int 0
            while (lq < lp) {
                def qel2:EVGElement (itemAt items lq)
                def qga2:string qel2.alignSelf
                if (((strlen qga2) == 0) || (qga2 == "auto")) {
                    qga2 = parent.alignItems
                }
                if ((qga2 == "last baseline") && ((((itemAt placedRow lq) + (itemAt rowSpans lq)) - 1) == lrow)) {
                    ldone = true
                }
                lq = (lq + 1)
            }
            if (ldone == false) {
                ; the most any of them has under its last baseline
                def maxD:double 0.0
                def lk:int lp
                while (lk < itemCount) {
                    def kel2:EVGElement (itemAt items lk)
                    def kga2:string kel2.alignSelf
                    if (((strlen kga2) == 0) || (kga2 == "auto")) {
                        kga2 = parent.alignItems
                    }
                    if ((kga2 == "last baseline") && ((((itemAt placedRow lk) + (itemAt rowSpans lk)) - 1) == lrow)) {
                        def kOuter:double ((kel2.calculatedHeight + kel2.box.marginTopPx) + kel2.box.marginBottomPx)
                        def kLb:double (this.lastBaselineOffsetOf(lay kel2))
                        if (kLb < 0.0) {
                            kLb = kOuter
                        }
                        if ((kOuter - kLb) > maxD) {
                            maxD = (kOuter - kLb)
                        }
                    }
                    lk = (lk + 1)
                }
                def rowEnd:double ((startY + rowShift) + ((lay.gridRowOffset(rowSizes lrow rowGapPx)) + (itemAt rowSizes lrow)))
                def lm:int lp
                while (lm < itemCount) {
                    def mel2:EVGElement (itemAt items lm)
                    def mga2:string mel2.alignSelf
                    if (((strlen mga2) == 0) || (mga2 == "auto")) {
                        mga2 = parent.alignItems
                    }
                    if ((mga2 == "last baseline") && ((((itemAt placedRow lm) + (itemAt rowSpans lm)) - 1) == lrow)) {
                        def mOuter:double ((mel2.calculatedHeight + mel2.box.marginTopPx) + mel2.box.marginBottomPx)
                        def mLb:double (this.lastBaselineOffsetOf(lay mel2))
                        if (mLb < 0.0) {
                            mLb = mOuter
                        }
                        ; (its margin bottom edge that far above the row's end)
                        def wantBottom:double (rowEnd - (maxD - (mOuter - mLb)))
                        def nowBottom:double ((mel2.calculatedY + mel2.calculatedHeight) + mel2.box.marginBottomPx)
                        def shiftL:double (wantBottom - nowBottom)
                        ; (safe: not above the row's start)
                        def topNow:double (mel2.calculatedY - mel2.box.marginTopPx)
                        def rowTop:double ((startY + rowShift) + (lay.gridRowOffset(rowSizes (itemAt placedRow lm) rowGapPx)))
                        if ((topNow + shiftL) < rowTop) {
                            shiftL = (rowTop - topNow)
                        }
                        if (shiftL != 0.0) {
                            lay.translateSubtree(mel2 0.0 shiftL)
                        }
                    }
                    lm = (lm + 1)
                }
            }
        }
        lp = (lp + 1)
    }
    this.gridFirstBaseline(lay parent items placedRow rowSpans)
    }

    ; a grid's first (last) baseline is the shared baseline of the items of
    ; its first (last) row that align by a baseline, if there are any (CSS
    ; Grid 10.8); otherwise the first (last) item's, the first as in the
    ; core. The last is kept in calculatedLastBaseline for
    ; lastBaselineOffsetOf.
    fn gridFirstBaseline:void (lay:EVGLayout parent:EVGElement items:[EVGElement] placedRow:[int] rowSpans:[int]) {
        def itemCount:int (array_length items)
        if (itemCount == 0) {
            return
        }
        def firstRow:int -1
        def lastRow:int -1
        def i:int 0
        while (i < itemCount) {
            def r:int (itemAt placedRow i)
            if ((firstRow < 0) || (r < firstRow)) {
                firstRow = r
            }
            def re:int ((r + (itemAt rowSpans i)) - 1)
            if (re > lastRow) {
                lastRow = re
            }
            i = (i + 1)
        }
        def firstDone:boolean false
        def lastB:double -1.0
        def j:int 0
        while (j < itemCount) {
            def el:EVGElement (itemAt items j)
            def ga:string el.alignSelf
            if (((strlen ga) == 0) || (ga == "auto")) {
                ga = parent.alignItems
            }
            def byFirst:boolean ((ga == "baseline") || (ga == "first baseline"))
            def byLast:boolean (ga == "last baseline")
            if ((byFirst || byLast) && ((el.marginAutoTop || el.marginAutoBottom) == false)) {
                def top:double ((el.calculatedY - el.box.marginTopPx) - parent.calculatedY)
                def b:double (lay.baselineOffsetOf(el))
                if byLast {
                    b = (this.lastBaselineOffsetOf(lay el))
                    if (b < 0.0) {
                        b = (el.box.marginTopPx + el.calculatedHeight)
                    }
                }
                if ((firstDone == false) && ((itemAt placedRow j) == firstRow)) {
                    parent.calculatedBaseline = (top + b)
                    parent.calculatedDescent = 0.0
                    parent.hasBaseline = true
                    firstDone = true
                }
                if ((lastB < 0.0) && ((((itemAt placedRow j) + (itemAt rowSpans j)) - 1) == lastRow)) {
                    lastB = (top + b)
                }
            }
            j = (j + 1)
        }
        if (lastB < 0.0) {
