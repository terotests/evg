                                    re = (itemAt fx j)
                                }
                            } {
                                def edge:double ((itemAt fx j) + (itemAt fw j))
                                if (edge > le) {
                                    le = edge
                                }
                            }
                            if ((nextY < 0.0) || (bot < nextY)) {
                                nextY = bot
                            }
                        }
                        j = (j + 1)
                    }
                    if ((any == false) || ((re - le) >= (ow - 0.01))) {
                        found = true
                        if right {
                            x = (re - ow)
                        } {
                            x = le
                        }
                    } {
                        y = nextY
                    }
                    guard = (guard + 1)
                }
                if (found == false) {
                    x = 0.0
                    if right {
                        x = (W - ow)
                    }
                }
                push fx x
                push fy y
                push fw ow
                push fh oh
                push fr right
                minTop = y
                if ((y + oh) > bottom) {
                    bottom = (y + oh)
                }
                def dx:double (((sx + x) + ml) - c2.calculatedX)
                def dy:double (((sy + y) + c2.box.marginTopPx) - c2.calculatedY)
                if ((dx != 0.0) || (dy != 0.0)) {
                    c2.moveSubtree(dx dy)
                }
            }
            i = (i + 1)
        }
        if (row.height.isSet == false) {
            row.calculatedInnerHeight = bottom
            row.calculatedHeight = (bottom + (row.box.getVerticalChrome()))
        }
    }

    ; minmax(<length>, ...): a track whose base is a length
    sfn fixedMinTrack:boolean (t:EVGGridTrack) {
        return (t.hasMin && ((t.minUnit.isPercent()) == false))
    }

    ; Items spanning several columns, the narrower spans first (CSS Grid
    ; 12.5.3): each track has a base size and a growth limit, which the
    ; items' min-content and max-content contributions raise in four
    ; steps. The results go back into minContent / content in the form
    ; resolveWithContent reads them for each kind of track.
    fn gridSpanContent:void (lay:EVGLayout cols:EVGGridTemplate items:[EVGElement] placedCol:[int] colSpans:[int] content:[double] minContent:[double] gap:double) {
        def nc:int (cols.count())
        def maxSpan:int 1
        for colSpans sp0:int si0 {
            if (sp0 > maxSpan) {
                maxSpan = sp0
            }
        }
        if (maxSpan < 2) {
            return
        }
        ; per track: min type (0 fixed, 1 auto, 2 min-content, 3 max-content),
        ; max type (0 fixed, 1 auto, 2 min-content, 3 max-content,
        ; 4 fit-content), base B, limit G and whether G is still infinite
        def minT:[int]
        def maxT:[int]
        def B:[double]
        def G:[double]
        def inf:[int]
        def grow:[int]
        def fitL:[double]
        def hasOne:[int]
        def i:int 0
        while (i < nc) {
            push hasOne 0
            i = (i + 1)
        }
        def k0:int 0
        while (k0 < (array_length items)) {
            if ((itemAt colSpans k0) == 1) {
                def pc:int (itemAt placedCol k0)
                if (pc < nc) {
                    set hasOne pc 1
                }
            }
            k0 = (k0 + 1)
        }
        i = 0
        while (i < nc) {
            def t:EVGGridTrack (cols.trackAt(i))
            def mc:double 0.0
            def xc:double 0.0
            if (i < (array_length minContent)) {
                mc = (itemAt minContent i)
            }
            if (i < (array_length content)) {
                xc = (itemAt content i)
            }
            def mn:int 0
            def mx:int 0
            def b:double 0.0
            def g:double 0.0
            def fl:double 0.0
            if (t.kind == 0) {
                mn = t.minIntrinsic
                g = t.value
                if (mn == 1) {
                    if (i < (array_length cols.definiteMin)) {
                        b = (itemAt cols.definiteMin i)
                    }
                }
                if (mn == 2) {
                    b = mc
                }
                if (mn == 3) {
                    b = xc
                }
                if (mn == 0) {
                    b = g
                }
            }
            if (t.kind == 3) {
                mx = 3
                if t.autoTrack {
                    mx = 1
                }
                if t.minContentTrack {
                    mx = 2
                }
                if t.hasFitLimit {
                    mx = 4
                    t.fitLimit.resolve(0.0 16.0)
                    fl = t.fitLimit.pixels
                }
                if (EVGLayoutFull.fixedMinTrack(t)) {
                    mn = 0
                    t.minUnit.resolve(0.0 16.0)
                    b = t.minUnit.pixels
                } {
                    if (t.minIntrinsic > 0) {
                        mn = t.minIntrinsic
                    } {
                        mn = 3
                        if ((mx == 1) || (mx == 4)) {
                            mn = 1
                        }
                        if (mx == 2) {
                            mn = 2
                        }
                    }
                    if (mn == 3) {
                        b = xc
                    } {
                        b = mc
                    }
                }
                g = xc
                if (mx == 2) {
                    g = mc
                }
                if ((mx == 4) && (g > fl)) {
                    g = fl
                    if (g < mc) {
                        g = mc
                    }
                }
                if (g < b) {
                    g = b
                }
            }
            push minT mn
            push maxT mx
            push B b
            push G g
            push fitL fl
            push grow 0
            ; (no item of its own: an infinite limit; the grid's own
            ; intrinsic width passes only the spanning items, so a measured
            ; track counts as having some)
            if (((t.kind == 3) && ((itemAt hasOne i) == 0)) && ((xc <= 0.0) && (mc <= 0.0))) {
                push inf 1
            } {
                push inf 0
            }
            i = (i + 1)
        }
        def span:int 2
        while (span <= maxSpan) {
            ; the span's items, those that cross no fr or percentage track
            def group:[int]
            def k:int 0
            while (k < (array_length items)) {
                def c0:int (itemAt placedCol k)
                if (((itemAt colSpans k) == span) && ((c0 + span) <= nc)) {
                    def ok:boolean true
                    def t1:int c0
                    while (t1 < (c0 + span)) {
                        def tk:EVGGridTrack (cols.trackAt(t1))
                        if ((tk.kind == 2) || (tk.kind == 1)) {
                            ok = false
                        }
                        t1 = (t1 + 1)
                    }
                    if ok {
                        push group k
                    }
                }
                k = (k + 1)
            }
            if ((array_length group) > 0) {
