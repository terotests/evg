            if (parent.maxHeight.isSet && (parent.maxHeight.pixels > 0.0)) {
                room = (parent.maxHeight.pixels - vch)
            }
            if (parent.minHeight.isSet && (parent.minHeight.pixels > 0.0)) {
                if ((parent.minHeight.pixels - vch) > room) {
                    room = (parent.minHeight.pixels - vch)
                    ; (a min alone: as many as reach it; over a max, the
