    ; Start, centre or end along the axis the side does not occupy.
    fn overlayCross:double (anchorStart:double anchorSize:double size:double align:string) {
        if (align == "center") {
            return (anchorStart + ((anchorSize - size) / 2.0))
        }
        if (align == "end") {
