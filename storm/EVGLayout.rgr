                c.resolveUnits(innerWidth contentHeight)
                this.layoutOutOfFlowChild(parent c innerWidth contentHeight startX startY true)
            }
            i = (i + 1)
        }
    }

    ; A grid's items in their tracks. grid-auto-flow: column is the CSS
    ; layer's (EVGLayoutExt.gridColumnFlow); the core places by rows.
    fn layoutGrid:double (parent:EVGElement) {
        ; (lines before the explicit grid are the CSS layer's)
        def hl:double (ext.gridLeading(this parent))
        if (hl >= 0.0) {
