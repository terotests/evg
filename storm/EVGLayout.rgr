        def shims:[double] (ext.gridBaselineShims(this parent items placedRow rowSpans (array_length rowSizes)))
        def declared:EVGGridTemplate (EVGGridTemplate.parse(rowSpec))
        def r:int 0
        while ((r < (declared.count())) && (r < (array_length rowSizes))) {
