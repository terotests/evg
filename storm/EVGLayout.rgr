        }
        def hChrome:double (element.box.getHorizontalChrome())
        if (width < hChrome) {
            width = hChrome
        }

        ; Apply min/max height constraints — max first, min second, for the
        ; reason given on the width above.
        if element.maxHeight.isSet {
            if (height > element.maxHeight.pixels) {
                height = element.maxHeight.pixels
            }
        }
        if element.minHeight.isSet {
            if (height < element.minHeight.pixels) {
                height = element.minHeight.pixels
            }
        }
        ; min-height / max-height of a content keyword: the content's height
        def kyT:int element.maxHeight.unitType
        def kmT:int element.minHeight.unitType
        def contentBoxH:double (((contentHeight + element.box.paddingTopPx) + element.box.paddingBottomPx) + (element.box.borderWidthPx * 2.0))
        if ((element.maxHeight.isSet == false) && ((kyT >= 6) && (kyT <= 8))) {
            if (height > contentBoxH) {
                height = contentBoxH
            }
        }
        if ((element.minHeight.isSet == false) && ((kmT >= 6) && (kmT <= 8))) {
            if (height < contentBoxH) {
                height = contentBoxH
            }
        }
        
        def innerBefore:double element.calculatedInnerHeight
        element.calculatedHeight = height
        element.calculatedInnerHeight = (element.box.getInnerHeight(height))
        ; AN ABSOLUTE CHILD WRITTEN `top: 0; bottom: 0` IS AS TALL AS THIS
        ; BOX, which is known only now when the height came from the content
        ; or from a flex line: the child was laid out against the height
        ; there was before (0 for an auto height) and kept its content's.
        ; A dashboard's slides, `inset: 0` in a `flex: 1` stage, were each
        ; as tall as their text, so their scroll areas and backgrounds ended
        ; halfway down. Lay those children out again against this height.
        ; (a grid's are in their grid areas, laid out against the rows)
        if ((autoHeight && ((childCount > 0) && (innerBefore != element.calculatedInnerHeight))) && (element.display != "grid")) {
            def ai:int 0
            while (ai < childCount) {
                def ac:EVGElement (element.getChild(ai))
                if ((ac.isAbsolute && ((ac.isFixedPosition()) == false)) && (EVGLayout.followsHeight(ac))) {
                    def sx:double ((element.calculatedX + element.box.borderWidthPx) + element.box.paddingLeftPx)
                    def sy:double ((element.calculatedY + element.box.borderWidthPx) + element.box.paddingTopPx)
                    ; (its percentages again, of this height)
                    ac.unitsResolved = false
                    ac.resolveUnits(element.calculatedInnerWidth element.calculatedInnerHeight)
                    this.layoutOutOfFlowChild(element ac element.calculatedInnerWidth element.calculatedInnerHeight sx sy (element.flexDirection != "column"))
                }
                ai = (ai + 1)
            }
        }
        ; THE ANONYMOUS FLEX ITEM. An element that is a flex container and
        ; carries text of its own does not lay that text out as a block: CSS
        ; wraps it in an item, and `align-items` (across a row) or
        ; `justify-content` (along a column) then places it. This is the pill
        ; — `display:flex; align-items:center` with the label as the element's
        ; own text — whose label sat against the top edge because the line box
        ; started at the content top and nothing ever asked where it should
        ; go. Written once here; `EVGElement.textShiftY` says the rest.
        element.textShiftY = 0.0
        if ((strlen element.textContent) > 0) {
            if ((element.getChildCount()) == 0) {
                if (element.display == "flex") {
                    def slack:double (element.calculatedInnerHeight - contentHeight)
                    if (slack > 0.0) {
                        ; A row's cross axis is the vertical one; a column's
                        ; main axis is.
                        def how@(mutable):string element.alignItems
                        if ((element.flexDirection == "column") || (element.flexDirection == "column-reverse")) {
                            how = element.justifyContent
                        }
                        if ((how == "center") || (how == "safe center")) {
                            element.textShiftY = (slack / 2.0)
                        }
                        if ((how == "flex-end") || (how == "end")) {
                            element.textShiftY = slack
                        }
                    }
                }
            }
            if (element.hasBaseline && (element.textShiftY != 0.0)) {
                element.calculatedBaseline = (element.calculatedBaseline + element.textShiftY)
                element.calculatedLastBaseline = (element.calculatedLastBaseline + element.textShiftY)
