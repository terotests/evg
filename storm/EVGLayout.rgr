                    def km:double -1.0
                    if (kid.flexBasis.isSet && ((kid.flexBasis.isPercent()) == false)) {
                        km = kid.flexBasis.pixels
                    } {
                        if (kid.height.isSet && ((kid.height.isPercent()) == false)) {
                            km = kid.height.pixels
                        }
                    }
                    if (km >= 0.0) {
