    fn layoutGridPlaced:double (parent:EVGElement) {
        if ((indexOf parent.gridAutoFlow "column") >= 0) {
            def hc:double (ext.gridColumnFlow(this parent))
            if (hc >= 0.0) {
                return hc
            }
        }
        return (this.layoutGridFlow(parent))
    }

    ; repeat(auto-fill / auto-fit) down the rows as repeat(N): as many as
    ; the height holds, a definite one, else max-height, else min-height
    fn gridRowRepeat:string (parent:EVGElement spec:string innerHeight:double rowGapPx:double) {
        def room:double innerHeight
        def roomMin:boolean false
        if (parent.hasDefiniteHeight == false) {
            room = 0.0
            def vch:double (parent.box.getVerticalChrome())
