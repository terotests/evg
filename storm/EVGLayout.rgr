        ; lands in collapsed after placement (CSS Grid 7.2.3.2)
        def fitStart:int -1
        def fitOthers:int 0
        def ftoks:[string] (EVGGridTemplate.tokenize(colSpec))
        def ft:int 0
        while (ft < (array_length ftoks)) {
            def ftok:string (itemAt ftoks ft)
            if ((EVGGridTemplate.isLineNameToken(ftok)) == false) {
