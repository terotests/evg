        if parent.columnGap.isSet {
            parent.columnGap.rootFontSize = parent.rootFontSize
            parent.columnGap.resolve(innerWidth parent.inheritedFontSize)
            colGapPx = parent.columnGap.pixels
        }
        if parent.rowGap.isSet {
