        }
        return (inner + (el.box.getHorizontalChrome()))
    }

    ; the lines of a wrapping column side by side: each as wide as its
    ; widest item, a new one when the next item's main size passes the
    ; height; `widest` when an item's main size is not known
    fn columnLinesWidth:double (el:EVGElement ws:[double] mains:[double] gapPx:double widest:double) {
        def room:double ((el.height.pixels - (el.box.getVerticalChrome())))
        def mainGap:double 0.0
        if el.rowGap.isSet {
            mainGap = el.rowGap.pixels
        } {
            if el.gap.isSet {
                mainGap = el.gap.pixels
            }
        }
        def sum:double 0.0
        def lineW:double 0.0
        def lineH:double 0.0
        def inLine:int 0
        def lines:int 0
        def k:int 0
        while (k < (array_length ws)) {
            def m:double (itemAt mains k)
            if (m < 0.0) {
                return widest
            }
            def add:double m
            if (inLine > 0) {
                add = (add + mainGap)
            }
            if ((inLine > 0) && ((lineH + add) > (room + 0.01))) {
                sum = (sum + lineW)
                lines = (lines + 1)
                lineW = 0.0
                lineH = 0.0
                inLine = 0
                add = m
            }
            lineH = (lineH + add)
            if ((itemAt ws k) > lineW) {
                lineW = (itemAt ws k)
            }
            inLine = (inLine + 1)
            k = (k + 1)
        }
