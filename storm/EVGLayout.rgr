        ; the explicit rows are there with no item in them (CSS Grid 7.1)
        def explicitRows:int 0
        if ((parent.gridTemplateRows != "subgrid") && ((strlen parent.gridTemplateRows) > 0)) {
            explicitRows = (rowTemplate.count())
        }
        ; (and the rows of grid-template-areas)
        if (hasAreas && (areas.rows > explicitRows)) {
