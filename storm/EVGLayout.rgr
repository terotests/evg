        }
        if (alignKnown && (rowsUsed > 0)) {
            def acD:string parent.alignContent
            if ((acD == "left") || (acD == "right")) {
                acD = "start"
            }
            def rowDist:[double] (EVGLayout.contentDistribution(acD (alignRoom - rowsH) rowsUsed))
            rowShift = (itemAt rowDist 0)
            rowGapPx = (rowGapPx + (itemAt rowDist 1))
            rowGapTotal = (rowGapTotal + ((itemAt rowDist 1) * (to_double (rowsUsed - 1))))
        }

        ; (a percentage row gap of a grid of no definite height is of the
        ; height its rows make, which it does not change, CSS Grid 10.1)
        if ((parent.hasDefiniteHeight == false) && (rowsUsed > 1)) {
            def rgU:EVGUnit parent.gap
            if parent.rowGap.isSet {
                rgU = parent.rowGap
            }
            if (rgU.isSet && (rgU.isPercent())) {
                rowGapPx = (rowGapPx + ((rowsH * rgU.value) / 100.0))
            }
        }

        ; --- final placement -------------------------------------------------
        def p:int 0
        while (p < itemCount) {
            def el:EVGElement (itemAt items p)
            def cIdx:int (itemAt placedCol p)
            def rIdx:int (itemAt placedRow p)
            def cSpan:int (itemAt colSpans p)
            def rSpan:int (itemAt rowSpans p)

            def cellW:double (cols.extentOf(cIdx cSpan colGapPx))
            def cellH:double (this.gridRowExtent(rowSizes rIdx rSpan rowGapPx))
            def offX:double (colShift + (cols.offsetOf(cIdx colGapPx)))
            def offY:double (rowShift + (this.gridRowOffset(rowSizes rIdx rowGapPx)))

            ; A grid item's containing block is its AREA, not the grid's
            ; content box: its percentages (sizes, margins, padding) are of the
            ; area, so they are resolved again now that it is known; before,
            ; `width: 100%` on a cell came out as the whole grid's width
            el.unitsResolved = false
            el.resolveUnits(cellW cellH)
            el.calculatedX = (startX + offX + el.box.marginLeftPx)
            el.calculatedY = (startY + offY + el.box.marginTopPx)

            def boxW:double (cellW - el.box.marginLeftPx - el.box.marginRightPx)
            def boxH:double (cellH - el.box.marginTopPx - el.box.marginBottomPx)
            if (boxW < 0.0) {
                boxW = 0.0
            }
            if (boxH < 0.0) {
                boxH = 0.0
            }

            ; Grid items stretch to their cell by default (§7.1), which is what
            ; photo cells want. An explicit height still wins: layoutElement only
            ; consults calculatedFlexHeight when height.isSet is false.
            ; align-items / align-self center, end or start keep the item
            ; its content's height and place it in the cell instead
            ; (`flex-start`, EVG's default, still stretches)
            def ga:string el.alignSelf
            if (((strlen ga) == 0) || (ga == "auto")) {
                ga = parent.alignItems
            }
            def byBaseline:boolean ((ga == "baseline") || ((ga == "first baseline") || (ga == "last baseline")))
            def placedV:boolean ((ga == "center") || ((ga == "end") || ((ga == "flex-end") || ((ga == "start") || ((ga == "self-end") || byBaseline)))))
            if (el.marginAutoTop || el.marginAutoBottom) {
                placedV = true
            }
            ; normal is start for a box with an aspect ratio (CSS Align 3,
            ; 6.1): only an explicit stretch stretches it
            if ((el.aspectRatio > 0.0) && (ga != "stretch")) {
                placedV = true
            }
            ; justify-self / justify-items, and auto margins, along the row:
            ; the item keeps its fit-content width and is placed in the cell
            def gj:string el.justifySelf
            if (((strlen gj) == 0) || (gj == "auto")) {
                gj = parent.justifyItems
            }
            def placedH:boolean ((gj == "center") || ((gj == "end") || ((gj == "flex-end") || ((gj == "start") || ((gj == "flex-start") || ((gj == "left") || ((gj == "right") || ((gj == "self-start") || (gj == "self-end")))))))))
            if (el.marginAutoLeft || el.marginAutoRight) {
                placedH = true
            }
            ; the cell is placed left to right and mirrored afterwards, so
            ; under rtl the physical sides swap; self-start and self-end
            ; follow the item's own direction
            def autoL:boolean el.marginAutoLeft
            def autoR:boolean el.marginAutoRight
            def itemRtl:boolean parent.resolvedRtl
            if (el.textDir == "rtl") {
                itemRtl = true
            }
            if (el.textDir == "ltr") {
                itemRtl = false
            }
            if parent.resolvedRtl {
                autoL = el.marginAutoRight
                autoR = el.marginAutoLeft
                if (gj == "left") {
                    gj = "end"
                } {
                    if (gj == "right") {
                        gj = "start"
                    }
                }
            }
            if (itemRtl != parent.resolvedRtl) {
                if (gj == "self-start") {
                    gj = "end"
                } {
                    if (gj == "self-end") {
                        gj = "start"
                    }
                }
            }
            if ((boxH > 0.0) && (placedV == false)) {
                el.calculatedFlexHeight = boxH
            }
            ; (stretched in an empty row it is not as tall as its content)
            if (((boxH <= 0.0) && (placedV == false)) && (el.height.isSet == false)) {
                el.calculatedFlexHeight = 0.0
                el.hasFlexHeight = true
            }
            ; stretched down its area with no width of its own: a box with an
            ; aspect ratio is as wide as the ratio makes that height
            if (((el.aspectRatio > 0.0) && ((placedV == false) && (gj != "stretch"))) && (((el.width.isSet == false) && (el.height.isSet == false)) && (boxH > 0.0))) {
                def arX:double ((el.box.paddingLeftPx + el.box.paddingRightPx) + (el.box.borderWidthPx * 2.0))
                def arY:double ((el.box.paddingTopPx + el.box.paddingBottomPx) + (el.box.borderWidthPx * 2.0))
                el.hasFlexWidth = true
                el.calculatedFlexWidth = (((boxH - arY) * el.aspectRatio) + arX)
                placedH = true
            }

            ; Hand this cell's tracks down to a subgrid child before it lays
            ; itself out. Both axes work the same way; the rows are simply
            ; known later, which is the only reason columns landed first.
            if (el.gridTemplateColumns == "subgrid") {
                clear el.subgridColumnSizes
                def sgi:int 0
                while (sgi < cSpan) {
                    def tk:EVGGridTrack (cols.trackAt(cIdx + sgi))
                    push el.subgridColumnSizes tk.sizePx
                    sgi = (sgi + 1)
                }
            }
            if (el.gridTemplateRows == "subgrid") {
                clear el.subgridRowSizes
                def sgj:int 0
                while (sgj < rSpan) {
                    def rIdx2:int (rIdx + sgj)
                    if (rIdx2 < (array_length rowSizes)) {
                        push el.subgridRowSizes (itemAt rowSizes rIdx2)
                    }
                    sgj = (sgj + 1)
                }
            }


            ; a grid item is as wide as its cell (justify-self: normal is
            ; the stretch), not its content as it would be along a row
            def wasRowG:boolean layingOutAlongRow
            def wasShrinkG:boolean columnCrossShrinks
            layingOutAlongRow = false
            columnCrossShrinks = placedH
            ; (stretched down its area its height is definite, CSS Grid 11:
            ; percentage heights under it, resolved against the auto height
            ; it was measured with, resolve again against that)
            ; (nor are percentages of the width of one that fits its content
            ; the width it was measured in)
            def againH:boolean ((placedV == false) && ((boxH > 0.0) && ((el.height.isSet == false) || (el.height.isPercent()))))
            if ((againH || placedH) && (el.keepLayout == false)) {
                EVGLayout.unresolvePct(el againH placedH)
            }
            this.layoutElement(el el.calculatedX el.calculatedY boxW boxH)
            layingOutAlongRow = wasRowG
            columnCrossShrinks = wasShrinkG
            if placedH {
                def freeX:double (boxW - el.calculatedWidth)
                if (freeX > 0.0) {
                    def dx:double 0.0
                    if (autoL || autoR) {
                        if autoL {
                            dx = freeX
                            if autoR {
                                dx = (freeX / 2.0)
                            }
                        }
                    } {
                        if (gj == "center") {
                            dx = (freeX / 2.0)
                        }
                        if ((gj == "end") || ((gj == "flex-end") || ((gj == "right") || (gj == "self-end")))) {
                            dx = freeX
                        }
                    }
                    if (dx != 0.0) {
                        this.translateSubtree(el dx 0.0)
                    }
                }
            }
            if placedV {
                def free:double ((boxH - el.calculatedHeight) - 0.0)
                if (free > 0.0) {
                    def dy:double free
                    if (ga == "center") {
                        dy = (free / 2.0)
                    }
                    if ((ga == "start") || ((placedV == true) && ((ga != "center") && ((ga != "end") && ((ga != "flex-end") && (ga != "self-end")))))) {
                        dy = 0.0
                    }
                    if (el.marginAutoTop || el.marginAutoBottom) {
                        dy = 0.0
                        if el.marginAutoTop {
                            dy = free
                            if el.marginAutoBottom {
                                dy = (free / 2.0)
                            }
                        }
                    }
                    if (dy != 0.0) {
                        this.translateSubtree(el 0.0 dy)
                    }
                }
            }
            p = (p + 1)
        }

        ; align-self: baseline: the items of a row that align so share the
        ; lowest of their baselines (CSS Align 9.3), a box with no text its
        ; bottom margin edge (baselineOffsetOf)
        def wasGTop:boolean synthTop
        synthTop = (ext.synthTop(parent))
        ; (an item with no baseline has its border box's, CSS Align 9.1)
        def wasGBorder:boolean synthBorder
        synthBorder = true
        def bp:int 0
        while (bp < itemCount) {
            def bel:EVGElement (itemAt items bp)
            def bga:string bel.alignSelf
            if (((strlen bga) == 0) || (bga == "auto")) {
                bga = parent.alignItems
            }
            if (((bga == "baseline") || (bga == "first baseline")) && ((bel.marginAutoTop || bel.marginAutoBottom) == false)) {
                def brow:int (itemAt placedRow bp)
                def done:boolean false
                ; (each row's group once, at its first item)
                def bq:int 0
                while (bq < bp) {
                    def qel:EVGElement (itemAt items bq)
                    def qga:string qel.alignSelf
                    if (((strlen qga) == 0) || (qga == "auto")) {
                        qga = parent.alignItems
                    }
                    if ((((qga == "baseline") || (qga == "first baseline")) && ((itemAt placedRow bq) == brow)) && ((qel.marginAutoTop || qel.marginAutoBottom) == false)) {
                        done = true
                    }
                    bq = (bq + 1)
                }
                if (done == false) {
                    def maxB:double 0.0
                    def bk:int bp
                    while (bk < itemCount) {
                        def kel:EVGElement (itemAt items bk)
                        def kga:string kel.alignSelf
                        if (((strlen kga) == 0) || (kga == "auto")) {
                            kga = parent.alignItems
                        }
                        if ((((kga == "baseline") || (kga == "first baseline")) && ((itemAt placedRow bk) == brow)) && ((kel.marginAutoTop || kel.marginAutoBottom) == false)) {
                            def kb:double (this.baselineOffsetOf(kel))
                            if (kb > maxB) {
                                maxB = kb
                            }
                        }
                        bk = (bk + 1)
                    }
                    def bm:int bp
                    while (bm < itemCount) {
                        def mel:EVGElement (itemAt items bm)
                        def mga:string mel.alignSelf
                        if (((strlen mga) == 0) || (mga == "auto")) {
                            mga = parent.alignItems
                        }
                        if ((((mga == "baseline") || (mga == "first baseline")) && ((itemAt placedRow bm) == brow)) && ((mel.marginAutoTop || mel.marginAutoBottom) == false)) {
                            def shiftB:double (maxB - (this.baselineOffsetOf(mel)))
                            if (shiftB != 0.0) {
                                this.translateSubtree(mel 0.0 shiftB)
                            }
                        }
                        bm = (bm + 1)
                    }
                }
            }
            bp = (bp + 1)
        }
        synthTop = wasGTop
        synthBorder = wasGBorder

        ; (align-self: last baseline is the CSS layer's)
        ext.gridLastBaselines(this parent items placedRow rowSpans rowSizes rowGapPx startY rowShift)

        ; Leave the rows behind for an enclosing grid that has to size its own
        ; rows around this one.
        clear parent.computedRowSizes
        def cr:int 0
        while (cr < rowsUsed) {
            push parent.computedRowSizes (itemAt rowSizes cr)
            cr = (cr + 1)
        }

        def total:double 0.0
        def s:int 0
        while (s < rowsUsed) {
            total = (total + (itemAt rowSizes s))
            s = (s + 1)
        }
        total = (total + rowGapTotal)
        if (total < 0.0) {
            total = 0.0
        }

        def absH:double innerHeight
        if (absH <= 0.0) {
            absH = total
        }
        if ((ext.gridAbsAreas(this parent cols colGapPx rowSizes rowGapPx rowTemplate innerWidth absH startX startY colShift rowShift)) == false) {
            this.layoutGridOutOfFlow(parent innerWidth absH startX startY)
        }

        return total
    }

    ; True if any cell of the rspan x span block at (row, col) is already taken.
    ; Rows beyond the current map are by definition free.
    ; cv no more than cmax (none when negative), then no less than cmin, as
    ; clampMain has it
    sfn clampSize:double (cv:double cmin:double cmax:double) {
        if ((cmax >= 0.0) && (cv > cmax)) {
            if (cmax < cmin) {
                return cmin
            }
            return cmax
        }
        if (cv < cmin) {
            return cmin
        }
        return cv
    }

    ; what the free space is shared by: the flex factors' sum, or 1 when
    ; they sum to less
    sfn flexDivisor:double (sum:double) {
        if (sum < 1.0) {
            return 1.0
        }
        return sum
    }

    ; whether a child of el has a percentage height or max-height
    sfn pctHeightKid:boolean (el:EVGElement) {
        def i:int 0
        while (i < (el.getChildCount())) {
            def k:EVGElement (el.getChild(i))
            if ((k.height.isSet && (k.height.isPercent())) || (k.maxHeight.isSet && (k.maxHeight.isPercent()))) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; children of el with a percentage size (and theirs under them) are
    ; to resolve their units again
    ; (the heights when wantH, the widths when wantW)
    sfn unresolvePct:void (el:EVGElement wantH:boolean wantW:boolean) {
        def i:int 0
        while (i < (el.getChildCount())) {
            def k:EVGElement (el.getChild(i))
            def pctH:boolean (wantH && ((k.height.isSet && (k.height.isPercent())) || ((k.minHeight.isSet && (k.minHeight.isPercent())) || (k.maxHeight.isSet && (k.maxHeight.isPercent())))))
            def pctW:boolean (wantW && ((k.width.isSet && (k.width.isPercent())) || ((k.minWidth.isSet && (k.minWidth.isPercent())) || (k.maxWidth.isSet && (k.maxWidth.isPercent())))))
            if ((pctH || pctW) && (k.keepLayout == false)) {
                k.unitsResolved = false
                EVGLayout.unresolvePct(k wantH wantW)
            }
            i = (i + 1)
        }
    }

    fn gridOccupied:boolean (occupied:[boolean] colCount:int row:int col:int span:int rspan:int) {
        def total:int (array_length occupied)
        def rr:int 0
        while (rr < rspan) {
            def cc:int 0
            while (cc < span) {
                def idx:int ((((row + rr) * colCount) + col) + cc)
                if (idx < total) {
                    if (itemAt occupied idx) {
                        return true
                    }
                }
                cc = (cc + 1)
            }
            rr = (rr + 1)
        }
        return false
    }

    ; where the tracks start and what is added to each gap between them for
    ; a justify-content or align-content value, given the free space the
    ; tracks leave
    sfn contentDistribution:[double] (mode0:string free:double n:int) {
        def res:[double]
        def mode:string (trim mode0)
        def safe:boolean false
        if ((indexOf mode "unsafe ") == 0) {
            mode = (trim (substring mode 7 (strlen mode)))
        }
        if ((indexOf mode "safe ") == 0) {
            safe = true
            mode = (trim (substring mode 5 (strlen mode)))
        }
        def shift:double 0.0
        def extra:double 0.0
        if ((mode == "end") || ((mode == "flex-end") || (mode == "right"))) {
            shift = free
        }
        if (mode == "center") {
            shift = (free / 2.0)
        }
        if (free > 0.0) {
            if ((mode == "space-between") && (n > 1)) {
                extra = (free / (to_double (n - 1)))
            }
            if ((mode == "space-around") && (n > 0)) {
                extra = (free / (to_double n))
                shift = (extra / 2.0)
            }
            if ((mode == "space-evenly") && (n > 0)) {
                extra = (free / (to_double (n + 1)))
                shift = extra
            }
        } {
            ; (space-around and space-evenly fall back to safe center,
            ; which an overflow puts at the start)
            if safe {
                shift = 0.0
            }
        }
        push res shift
        push res extra
        return res
    }

    fn gridRowExtent:double (rowSizes:[double] from:int span:int gap:double) {
        def total:double 0.0
        def n:int (array_length rowSizes)
        def i:int from
        def placed:int 0
        while ((i < n) && (placed < span)) {
            total = (total + (itemAt rowSizes i))
            placed = (placed + 1)
            i = (i + 1)
        }
        if (placed > 1) {
            total = (total + ((to_double (placed - 1)) * gap))
        }
        return total
    }

    fn gridRowOffset:double (rowSizes:[double] index:int gap:double) {
        def total:double 0.0
        def i:int 0
        while (i < index) {
            total = (total + (itemAt rowSizes i))
            total = (total + gap)
            i = (i + 1)
        }
        return total
    }

    ; `alongRow` is the same question `crossAxisFits` asks of the element being
    ; laid out, asked here of one being estimated: does `width: auto` mean
    ; fit-content, or stretch? It has to be passed rather than read off the
    ; ambient flag, because this runs BEFORE the child is laid out and the flag
    ; still describes whoever was laid out last.
    ;
    ; Getting it wrong is not subtle. Shrink-wrapping unconditionally shrank
    ; the profile card's header — a column child that should fill — to the
    ; width of the two things inside it.
    ; a width clamped by min-width / max-width of min-content, max-content
    ; or fit-content, from what the box holds (CSS Sizing 3, 3.2); room is
    ; what fit-content fits into when the box is not in a flex flow
    fn keywordWidth:double (element:EVGElement w:double room:double) {
        def width:double w
        def kxT:int element.maxWidth.unitType
        def knT:int element.minWidth.unitType
        def kMax:boolean ((element.maxWidth.isSet == false) && ((kxT >= 6) && (kxT <= 8)))
        def kMin:boolean ((element.minWidth.isSet == false) && ((knT >= 6) && (knT <= 8)))
        if (kMax || kMin) {
            ; (its content's sizes, not its own width's)
            def kOut:double (element.box.marginLeftPx + element.box.marginRightPx)
            def ownW:EVGUnit element.width
            element.width = (EVGUnit.unset())
            def kMn:double ((this.intrinsicWidthNow(element true)) - kOut)
            def kMx:double ((this.intrinsicWidthNow(element false)) - kOut)
            element.width = ownW
            if (kMx < kMn) {
                kMx = kMn
            }
            def kFit:double room
            if (element.fitRoom >= 0.0) {
                kFit = element.fitRoom
            }
            if (kFit > kMx) {
                kFit = kMx
            }
            if (kFit < kMn) {
                kFit = kMn
            }
            if kMax {
                def capW:double kFit
                if (kxT == 7) {
                    capW = kMn
                }
                if (kxT == 8) {
                    capW = kMx
                }
                if (width > capW) {
                    width = capW
                }
            }
            if kMin {
                def floorW:double kFit
                if (knT == 7) {
                    floorW = kMn
                }
                if (knT == 8) {
                    floorW = kMx
                }
                if (width < floorW) {
                    width = floorW
                }
            }
        }
        return width
    }

    fn estimateChildWidth:double (child:EVGElement maxInnerWidth:double alongRow:boolean) {
        ; Width used for row flow / flex pre-calc — matches layoutElement shrink-wrap
        if child.width.isSet {
            return child.width.pixels
        }
        if (child.hasFlexWidth) {
            return child.calculatedFlexWidth
        }
        def textContent:string child.textContent
        if ((strlen textContent) > 0) {
            if ((child.getChildCount()) == 0) {
                def fontSize:double child.inheritedFontSize
                if child.fontSize.isSet {
                    fontSize = child.fontSize.pixels
                }
                if (fontSize <= 0.0) {
                    fontSize = 14.0
                }
                def contentW:double (textEngine.maxLineWidthSpaced(textContent (child.effectiveFontFamily()) fontSize child.letterSpacing))
                def measuredW:double (contentW + child.box.paddingLeftPx + child.box.paddingRightPx + (child.box.borderWidthPx * 2.0))
                if (measuredW < maxInnerWidth) {
                    return measuredW
                }
            }
        }
        ; A width-less flex CONTAINER is worth as much as its contents, the
        ; same as it is in `layoutElement`. This used to fall straight through
        ; to `maxInnerWidth` — the whole row — so a row holding a container and
        ; a `flex: 1` spacer computed no free space at all and the spacer got
        ; nothing. The header of the profile demo is exactly that shape: a
        ; title block, a spacer, and a badge that was supposed to sit at the
        ; far end and sat against the title instead.
        ;
        ; It is the same question `layoutElement` asks two hundred lines up,
        ; and asking it two different ways is what let the flex basis and the
        ; finished width disagree.
        ; min-content | max-content | fit-content, as layoutElement sizes them
        def wt:int child.width.unitType
        if ((wt == 6) || ((wt == 7) || (wt == 8))) {
            def mOut:double (child.box.marginLeftPx + child.box.marginRightPx)
            def mnW:double ((this.intrinsicWidth(child true)) - mOut)
            def mxW:double ((this.intrinsicWidth(child false)) - mOut)
            if (mnW < 0.0) {
                mnW = 0.0
            }
            if (mxW < mnW) {
                mxW = mnW
            }
            if (wt == 7) {
                return mnW
            }
            if (wt == 8) {
                return mxW
            }
            def fw:double maxInnerWidth
            if (fw > mxW) {
                fw = mxW
            }
            if (fw < mnW) {
                fw = mnW
            }
            return fw
        }
        if (((child.display == "flex") || (child.display == "grid")) && alongRow) {
            ; (an empty box, or one with only empty boxes in it, is as wide
            ; as its padding and border; an empty grid is as wide as its
            ; tracks)
            if ((child.display == "flex") && (EVGLayout.emptyTree(child))) {
                return ((child.box.paddingLeftPx + child.box.paddingRightPx) + (child.box.borderWidthPx * 2.0))
            }
            ; (the intrinsic width is the margin box's, the width the
            ; border box's)
            def intrinsic:double (((this.intrinsicWidth(child false)) - child.box.marginLeftPx) - child.box.marginRightPx)
            if (intrinsic > 0.0) {
                if (intrinsic < maxInnerWidth) {
                    return intrinsic
                }
            }
        }
        return maxInnerWidth
    }
    
}
