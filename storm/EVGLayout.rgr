        def cols:EVGGridTemplate (EVGGridTemplate.parse(colSpec))
        if (cols.hadError) {
            this.warn(("grid-template-columns: " + cols.errorText))
        }
        def colCount:int (cols.count())
        if (colCount < 1) {
            return 0.0
        }
        def colGapTotal:double ((to_double (colCount - 1)) * colGapPx)
        ; Column sizing is deferred until after placement: an `auto` or
        ; `fit-content()` track is sized from the items that land in it, so
        ; the tracks cannot be resolved until it is known which those are.
        ; Nothing between here and there reads a track extent.

        ; The row template is parsed here as well as where the rows are sized,
