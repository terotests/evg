; SPDX-License-Identifier: MIT

; EVGLayout.rgr - Layout algorithm for EVG

Import "EVGElement.rgr"
Import "EVGStyleSheet.rgr"
Import "EVGTextMeasurer.rgr"
Import "EVGImageMeasurer.rgr"
Import "EVGGrid.rgr"
Import "EVGReject.rgr"
Import "EVGTextEngine.rgr"
Import "EVGConnector.rgr"
Import "EVGLayoutExt.rgr"

; Where one candidate placement would put a surface, and what it costs.
class OverlaySpot {
    def x:double 0.0
    def y:double 0.0
    ; Pixels of the surface that would be off the page.
    def over:double 0.0
    ; Free space left between the surface and the page edge on that side.
    def room:double 0.0
}

class EVGLayout {
    def measurer:EVGTextMeasurer
    ; The one text measurement + wrapping implementation. Layout must break
    ; lines exactly where paint will, so both go through this.
    def textEngine:EVGTextEngine (new EVGTextEngine())
    def imageMeasurer:EVGImageMeasurer
    def pageWidth:double 612.0
    def pageHeight:double 792.0
    def currentPage:int 0
    def debug:boolean false
    ; Overlay surfaces the pass could not place, by id and reason. An overlay
    ; with no anchor would otherwise land at the top-left corner and read as a
    ; styling mistake; this is what makes it a reportable one.
    def overlayErrors:[string]
    ; Every `anchor-name` and `#id` in the tree, collected once per layout and
    ; read by both things that point at a box by name: the connectors and the
    ; surfaces. See `EVGConnector.collectAnchors`.
    def anchorNames:[string]
    def anchorNodes:[EVGElement]
    ; Grid track lists and placements that the engine could not honour.
    ;
    ; These used to go to this.log(), which is a no-op unless `debug` is on, so
    ; `fit-content()`, row `subgrid` and a mistyped template were silently
    ; dropped in every normal run — the page just came out with the wrong
    ; number of columns. They are collected here instead and reported by the
    ; tools the same way font warnings are.
    def warnings:[string]
    ; The document's stylesheet, parsed. Kept beside the text it came from so
    ; a document laid out every frame parses its CSS once.
    def docSheet@(optional):EVGStyleSheet
    def docCssText:string ""
    ; the CSS conformance layer, when one is installed (EVGLayoutExt); else
    ; the core's own answers
    def ext:EVGLayoutExt
    
    Constructor () {
        ext = (EVGLayoutExtDefault.ext())
        ; The process-wide default (`EVGDefaultMeasurer`): a host's own
        ; measurer when one is installed, the table otherwise.
        def m:EVGTextMeasurer (EVGDefaultMeasurer.measurer())
        measurer = m
        textEngine.setMeasurer(m)
        def im (new SimpleImageMeasurer())
        imageMeasurer = im
    }
    
    fn setMeasurer:void (m:EVGTextMeasurer) {
        measurer = m
        textEngine.setMeasurer(m)
    }

    fn getTextEngine:EVGTextEngine () {
        return textEngine
    }

    ; Refuse to measure a custom-font document with guessed widths (§4.1 rule 1).
    fn setStrictFonts:void (s:boolean) {
        textEngine.setStrict(s)
    }
    
    fn setImageMeasurer:void (m:EVGImageMeasurer) {
        imageMeasurer = m
    }
    
    fn setPageSize:void (w:double h:double) {
        pageWidth = w
        pageHeight = h
    }
    
    fn setDebug:void (d:boolean) {
        debug = d
    }
    
    fn log:void (msg:string) {
        if debug {
            print msg
        }
    }

    ; Record something the author asked for that the engine could not do.
    ; Deduplicated: one bad template on a repeated component would otherwise
    ; report once per instance and bury everything else.
    fn warn:void (msg:string) {
        def i:int 0
        while (i < (array_length warnings)) {
            if ((itemAt warnings i) == msg) {
                return
            }
            i = (i + 1)
        }
        push warnings msg
        this.log(("  " + msg))
    }

    ; THE DOCUMENT'S OWN STYLESHEET.
    ;
    ; A `.evg.json` can carry one (`"css"` beside `"root"`), and this is where
    ; it takes effect — one place rather than at every call site that loads a
    ; document, so a tool that only knows how to lay a tree out gets the
    ; cascade for free.
    ;
    ; Parsed once per text: the same document laid out again on every frame
    ; must not re-parse a stylesheet that has not changed. Applying it again
    ; is harmless and necessary — a rule is a value on an element, and layout
    ; resets those.
    ;
    ; An inline property still wins, which is what lets the two mix: the sheet
    ; says what a `.card` is, the node says what THIS card does differently,
    ; and an agent's `set-prop` keeps meaning what it meant.
    fn applyDocumentCss:void (root:EVGElement) {
        if ((strlen root.documentCss) == 0) {
            return
        }
        if (root.documentCss != docCssText) {
            def s (new EVGStyleSheet())
            s.parse(root.documentCss)
            docSheet = s
            docCssText = root.documentCss
        }
        if (null? docSheet) {
            return
        }
        def sheet:EVGStyleSheet (unwrap docSheet)
        ; Last pass's marks first. A rule that was edited out would otherwise
        ; leave a property marked as the sheet's forever, and the document
        ; would stop writing down a value it is the only record of.
        EVGLayout.clearCssMarks(root)
        ; The root's `theme` turns on the sheet's `.theme-<name> .class`
        ; rules. Passing "" here made every theme-scoped rule in a document
        ; dead: `{"theme":"dark"}` on the root parsed, round-tripped, and
        ; styled nothing.
        sheet.applyTree(root root.theme)
    }

    sfn clearCssMarks:void (el:EVGElement) {
        el.clearCssMarks()
        def i:int 0
        while (i < (el.getChildCount())) {
            EVGLayout.clearCssMarks((el.getChild(i)))
            i = (i + 1)
        }
    }

    fn warningCount:int () {
        return (array_length warnings)
    }

    fn warningAt:string (i:int) {
        return (itemAt warnings i)
    }
    
    fn layout:void (root:EVGElement) {
        ; Layout the entire element tree
        this.log("EVGLayout: Starting layout")
        currentPage = 0
        ; (the CSS layer installed since this layout was made counts too)
        ext = (EVGLayoutExtDefault.ext())
        this.applyDocumentCss(root)

        ; Start from a clean slate. `resolveUnits` refuses to run twice on the
        ; same element — deliberately, so a percentage is not resolved against
        ; an already-resolved parent — and it had no counterpart: nothing in the
        ; engine called resetLayoutState(), so an element laid out ONCE kept its
        ; resolved pixels forever, and a percentage written after that first
        ; pass resolved to zero.
        ;
        ; Measured, not theorised: a slider whose thumb is placed with
        ; `left: <n>%` sat correctly on first paint and then jumped to the far
        ; left the moment it was dragged, because the fresh unit the controller
        ; wrote was never resolved. Any retained tree that is laid out more than
        ; once had the same bug; a document that is laid out once did not, which
        ; is why it survived this long.
        ;
        ; A NEW PAGE SIZE is a new layout for every kept subtree too. The
        ; root's viewport is what the last pass was given; when it differs, a
        ; `vw` or `vh` anywhere below may mean something else, and nothing a
        ; kept box compares — what the flow hands it — need have changed. The
        ; stylesheet catches this for the trees it styles (a resize is a new
        ; generation, so every element is layout-dirty); a tree with no sheet,
        ; or one laid out without re-applying it, has only this.
        if (root.hasLayout && ((root.viewportW != pageWidth) || (root.viewportH != pageHeight))) {
            root.forgetLayout()
        }
        root.resetLayoutState()
        
        ; Resolve root dimensions
        if (root.width.isSet == false) {
            root.width = (EVGUnit.px(pageWidth))
        }
        if (root.height.isSet == false) {
            root.height = (EVGUnit.px(pageHeight))
        }
        
        ; The root inherits from nothing, so its own font-size has to be folded
        ; in here or it is silently dropped. `rem` on the root itself resolves
        ; against the initial size, which is why rootFontSize is only published
        ; afterwards.
        root.applyOwnFontSize()
        root.rootFontSize = root.inheritedFontSize
        ; THE VIEWPORT, published once and inherited from here. `vw` and `vh`
        ; mean the page size this layout was given — which on paper is the page
        ; AREA, because that is what the print renderers set it to: the section
        ; less two margins. A host that wants `100vh` to mean its window says
        ; so with `setPageSize`, which every host already calls.
        root.viewportW = pageWidth
        root.viewportH = pageHeight
        root.viewportX = 0.0
        root.viewportY = 0.0
        ; The root has no parent to inherit a direction from, so it settles
        ; its own. This is the switch: `direction: rtl` here and every
        ; container below turns around with it.
        root.applyOwnDirection(false)

        ; Explicitly set root position to (0, 0)
        ; This is important when re-laying out a page that was previously 
        ; positioned elsewhere in a multi-page document
        root.calculatedX = 0.0
        root.calculatedY = 0.0
        
        ; Layout root at (0, 0)
        this.layoutElement(root 0.0 0.0 pageWidth pageHeight)
        ext.afterLayout(this root)

        ; The names first: a surface may be positioned against any box in the
        ; tree, not only a sibling, and so may a connector.
        clear anchorNames
        clear anchorNodes
        EVGConnector.collectAnchors(root anchorNames anchorNodes)

        ; Then the overlays, once everything they anchor to has a rectangle.
        clear overlayErrors
        def anySurface:boolean (this.placeOverlaysIn(root))

        ; The connectors, once every box they join has its final rectangle —
        ; the overlay pass above is the last thing that moves one, and a line
        ; solved before it would point at where a card used to be.
        def connWarnings:[string] (EVGConnector.resolveWith(root anchorNames anchorNodes))
        def cwi:int 0
        while (cwi < (array_length connWarnings)) {
            this.warn((itemAt connWarnings cwi))
            cwi = (cwi + 1)
        }

        ; And where each subtree DRAWS, which is not where its box is: see
        ; `EVGElement.paintTop`. Last, because it is a union over final
        ; positions and the overlay pass above is the last thing that moves
        ; one.
        this.measurePaintBounds(root)

        ; Everything `setAttribute` could not read, folded into the same list a
        ; build already fails on. It is drained here rather than reported at
        ; the point of parse because a parse has no idea whether anyone will
        ; ever lay the tree out, and a warning nobody collects is the silence
        ; this was written to end.
        ;
        ; The collector de-duplicates and caps itself, so this loop is bounded
        ; by the number of DISTINCT bad declarations in the document — four,
        ; typically, and never more than sixty-four.
        this.drainRejects()

        this.log("EVGLayout: Layout complete")
    }

    ; Move `EVGReject`'s entries into the layout's own warnings, once.
    fn drainRejects:void () {
        def n:int (EVGReject.noteCount())
        if (n == 0) {
            return
        }
        def i:int 0
        while (i < n) {
            this.warn((EVGReject.noteAt(i)))
            i = (i + 1)
        }
        def total:int (EVGReject.noteTotal())
        if (total > n) {
            this.warn((((("… " + (to_string total)) + " rejected declarations in all, ") + (to_string n)) + " distinct"))
        }
    }

    ; The union of an element's own box and every box beneath it, bottom-up.
    ;
    ; This is what `EVGDisplayList` culls against, and the reason it can cull
    ; a subtree WITHOUT DESCENDING INTO IT — which is the whole saving. An
    ; element's own rectangle would not do: a zero-height wrapper sits at the
    ; top of the document while its rows are ten thousand pixels below it, and
    ; culling on the wrapper would take the rows with it.
    fn measurePaintBounds:void (el:EVGElement) {
        ; A subtree the layout kept moved with its bounds; they still hold —
        ; when they were measured since it was last laid out for real.
        if (el.layoutSkipped && el.boundsFresh) {
            return
        }
        el.boundsFresh = true
        ; Where the first child sits relative to the box, for a kept subtree
        ; to be moved by — see `EVGElement.kidOffX`.
        if ((el.getChildCount()) > 0) {
            def k0:EVGElement (el.getChild(0))
            el.kidOffX = (k0.calculatedX - el.calculatedX)
            el.kidOffY = (k0.calculatedY - el.calculatedY)
        }
        ; A degenerate box draws nothing of its own — a wrapper with no size
        ; is a place in the tree, not a place on the page — so it does not
        ; drag the union back to wherever it happens to sit.
        def has:boolean ((el.calculatedWidth > 0.0) && (el.calculatedHeight > 0.0))
        def minX:double el.calculatedX
        def minY:double el.calculatedY
        def maxX:double (el.calculatedX + el.calculatedWidth)
        def maxY:double (el.calculatedY + el.calculatedHeight)
        def started:boolean has
        def unbounded:boolean (el.hasTransform())
        def effect:boolean ((strlen el.surfaceEffect) > 0)

        def i:int 0
        while (i < (el.getChildCount())) {
            def kid:EVGElement (el.getChild(i))
            this.measurePaintBounds(kid)
            ; `display: none` paints nothing and nothing under it, so its
            ; rectangle — usually a stale one, or the origin — is not part of
            ; where this subtree draws.
            if ((kid.isHidden()) == false) {
                if kid.paintUnbounded {
                    unbounded = true
                }
                if kid.paintHasEffect {
                    effect = true
                }
                if (started == false) {
                    minX = kid.paintLeft
                    minY = kid.paintTop
                    maxX = kid.paintRight
                    maxY = kid.paintBottom
                    started = true
                } {
                    if (kid.paintLeft < minX) { minX = kid.paintLeft }
                    if (kid.paintTop < minY) { minY = kid.paintTop }
                    if (kid.paintRight > maxX) { maxX = kid.paintRight }
                    if (kid.paintBottom > maxY) { maxY = kid.paintBottom }
                }
            }
            i = (i + 1)
        }

        el.paintLeft = minX
        el.paintTop = minY
        el.paintRight = maxX
        el.paintBottom = maxY
        el.paintUnbounded = unbounded
        el.paintHasEffect = effect
    }
    
    ; Whether the element about to be laid out sits along a ROW.
    ;
    ; A field rather than a parameter, and rather than reading `child.parent`,
    ; because EVGElement deliberately has no parent back-reference: it was
    ; write-only and, in the C++ backend, assigning `this` to a shared_ptr
    ; field forces `enable_shared_from_this` and breaks the native build. Its
    ; own comment says so, which is the only reason this is a field.
    ;
    ; The flex pass sets it before each child and puts it back afterwards. The
    ; default is true, which is the block behaviour the root and any non-flex
    ; parent want.
    def layingOutAlongRow:boolean true
    ; inside the measure of a min-width: max-content / max-width:
    ; min-content box (intrinsicWidthNow), which does not nest
    def measuringKeyword:boolean false

    ; And, for a COLUMN parent, whether the cross axis shrink-wraps.
    ;
    ; `width: auto` on a flex item is stretch only while `align-items` is
    ; stretch; under `center` or `flex-end` it is fit-content, which is the
    ; difference between a breadcrumb trail centred under the label it belongs
    ; to and one pinned to the left edge of a box it has filled.
    ;
    ; This engine's `alignItems` default is "flex-start" where CSS's is
    ; "stretch", and everything built so far leans on the stretch. So only an
    ; EXPLICIT centre or end shrinks: a container that never mentioned
    ; `align-items` keeps exactly the behaviour it has today.
    def columnCrossShrinks:boolean false
    ; (set while a column of no height shrinks its items into its max-height)
    def shrinkIntoMax:boolean false

    fn layoutElement:void (element:EVGElement parentX:double parentY:double parentWidth:double parentHeight:double) {
        ; (the CSS layer may lay out a percentage height of a height still
        ; unknown as auto, and such a max-height as none, CSS 2.1 10.5, 10.7)
        if ((parentHeight <= 0.0) && ((element.height.isSet && (element.height.unitType == 1)) || (element.maxHeight.isSet && (element.maxHeight.unitType == 1)))) {
            if (!null? element.css) {
                if (ext.pctHeightAuto(this element)) {
                    def hOn:boolean element.height.isSet
                    def mOn:boolean element.maxHeight.isSet
                    element.height.isSet = (hOn && (element.height.unitType != 1))
                    element.maxHeight.isSet = (mOn && (element.maxHeight.unitType != 1))
                    this.layoutElement(element parentX parentY parentWidth parentHeight)
                    element.height.isSet = hOn
                    element.maxHeight.isSet = mOn
                    return
                }
            }
        }
        ; A subtree the app keeps — see `EVGElement.keepLayout` — with the
        ; same inputs as last time is the same layout, moved: the flow
        ; reads its size and baseline off it as if it had been laid out.
        if element.keepLayout {
            if (element.hasLayout && element.layoutClean) {
                if ((((element.lastParentW == parentWidth) && (element.lastParentH == parentHeight))
                     && (element.lastFlex == element.hasFlexWidth)) && ((element.lastFlexW == element.calculatedFlexWidth) && (element.lastFlexH == element.calculatedFlexHeight))) {
                    ; The box is at (parentX, parentY): the flow wrote it there
                    ; before this call, or means it at the origin to move it
                    ; after. What is under it follows by the difference between
                    ; where the first child is and where it sat relative to the
                    ; box when the subtree was measured; the bounds, which were
                    ; measured with the children, follow by the same.
                    element.calculatedX = parentX
                    element.calculatedY = parentY
                    def n:int (element.getChildCount())
                    if (n > 0) {
                        def k0:EVGElement (element.getChild(0))
                        def dx:double ((parentX + element.kidOffX) - k0.calculatedX)
                        def dy:double ((parentY + element.kidOffY) - k0.calculatedY)
                        if ((dx != 0.0) || (dy != 0.0)) {
                            def i:int 0
                            while (i < n) {
                                def kid:EVGElement (element.getChild(i))
                                kid.moveSubtree(dx dy)
                                i = (i + 1)
                            }
                            element.paintLeft = (element.paintLeft + dx)
                            element.paintRight = (element.paintRight + dx)
                            element.paintTop = (element.paintTop + dy)
                            element.paintBottom = (element.paintBottom + dy)
                        }
                    } {
                        element.boundsFresh = false
                    }
                    element.layoutSkipped = true
                    return
                }
            }
            ; Laid out for real: what the root's reset left in place goes,
            ; but not what the parent has just handed down — the flex width,
            ; the flex height, and the box's place, which the flow wrote before
            ; this call.
            def flex:boolean element.hasFlexWidth
            def flexW:double element.calculatedFlexWidth
            def flexHSet:boolean element.hasFlexHeight
            def flexH:double element.calculatedFlexHeight
            def bx:double element.calculatedX
            def by:double element.calculatedY
            element.resetLayoutNow()
            element.hasFlexWidth = flex
            element.calculatedFlexWidth = flexW
            element.hasFlexHeight = flexHSet
            element.calculatedFlexHeight = flexH
            element.calculatedX = bx
            element.calculatedY = by
        }
        element.hasLayout = true
        element.layoutSkipped = false
        element.paintStamp = (element.paintStamp + 1)
        element.lastParentW = parentWidth
        element.lastParentH = parentHeight
        element.lastFlex = element.hasFlexWidth
        element.lastFlexW = element.calculatedFlexWidth
        element.lastFlexH = element.calculatedFlexHeight
        element.resolveUnits(parentWidth parentHeight)
        ; `display: none` has no box and lays out nothing under it.
        if (element.isHidden()) {
            element.calculatedX = parentX
            element.calculatedY = parentY
            element.calculatedWidth = 0.0
            element.calculatedHeight = 0.0
            return
        }
        
        ; Calculate element dimensions. Same order as `layoutChildren`: a width
        ; the flex pass decided wins over the declared one, because it IS the
        ; declared one after shrinking.
        def width:double parentWidth
        if element.width.isSet {
            width = element.width.pixels
        }
        if element.hasFlexWidth {
            width = element.calculatedFlexWidth
        }
        ; width: min-content | max-content | fit-content, from what the box
        ; holds: its narrowest, its widest, or the room there is between
        ; the two (CSS Sizing 3, 3.2)
        def keywordW:boolean false
        def wt:int element.width.unitType
        if (((element.width.isSet == false) && (element.hasFlexWidth == false)) && ((wt == 6) || ((wt == 7) || (wt == 8)))) {
            def mOut:double (element.box.marginLeftPx + element.box.marginRightPx)
            def mnW:double ((this.intrinsicWidth(element true)) - mOut)
            def mxW:double ((this.intrinsicWidth(element false)) - mOut)
            if (mnW < 0.0) {
                mnW = 0.0
            }
            if (mxW < mnW) {
                mxW = mnW
            }
            if (wt == 7) {
                width = mnW
            }
            if (wt == 8) {
                width = mxW
            }
            if (wt == 6) {
                width = parentWidth
                if (element.fitRoom >= 0.0) {
                    width = element.fitRoom
                }
                if (width > mxW) {
                    width = mxW
                }
                if (width < mnW) {
                    width = mnW
                }
            }
            keywordW = true
        }
        
        ; Text leaf nodes without explicit width shrink-wrap to measured content
        if ((element.width.isSet == false) && (element.hasFlexWidth == false)) {
            def textContent:string element.textContent
            if ((strlen textContent) > 0) {
                if ((element.getChildCount()) == 0) {
                    def fontSize:double element.inheritedFontSize
                    if element.fontSize.isSet {
                        fontSize = element.fontSize.pixels
                    }
                    if (fontSize <= 0.0) {
                        fontSize = 14.0
                    }
                    def contentW:double (textEngine.maxLineWidthSpaced(textContent (element.effectiveFontFamily()) fontSize element.letterSpacing))
                    def measuredW:double (contentW + element.box.paddingLeftPx + element.box.paddingRightPx + (element.box.borderWidthPx * 2.0))
                    if (measuredW < parentWidth) {
                        width = measuredW
                    } {
                        ; (but never under its longest word, which overflows)
                        def minW:double ((textEngine.minLineWidthSpaced(textContent (element.effectiveFontFamily()) fontSize element.letterSpacing)) + ((element.box.paddingLeftPx + element.box.paddingRightPx) + (element.box.borderWidthPx * 2.0)))
                        ; (a line that does not wrap keeps the box's width,
                        ; where text-overflow cuts it)
                        def ws0:string element.whiteSpace
                        if ((minW > width) && ((ws0 != "nowrap") && (ws0 != "pre"))) {
                            width = minW
                        }
                    }
                }
            } {
                ; A width-less flex CONTAINER shrink-wraps too — but only in a
                ; ROW. This is `width: auto` in CSS and it resolves two
                ; different ways: fit-content for an item laid out along a row,
                ; and STRETCH for one in a column, where the cross axis fills
                ; because `align-items` defaults to stretch.
                ;
                ; The first version of this shrank in both, and the damage was
                ; exactly what the rule predicts: in a vertical panel group,
                ; every panel collapsed to the width of the label inside it and
                ; the divider collapsed to the width of its grip. Correct on
                ; the axis it was written for and wrong on the other one.
                if ((element.display == "flex") || (element.display == "grid")) {
                    if (this.crossAxisFits(element)) {
                        ; (the intrinsic width is the margin box's; the
                        ; width is the border box's)
                        def intrinsic:double (((this.intrinsicWidth(element false)) - element.box.marginLeftPx) - element.box.marginRightPx)
                        ; (an empty box fits to nothing but its edges)
                        ; (and so does one with only empty boxes in it)
                        def emptyBox:boolean (EVGLayout.emptyTree(element))
                        if ((emptyBox && (element.display == "flex")) && ((element.minWidth.isSet == false) || (((element.minWidth.pixels <= 0.0) && ((element.minWidth.isPercent()) == false)) && ((element.getChildCount()) > 0)))) {
                            width = ((element.box.paddingLeftPx + element.box.paddingRightPx) + (element.box.borderWidthPx * 2.0))
                        }
                        if (intrinsic > 0.0) {
                            if (intrinsic < parentWidth) {
                                width = intrinsic
                            } {
                                ; fit-content is never under the min-content
                                ; width: a word wider than the room overflows
                                ; (a box that clips, or one whose min-width
                                ; is set, is narrowed as it is told)
                                def narrow:double (((this.intrinsicWidth(element true)) - element.box.marginLeftPx) - element.box.marginRightPx)
                                if (((narrow > width) && ((element.clipsContent()) == false)) && (element.minWidth.isSet == false)) {
                                    width = narrow
                                }
                            }
                        }
                    }
                }
            }
        }
        
        def height:double 0.0
        def autoHeight:boolean true
        
        ; Special handling for Page elements - they always use page size
        if ((element.tagName == "Page") || (element.tagName == "page")) {
            if (element.width.isSet == false) {
                width = pageWidth
            }
            if (element.height.isSet == false) {
                height = pageHeight
                autoHeight = false
            }
        }
        if element.height.isSet {
            height = element.height.pixels
            autoHeight = false
            ; aspect-ratio: an auto width from a set height
            if (((element.width.isSet == false) && (element.hasFlexWidth == false)) && ((element.aspectRatio > 0.0) && (keywordW == false))) {
                def edgeXa:double ((element.box.paddingLeftPx + element.box.paddingRightPx) + (element.box.borderWidthPx * 2.0))
                def edgeYa:double ((element.box.paddingTopPx + element.box.paddingBottomPx) + (element.box.borderWidthPx * 2.0))
                def innerHa:double (height - edgeYa)
                if (innerHa < 0.0) {
                    innerHa = 0.0
                }
                width = ((innerHa * element.aspectRatio) + edgeXa)
            }
        }
        ; aspect-ratio: an auto height from the width, the content box's
        if ((element.height.isSet == false) && (element.aspectRatio > 0.0)) {
            def edgeX:double ((element.box.paddingLeftPx + element.box.paddingRightPx) + (element.box.borderWidthPx * 2.0))
            def edgeY:double ((element.box.paddingTopPx + element.box.paddingBottomPx) + (element.box.borderWidthPx * 2.0))
            ; (the width min-width / max-width leave, CSS Sizing 4 5.1)
            def rw:double width
            if element.maxWidth.isSet {
                if (rw > element.maxWidth.pixels) {
                    rw = element.maxWidth.pixels
                }
            }
            if element.minWidth.isSet {
                if (rw < element.minWidth.pixels) {
                    rw = element.minWidth.pixels
                }
            }
            def innerW:double (rw - edgeX)
            if (innerW < 0.0) {
                innerW = 0.0
            }
            height = ((innerW / element.aspectRatio) + edgeY)
            autoHeight = false
        }
        ; Column-axis flex grow / row alignItems:stretch: EVGLayout resolved a
        ; target height for this child (height not explicitly set) — adopt it.
        if (element.height.isSet == false) {
            if (element.calculatedFlexHeight > 0.0) {
                height = element.calculatedFlexHeight
                autoHeight = false
            }
        }
        ; Column-axis flex shrink squeezed a declared height: the squeezed one
        ; wins, as `hasFlexWidth` does for the width.
        if element.hasFlexHeight {
            height = element.calculatedFlexHeight
            autoHeight = false
        }
        ; aspect-ratio down a column that does not stretch: the width
        ; follows the flexed height (CSS Flexbox 9.4 step 7, the ratio)
        if (((element.aspectRatio > 0.0) && (element.calculatedFlexHeight > 0.0)) && (((element.width.isSet == false) && (element.hasFlexWidth == false)) && (keywordW == false))) {
            if (((this.parentIsRow(element)) == false) && columnCrossShrinks) {
                def edgeXf:double ((element.box.paddingLeftPx + element.box.paddingRightPx) + (element.box.borderWidthPx * 2.0))
                def edgeYf:double ((element.box.paddingTopPx + element.box.paddingBottomPx) + (element.box.borderWidthPx * 2.0))
                ; (the height its min-height / max-height leave)
                def rh:double height
                if element.maxHeight.isSet {
                    if (rh > element.maxHeight.pixels) {
                        rh = element.maxHeight.pixels
                    }
                }
                if element.minHeight.isSet {
                    if (rh < element.minHeight.pixels) {
                        rh = element.minHeight.pixels
                    }
                }
                def innerHf:double (rh - edgeYf)
                if (innerHf < 0.0) {
                    innerHf = 0.0
                }
                width = ((innerHf * element.aspectRatio) + edgeXf)
