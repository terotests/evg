                    }
                    push kidMains km
                }
                if (w > widest) {
                    widest = w
                }
                if (counted > 0) {
                    total = (total + gapPx)
                }
                total = (total + w)
                counted = (counted + 1)
            }
            i = (i + 1)
        }
        def inner:double total
        ; a row that wraps is, at its narrowest, its widest item
        if (isColumn || (wantMin && (el.flexWrap != "nowrap"))) {
