        }
        element.calculatedPage = currentPage
        element.isLayoutComplete = true

        ; A container inherits the baseline of its first in-flow child (CSS
        ; "first baseline"), so a Label wrapped in a View still aligns.
        if (!null? element.css) {
            ext.finishElement(this element childCount)
        }
        if ((element.hasBaseline == false) && (childCount > 0)) {
            this.inheritBaselineFromFirstChild(element)
        }
        if ((element.clipsContent()) && element.hasBaseline) {
            ext.clampBaseline(this element)
        }

        ; --- SCROLLING --------------------------------------------------------
        ;
        ; The last thing that happens to an element, and it has to be: the
        ; extents are measured from where the children ENDED UP, so this runs
        ; after every one of them is placed. `layoutChildren` has already been
        ; through the whole subtree by the time control gets back here.
        if (element.clipsContent()) {
            this.applyScroll(element)
        }
        
        if debug {
            this.log(("  Laid out " + element.tagName + " id=" + element.id + " at (" + (to_string element.calculatedX) + "," + (to_string element.calculatedY) + ") size=" + (to_string width) + "x" + (to_string height)))
        }
    }
    
    ; What a scroll container owes: how big its content is, and where the
    ; content currently sits.
    ;
    ; The offset is applied as a TRANSLATION of the placed subtree rather than
    ; as an origin the flow is run from. That is not a shortcut. The flow has
    ; to run at the content's natural size for the extent to mean anything —
    ; measure first, then move — and running it from a shifted origin would
    ; make the extent a function of the scroll position, which is how a
    ; scrollbar ends up changing size as you drag it.
    ;
    ; EVERYTHING inside moves, absolutely positioned children and overlay
    ; surfaces alike. That is what a browser does: an absolute box is
    ; positioned against this one, so it belongs to its content, and a dropdown
    ; opened from a row inside a scrolled panel travels with the row. Only
    ; `position: fixed` escapes — it is furniture over the viewport rather than
    ; content, and `moveSubtreeUnfixed` is the walk that steps over it.
    ;
    ; It reuses the mover the RTL mirror already had. One function that walks a
    ; placed subtree and adds an offset to it is enough; a second one would be
    ; two places for the same rule to be got wrong.
    ; How far the content reaches, measured from where the children ended up.
    ; Separate from `applyScroll` because the overlay pass has to ask the
    ; question again after it has resized a surface, WITHOUT translating
    ; anything a second time.
    fn measureScrollExtent:void (el:EVGElement) {
        def innerX:double (el.calculatedX + el.box.borderWidthPx + el.box.paddingLeftPx)
        def innerY:double (el.calculatedY + el.box.borderWidthPx + el.box.paddingTopPx)
        def w:double 0.0
        def h:double 0.0
        def i:int 0
        while (i < (el.getChildCount())) {
            def kid:EVGElement (el.getChild(i))
            def right:double ((kid.calculatedX + kid.calculatedWidth) - innerX)
            def bottom:double ((kid.calculatedY + kid.calculatedHeight) - innerY)
            if (right > w) {
                w = right
            }
            if (bottom > h) {
                h = bottom
            }
            i = (i + 1)
        }
        ; PADDING BOX, like the DOM: the content extent plus the paddings on
        ; both sides. Measured, not assumed — eight 60-pixel rows in a box with
        ; 10 of padding gives the browser 500.
        el.scrollWidth = ((w + el.box.paddingLeftPx) + el.box.paddingRightPx)
        el.scrollHeight = ((h + el.box.paddingTopPx) + el.box.paddingBottomPx)
    }

    fn applyScroll:void (el:EVGElement) {
        this.measureScrollExtent(el)

        ; Clamped, the way a browser clamps `scrollTop`: an application that
        ; asks to scroll past the end has asked for the end. Doing it here and
        ; not in the setter is what makes it correct — how far there is to go
        ; is not known until the content has been measured, and it changes
        ; every time the content does.
        def maxY:double (el.maxScrollTop())
        if (el.scrollTop > maxY) {
            el.scrollTop = maxY
        }
        if (el.scrollTop < 0.0) {
            el.scrollTop = 0.0
        }
        def maxX:double (el.maxScrollLeft())
        if (el.scrollLeft > maxX) {
            el.scrollLeft = maxX
        }
        if (el.scrollLeft < 0.0) {
            el.scrollLeft = 0.0
        }

        ; Where the boxes now are, which is what `scrollOnly` moves FROM.
        ; Written whether or not anything is translated: an unscrolled
        ; container has applied zero, and that is a fact about it, not the
        ; absence of one.
        el.appliedScrollTop = el.scrollTop
        el.appliedScrollLeft = el.scrollLeft

        if ((el.scrollTop == 0.0) && (el.scrollLeft == 0.0)) {
            return
        }
        def j:int 0
        while (j < (el.getChildCount())) {
            def moved:EVGElement (el.getChild(j))
            if (moved.isFixedPosition()) {
            } {
                moved.moveSubtreeUnfixed((0.0 - el.scrollLeft) (0.0 - el.scrollTop))
            }
            j = (j + 1)
        }
    }

    ; --- SCROLLING WITHOUT LAYING OUT -----------------------------------------
    ;
    ; A SCROLL DOES NOT CHANGE A LAYOUT. `applyScroll` above lays the content
    ; out as if nothing were scrolled and then TRANSLATES the subtree by
