                return (el.box.getHorizontalChrome())
            }
            return 0.0
        }
        def isColumn:boolean ((el.flexDirection == "column") || (el.flexDirection == "column-reverse"))
        def gapPx:double 0.0
        if el.gap.isSet {
            gapPx = el.gap.pixels
        }
        if el.columnGap.isSet {
            gapPx = el.columnGap.pixels
        }

        def total:double 0.0
        def widest:double 0.0
        def counted:int 0
        ; (a column that wraps in a definite height is, at its widest, its
        ; lines side by side)
        def colLines:boolean ((isColumn && (wantMin == false)) && ((el.flexWrapSet && (el.flexWrap == "wrap")) && (el.height.isSet && ((el.height.isPercent()) == false))))
        def kidWs:[double]
        def kidMains:[double]
        def i:int 0
        while (i < n) {
            def kid:EVGElement (el.getChild(i))
            ; Out of flow — absolute, or `display: none` — takes no share of
            ; the intrinsic size. This asked the position string rather than
            ; `isAbsolute`, so a rail the sheet had folded away still claimed
            ; its icons' width from the row and the page beside it came up
            ; 32px short.
            if (kid.isAbsolute || (kid.isHidden())) {
            } {
