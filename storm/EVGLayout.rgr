                }
                ; (the CSS layer rounds each metric to the pixel, as
                ; browsers have them; the core's are the painter's)
                def ascR:double metrics.ascent
                def descR:double descentAbs
                if (ext.pixelMetrics()) {
                    ascR = (to_double (to_int (metrics.ascent + 0.5)))
                    descR = (to_double (to_int (descentAbs + 0.5)))
                }
                def leading:double ((lineSpacing - (ascR + descR)) / 2.0)
                ; `textShiftY` is written below, once the height is final —
                ; it is a share of the slack and there is no slack until then
                ; — so the baseline is completed there as well.
                element.calculatedBaseline = (element.box.paddingTopPx + element.box.borderWidthPx + leading + ascR)
                element.calculatedLastBaseline = (element.calculatedBaseline + (lineSpacing * (to_double (lineCount - 1))))
