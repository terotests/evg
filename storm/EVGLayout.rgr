        }
        if ((itemCount == 0) && (explicitRows == 0)) {
            ; No tracks to size, but an overlay or a connector may still be
            ; sitting here out of flow.
            def noRows:[double]
            if ((ext.gridAbsAreas(this parent cols colGapPx noRows rowGapPx rowTemplate innerWidth innerHeight startX startY 0.0 0.0)) == false) {
                this.layoutGridOutOfFlow(parent innerWidth innerHeight startX startY)
            }
            return 0.0
        }

        ; --- placement -------------------------------------------------------
        def isDense:boolean ((indexOf parent.gridAutoFlow "dense") >= 0)
        ; occupancy[(row * colCount) + col]; grown a row at a time.
        def occupied:[boolean]
        def rowsUsed:int 0
        def placedRow:[int]
        def placedCol:[int]

        ; (CSS Grid 8.5: the items with both lines first, then those with
        ; a row, then the rest in order with one cursor)
