                    ; items this step put in the row before (dense: from
                    ; the row's start)
                    while ((array_length rowLockEnd) <= row) {
                        push rowLockEnd 0
                    }
                    col = 0
                    if (isDense == false) {
                        col = (itemAt rowLockEnd row)
                    }
                    while (((col + span) <= colCount) && (this.gridOccupied(occupied colCount row col span rspan))) {
                        col = (col + 1)
                    }
                    if ((col + span) > colCount) {
                        col = (colCount - span)
