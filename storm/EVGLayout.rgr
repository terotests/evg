            between = (free / (to_double (lineCount - 1)))
        }
        if (((mode == "space-between") && (lineCount == 1)) && (parent.flexWrap == "wrap-reverse")) {
            first = free
        }
        if (mode == "space-around") {
            between = (free / (to_double lineCount))
            first = (between / 2.0)
        }
        if (mode == "space-evenly") {
            between = (free / (to_double (lineCount + 1)))
            first = between
        }

        def idx:int 0
        def li:int 0
        while (li < lineCount) {
            def shift:double (first + (between * (to_double li)))
            ; (wrap-reverse: the lines run up, the first one at the bottom)
            if (parent.flexWrap == "wrap-reverse") {
                shift = (first + (between * (to_double ((lineCount - 1) - li))))
            }
            def n:int (itemAt counts li)
            def k:int 0
            while (k < n) {
                def el:EVGElement (itemAt members (idx + k))
                if (shift != 0.0) {
                    el.calculatedY = (el.calculatedY + shift)
                    this.propagateOffsetToChildren(el 0.0 shift)
                }
                k = (k + 1)
            }
            idx = (idx + n)
            li = (li + 1)
        }
    }
    
    ; extra height shared by a column's growing items: each laid out again
    ; at its grown height, the items after it moved down; what it took
    fn growColumnToMin:double (parent:EVGElement extra:double) {
        def growSum:double 0.0
        def n:int (parent.getChildCount())
        def i:int 0
        while (i < n) {
            def c:EVGElement (parent.getChild(i))
            if ((c.isAbsolute == false) && (c.flex > 0.0)) {
                growSum = (growSum + c.flex)
            }
            i = (i + 1)
        }
        if (growSum <= 0.0) {
            return 0.0
        }
        def div:double (EVGLayout.flexDivisor(growSum))
        def shiftY:double 0.0
        i = 0
        while (i < n) {
            def c:EVGElement (parent.getChild(i))
            if (c.isAbsolute == false) {
                if (shiftY != 0.0) {
                    c.calculatedY = (c.calculatedY + shiftY)
                    this.propagateOffsetToChildren(c 0.0 shiftY)
                }
                if ((c.flex > 0.0) && (c.height.isSet == false)) {
                    def oldH:double c.calculatedHeight
                    ; (its height is not definite: its children's
                    ; percentages stay as they were, Chromium has it so)
                    c.calculatedFlexHeight = (EVGLayout.limitH(c (oldH + ((extra * c.flex) / div))))
                    def wasRowG:boolean layingOutAlongRow
                    def wasShrinkG:boolean columnCrossShrinks
                    layingOutAlongRow = false
                    columnCrossShrinks = (this.crossShrinksFor(parent c))
                    this.layoutElement(c c.calculatedX c.calculatedY c.lastParentW c.lastParentH)
                    layingOutAlongRow = wasRowG
                    columnCrossShrinks = wasShrinkG
                    shiftY = (shiftY + (c.calculatedHeight - oldH))
                }
            }
            i = (i + 1)
        }
        return shiftY
    }

    fn alignColumn:void (parent:EVGElement contentHeight:double startX:double startY:double innerWidth:double innerHeight:double) {
        ; Apply justifyContent (vertical) and alignItems (horizontal) alignment for column layout
        def childCount:int (parent.getChildCount())
        if (childCount == 0) {
            return
        }
        
        ; Get effective alignment values
        ; For column direction: justifyContent = vertical (main axis), alignItems = horizontal (cross axis)
        def verticalAlign:string parent.justifyContent
        def horizontalAlign:string parent.alignItems
        ; Legacy align= center|left|right (EVG spec horizontal alignment).
        ; Default "left" must not clobber a set alignItems (left == flex-start).
        if ((strlen parent.align) > 0) {
            if (parent.align != "left") {
                horizontalAlign = parent.align
            }
        }
        
        ; Calculate vertical offset based on justifyContent
        def availableHeight:double innerHeight
        if parent.height.isSet {
            availableHeight = parent.calculatedInnerHeight
        }
        ; An auto height held up by `min-height` is that tall by the time it
        ; is drawn, but not yet here: the box is sized after its children.
        ; Aligning against the stale inner height put a 16px icon 8px ABOVE
        ; the 24px button it was meant to be centred in.
        if (((parent.height.isSet == false) && (parent.hasDefiniteHeight == false)) && (parent.minHeight.isSet && ((parent.minHeight.isPercent()) == false))) {
            def minInner:double (parent.minHeight.pixels - (parent.box.getVerticalChrome()))
            availableHeight = contentHeight
            if (minInner > availableHeight) {
                availableHeight = minInner
            }
        }
        ; (its growing items grow into the min-height: the column's main
        ; size is its content's clamped by it, CSS Flexbox 9.2 4)
        if (((parent.height.isSet == false) && (parent.hasDefiniteHeight == false)) && ((parent.minHeight.isSet && (parent.minHeight.pixels > 0.0)) && (parent.flexWrap != "wrap-reverse"))) {
            def minIn:double (parent.minHeight.pixels - (parent.box.getVerticalChrome()))
            if (minIn > (contentHeight + 0.01)) {
                contentHeight = (contentHeight + (this.growColumnToMin(parent (minIn - contentHeight))))
                availableHeight = minIn
            }
        }
        ; An auto height is its content's, but it is not known yet here: the
        ; inner height is still 0 (or a previous pass's). Centring against it
        ; put a button's label (MfdDomView centres a button's content) half a
        ; line ABOVE the button's top.
        if ((parent.hasDefiniteHeight == false) && (availableHeight < contentHeight)) {
            availableHeight = contentHeight
        }

        def offsetY:double 0.0
        if (verticalAlign == "center") {
            offsetY = ((availableHeight - contentHeight) / 2.0)
        }
        if ((verticalAlign == "flex-end") || (verticalAlign == "end")) {
            offsetY = (availableHeight - contentHeight)
        }

        ; Count non-absolute children for space distribution.
        def flowCount:int 0
        def fc:int 0
        while (fc < childCount) {
            def fchild:EVGElement (parent.getChild(fc))
            if (fchild.isAbsolute == false) {
                flowCount = (flowCount + 1)
            }
            fc = (fc + 1)
        }

        ; Space distribution (justifyContent) along the vertical main axis.
        def freeSpaceY:double (availableHeight - contentHeight)
        if (freeSpaceY < 0.0) {
            freeSpaceY = 0.0
        }
        def distributeGapY:double 0.0
        def distributeFirstY:double 0.0
        if (verticalAlign == "space-between") {
            if (flowCount > 1) {
                distributeGapY = (freeSpaceY / (to_double (flowCount - 1)))
            }
        }
        if (verticalAlign == "space-around") {
            if (flowCount > 0) {
                distributeGapY = (freeSpaceY / (to_double flowCount))
                distributeFirstY = (distributeGapY / 2.0)
            }
        }
        if (verticalAlign == "space-evenly") {
            distributeGapY = (freeSpaceY / (to_double (flowCount + 1)))
            distributeFirstY = distributeGapY
        }
        def usesDistributeY:boolean ((distributeGapY > 0.0) || (distributeFirstY > 0.0))

        ; auto margins down the column take the free height first
        def autoCountY:int 0
        def ay:int 0
        while (ay < childCount) {
            def ach:EVGElement (parent.getChild(ay))
            if (ach.isAbsolute == false) {
                if ach.marginAutoTop {
                    autoCountY = (autoCountY + 1)
                }
                if ach.marginAutoBottom {
                    autoCountY = (autoCountY + 1)
                }
            }
            ay = (ay + 1)
        }
        def autoShareY:double 0.0
        if (autoCountY > 0) {
            autoShareY = (freeSpaceY / (to_double autoCountY))
            offsetY = 0.0
            usesDistributeY = false
        }
        def autoRunY:double 0.0
        
        ; Apply offsets to all non-absolute children
        def i:int 0
        def flowIndex:int 0
        while (i < childCount) {
            def child:EVGElement (parent.getChild(i))
            
            ; Skip absolute positioned elements (they're handled separately)
            if (child.isAbsolute == false) {
                ; Apply vertical offset
                def elemOffsetY:double offsetY
                if usesDistributeY {
                    elemOffsetY = (distributeFirstY + (distributeGapY * (to_double flowIndex)))
                }
                if (autoCountY > 0) {
                    if child.marginAutoTop {
                        autoRunY = (autoRunY + autoShareY)
                    }
                    elemOffsetY = autoRunY
                    if child.marginAutoBottom {
                        autoRunY = (autoRunY + autoShareY)
                    }
                }
                if (elemOffsetY != 0.0) {
                    child.calculatedY = child.calculatedY + elemOffsetY
                    ; Propagate to descendants
                    this.propagateOffsetToChildren(child 0.0 elemOffsetY)
                }
                flowIndex = (flowIndex + 1)
                
                ; Apply horizontal alignment (alignItems, or the child's own
                ; align-self where it has one — in a column the cross axis is
                ; the horizontal one).
                def childAlign:string (this.crossAlignIn(true child horizontalAlign))
                def childTotalWidth:double (child.calculatedWidth + child.box.marginLeftPx + child.box.marginRightPx)
                def offsetX:double 0.0
                
                if (childAlign == "center") {
                    offsetX = ((innerWidth - childTotalWidth) / 2.0)
                }
                if ((childAlign == "flex-end") || (childAlign == "end")) {
                    offsetX = (innerWidth - childTotalWidth)
                }
                
                if (offsetX != 0.0) {
                    child.calculatedX = child.calculatedX + offsetX
                    ; Propagate to descendants
                    this.propagateOffsetToChildren(child offsetX 0.0)
                }
            }
            
            i = i + 1
        }
    }
    
    ; Adopt the first in-flow child's baseline, expressed relative to this
    ; element's own top edge.
    fn inheritBaselineFromFirstChild:void (element:EVGElement) {
        def i:int 0
        def n:int (element.getChildCount())
        while (i < n) {
            def c:EVGElement (element.getChild(i))
            if (c.isAbsolute == false) {
                if c.hasBaseline {
                    element.calculatedBaseline = ((c.calculatedY - element.calculatedY) + c.calculatedBaseline)
                    element.calculatedDescent = c.calculatedDescent
                    element.hasBaseline = true
                    return
                }
            }
            i = (i + 1)
        }
        if (element.display == "grid") {
            ext.gridBaseline(this element)
        }
    }

    ; Distance from an element's top MARGIN edge to its baseline. CSS gives a
    ; box with no text baseline the bottom of its margin box, which is what
    ; makes an image in a row of captions sit on the text baseline.
    ; (A flex or grid item's is synthesized from its border box instead,
    ; CSS Align 9.1: `synthBorder` while a flex row that is not a line of
    ; text aligns its items.)
    def synthBorder:boolean false
    ; (and from its top edge where the CSS layer says the line-under side
    ; is the top, `synthTop`)
    def synthTop:boolean false
    fn baselineOffsetOf:double (el:EVGElement) {
        if el.hasBaseline {
            return (el.box.marginTopPx + el.calculatedBaseline)
        }
        if synthTop {
            if synthBorder {
                return el.box.marginTopPx
            }
            return 0.0
        }
        if synthBorder {
            return (el.box.marginTopPx + el.calculatedHeight)
        }
        return (el.box.marginTopPx + el.calculatedHeight + el.box.marginBottomPx)
    }

    fn alignRow:double (rowElements:[EVGElement] parent:EVGElement rowHeight:double startX:double innerWidth:double) {
        ; Apply horizontal and vertical alignment to a row of elements
        def elementCount:int (array_length rowElements)
        if (elementCount == 0) {
            return rowHeight
        }
        
        ; Calculate row width
        def rowWidth:double 0.0
        def i:int 0
        while (i < elementCount) {
            def el:EVGElement (itemAt rowElements i)
            rowWidth = rowWidth + el.calculatedWidth + el.box.marginLeftPx + el.box.marginRightPx
            i = i + 1
        }
        ; THE GAPS ARE PART OF THE ROW. This summed the boxes and forgot the
        ; space the flow had already put between them, so `justify-content:
        ; flex-end` pushed the row right by exactly the total gap and the last
        ; item hung over the end of its container — a footer's two buttons with
        ; an 8px gap ended 8px past the card. `space-between` and friends read
        ; the same number for their free space, so they were out by the same
        ; amount in the other direction.
        def rowGapPx:double 0.0
        if parent.gap.isSet {
            rowGapPx = parent.gap.pixels
        }
        if parent.columnGap.isSet {
            rowGapPx = parent.columnGap.pixels
        }
        if (elementCount > 1) {
            rowWidth = (rowWidth + ((to_double (elementCount - 1)) * rowGapPx))
        }
        ; (a line's first item joined to the one before took no gap back)
        def firstEl:EVGElement (itemAt rowElements 0)
        if (!null? firstEl.css) {
            rowWidth = (rowWidth + (ext.lineStartGap(firstEl rowGapPx)))
        }
        
        ; Determine alignment based on flexDirection
        ; For row direction: justifyContent = horizontal, alignItems = vertical
        ; For column direction: justifyContent = vertical, alignItems = horizontal
        def isColumn:boolean (parent.flexDirection == "column")
        
        ; Get effective alignment values
        def mainAxisAlign:string parent.justifyContent
        def crossAxisAlign:string parent.alignItems
        
        ; Horizontal alignment (justifyContent for row, alignItems for column)
        def horizontalAlign:string mainAxisAlign
        if isColumn {
            horizontalAlign = crossAxisAlign
        }
        ; Legacy 'align' override — but default "left" must not clobber a set
        ; justifyContent/alignItems (left == flex-start is a no-op anyway).
        if ((strlen parent.align) > 0) {
            if (parent.align != "left") {
                horizontalAlign = parent.align
            }
        }
        
        def offsetX:double 0.0
        if (horizontalAlign == "center") {
            offsetX = ((innerWidth - rowWidth) / 2.0)
        }
        if ((horizontalAlign == "flex-end") || (horizontalAlign == "right")) {
            offsetX = (innerWidth - rowWidth)
        }

        ; Space distribution (justifyContent). Applied as an incremental per-item
        ; gap on top of the sequential flow position.
        def freeSpace:double (innerWidth - rowWidth)
        if (freeSpace < 0.0) {
            freeSpace = 0.0
        }
        def distributeGap:double 0.0
        def distributeFirst:double 0.0
        if (horizontalAlign == "space-between") {
            if (elementCount > 1) {
                distributeGap = (freeSpace / (to_double (elementCount - 1)))
            }
        }
        if (horizontalAlign == "space-around") {
            distributeGap = (freeSpace / (to_double elementCount))
            distributeFirst = (distributeGap / 2.0)
        }
        if (horizontalAlign == "space-evenly") {
            distributeGap = (freeSpace / (to_double (elementCount + 1)))
            distributeFirst = distributeGap
        }
        def usesDistribute:boolean ((distributeGap > 0.0) || (distributeFirst > 0.0))

        ; Auto margins along the row take the free space first, shared out
        ; evenly; then there is none left for justify-content
        def autoCount:int 0
        if (isColumn == false) {
            def ac:int 0
            while (ac < elementCount) {
                def ael:EVGElement (itemAt rowElements ac)
                if ael.marginAutoLeft {
                    autoCount = (autoCount + 1)
                }
                if ael.marginAutoRight {
                    autoCount = (autoCount + 1)
                }
                ac = (ac + 1)
            }
        }
        def autoShare:double 0.0
        if (autoCount > 0) {
            autoShare = (freeSpace / (to_double autoCount))
            offsetX = 0.0
            usesDistribute = false
        }
        def autoRun:double 0.0
        
        ; Vertical alignment (alignItems for row, justifyContent for column)
        def verticalAlignVal:string crossAxisAlign
        if isColumn {
            verticalAlignVal = mainAxisAlign
        }
        ; Also check legacy 'verticalAlign' property
        if ((strlen parent.verticalAlign) > 0) {
            if (parent.verticalAlign != "top") {
                verticalAlignVal = parent.verticalAlign
            }
        }
        
        ; The box a child is centred in. `alignItems` places a child inside its
        ; LINE; when the parent cannot wrap there is only one line and the line
        ; IS the content box, so the child may use all of it.
        ;
        ; The old test was `parent.height.isSet`, which asks where the height
        ; came from rather than whether there is one. A divider whose height
        ; came from the group's `align-items: stretch` has a perfectly definite
        ; 298 pixels and no declaration, so it failed the test and its grip
        ; stayed pinned to the top of a divider it was supposed to sit in the
        ; middle of. `hasDefiniteHeight` is the question that was meant:
        ; declared or resolved, the height is known before the children are
        ; placed either way.
        ;
        ; A parent that CAN wrap keeps the old test. There the lines are placed
        ; by `applyAlignContent` and a line is not the box — letting each line
        ; claim the whole box would stack them all on top of one another.
        def effectiveRowHeight:double rowHeight
        def crossBox:double 0.0
        if (parent.flexWrap == "nowrap") {
            if parent.hasDefiniteHeight {
                crossBox = parent.calculatedInnerHeight
            }
        }
        ; (a wrapping one's line is as tall as its items, and align-content
        ; places and grows the lines afterwards, CSS Flexbox 9.4)
        if (crossBox > rowHeight) {
            effectiveRowHeight = crossBox
        }
        ; (a single line in a box of a declared height is that height, even
        ; when an item is taller: CSS Flexbox 9.4 step 15)
        if ((crossBox > 0.0) && parent.height.isSet) {
            effectiveRowHeight = crossBox
        }
        ; (a single line in a box of no definite height is clamped by the
        ; box's min and max height, CSS Flexbox 9.4 step 8)
        if (((parent.flexWrap == "nowrap") && (isColumn == false)) && (parent.hasDefiniteHeight == false)) {
            def lvch:double (parent.box.getVerticalChrome())
            if (parent.maxHeight.isSet && (parent.maxHeight.pixels > 0.0)) {
                if (effectiveRowHeight > (parent.maxHeight.pixels - lvch)) {
                    effectiveRowHeight = (parent.maxHeight.pixels - lvch)
                }
            }
            if (parent.minHeight.isSet && (parent.minHeight.pixels > 0.0)) {
                if (effectiveRowHeight < (parent.minHeight.pixels - lvch)) {
                    effectiveRowHeight = (parent.minHeight.pixels - lvch)
                }
            }
        }

        ; ALIGN-ITEMS: STRETCH IN A ROW WHOSE HEIGHT IS NOT KNOWN YET. The flow
        ; hands a stretch item the row's inner height before the row has one,
        ; so in an auto-height row that is nothing, and the item came out its
        ; content height — a 1px vertical rule came out 0px tall. It used to
        ; look right from the second layout on, because the row's inner height
        ; from the LAST pass was still there to be read; now that a pass starts
        ; from nothing (`EVGElement.resetLayoutNow`), the line is measured here
        ; and each stretch item that is shorter than it is laid out again at
        ; the line's height, which is what CSS does.
        if (isColumn == false) {
            def si:int 0
            while (si < elementCount) {
                def sel:EVGElement (itemAt rowElements si)
                if (((this.crossAlignOf(sel verticalAlignVal)) == "stretch") && (sel.height.isSet == false)) {
                    def target:double ((effectiveRowHeight - sel.box.marginTopPx) - sel.box.marginBottomPx)
                    ; (as tall as the line already, it lays out again when a
                    ; child's percentage height was of its unknown height)
                    def againPct:boolean false
                    if (target > 0.0) {
                        againPct = (EVGLayout.pctHeightKid(sel))
                    }
                    if (((target > (sel.calculatedHeight + 0.01)) || againPct) && ((sel.isHidden()) == false)) {
                        def sx:double sel.calculatedX
                        def sy:double sel.calculatedY
                        sel.calculatedFlexHeight = target
                        ; A kept item resets itself when its handed height
                        ; differs from last time; anything else has only its
                        ; children to clear — its own units were resolved
                        ; against the row, and must not be again.
                        if (sel.keepLayout == false) {
                            def sk:int 0
                            while (sk < (sel.getChildCount())) {
                                def skid:EVGElement (sel.getChild(sk))
                                skid.resetLayoutState()
                                sk = (sk + 1)
                            }
                        }
                        def wasRowS:boolean layingOutAlongRow
                        def wasShrinkS:boolean columnCrossShrinks
                        layingOutAlongRow = true
                        columnCrossShrinks = (this.crossShrinksUnder(parent))
                        this.layoutElement(sel sx sy sel.lastParentW sel.lastParentH)
                        layingOutAlongRow = wasRowS
                        columnCrossShrinks = wasShrinkS
                    }
                }
                si = (si + 1)
            }
        }
        
        ; align-items: baseline — line the row up on the text baselines rather
        ; than on the box edges, so captions of different sizes read as one line.
        ; Needs real ascent metrics, which is why this waited for the font work.
        ; Each item that aligns on the baseline (align-items or its own
        ; align-self) takes part; the line is as tall as the most above the
        ; baseline and the most under it (CSS Flexbox 9.4, step 8)
        def useBaseline:boolean false
        def maxBaseline:double 0.0
        def maxBelow:double 0.0
        def wasSynth:boolean synthBorder
        synthBorder = (ext.synthBorder(parent))
        def wasTop:boolean synthTop
        synthTop = (ext.synthTop(parent))
        ; (last baseline: the items' last baselines in line, the group
        ; packed to the line's end, when the CSS layer does that)
        def useLast:boolean false
        if (isColumn == false) {
            def b:int 0
            while (b < elementCount) {
                def bel:EVGElement (itemAt rowElements b)
                def bal:string (this.rowAlignOf(bel verticalAlignVal))
                if (bal == "baseline") {
                    useBaseline = true
                    def bo:double (this.baselineOffsetOf(bel))
                    if (bo > maxBaseline) {
                        maxBaseline = bo
                    }
                    def under:double (((bel.calculatedHeight + bel.box.marginTopPx) + bel.box.marginBottomPx) - bo)
                    if (under > maxBelow) {
                        maxBelow = under
                    }
                }
                if (bal == "last baseline") {
                    useLast = true
                }
                b = (b + 1)
            }
        }
        def lineOut:double rowHeight
        if (useBaseline && ((maxBaseline + maxBelow) > lineOut)) {
            lineOut = (maxBaseline + maxBelow)
            if (effectiveRowHeight < lineOut) {
                effectiveRowHeight = lineOut
            }
        }
        def maxBelowL:double 0.0
        if useLast {
            def ll:EVGLastLine (ext.lastBaselineLine(this rowElements verticalAlignVal))
            useLast = ll.used
            maxBelowL = ll.below
            if (useLast && ((ll.above + ll.below) > lineOut)) {
                lineOut = (ll.above + ll.below)
                if (effectiveRowHeight < lineOut) {
                    effectiveRowHeight = lineOut
                }
            }
        }

        ; Apply alignment offsets
        i = 0
        while (i < elementCount) {
            def el:EVGElement (itemAt rowElements i)
            
            ; Horizontal offset - also propagate to children!
            def elemOffsetX:double offsetX
            if usesDistribute {
                elemOffsetX = (distributeFirst + (distributeGap * (to_double i)))
            }
            if (autoCount > 0) {
                if el.marginAutoLeft {
                    autoRun = (autoRun + autoShare)
                }
                elemOffsetX = autoRun
                if el.marginAutoRight {
                    autoRun = (autoRun + autoShare)
                }
            }
            if (elemOffsetX != 0.0) {
                el.calculatedX = el.calculatedX + elemOffsetX
                ; Propagate offset to all descendants
                this.propagateOffsetToChildren(el elemOffsetX 0.0)
            }
            
            ; Vertical alignment within row. `align-self` on the item wins
            ; over the container's `align-items`; the row's own baseline pass
            ; is only for the items that did not opt out of it.
            def childTotalHeight:double (el.calculatedHeight + el.box.marginTopPx + el.box.marginBottomPx)
            def offsetY:double 0.0
            def elAlign:string verticalAlignVal
            if (isColumn == false) {
                elAlign = (this.rowAlignOf(el verticalAlignVal))
            }
            if ((elAlign == "last baseline") && useLast) {
                offsetY = ((effectiveRowHeight - maxBelowL) - (ext.lastBaselineOf(this el)))
            }
            
            if (elAlign == "center") {
                offsetY = ((effectiveRowHeight - childTotalHeight) / 2.0)
            }
            if ((elAlign == "flex-end") || (elAlign == "bottom")) {
                offsetY = (effectiveRowHeight - childTotalHeight)
            }
            if (elAlign == "baseline") {
                if useBaseline {
                    offsetY = (maxBaseline - (this.baselineOffsetOf(el)))
                }
            }
            
            if (offsetY != 0.0) {
                el.calculatedY = el.calculatedY + offsetY
                ; Propagate offset to all descendants
                this.propagateOffsetToChildren(el 0.0 offsetY)
            }
            
            i = i + 1
        }
        synthBorder = wasSynth
        synthTop = wasTop
        return lineOut
    }
    
    ; Called right after `parent`'s own box moved by the same offset, so the
    ; parent's paint bounds move here with everything under it: a kept
    ; subtree's bounds are not measured again, and have to stay in step with
    ; its boxes through every move the flow makes after laying it out.
    fn propagateOffsetToChildren:void (parent:EVGElement offsetX:double offsetY:double) {
        parent.paintLeft = (parent.paintLeft + offsetX)
        parent.paintRight = (parent.paintRight + offsetX)
        parent.paintTop = (parent.paintTop + offsetY)
        parent.paintBottom = (parent.paintBottom + offsetY)
        def childCount:int (parent.getChildCount())
        def i:int 0
        while (i < childCount) {
            def child:EVGElement (parent.getChild(i))
            if (offsetX != 0.0) {
                child.calculatedX = child.calculatedX + offsetX
            }
            if (offsetY != 0.0) {
                child.calculatedY = child.calculatedY + offsetY
            }
            ; Recurse to grandchildren
            this.propagateOffsetToChildren(child offsetX offsetY)
            i = i + 1
        }
    }
    
    ; Move a finished subtree, keeping everything inside it in step.
    ; Reflect this container's children about its content box.
    ;
    ; What is reflected is each child's MARGIN box, and the border box is then
    ; put back at its own margin-left inside it. That is CSS's rule and it is
    ; worth being exact about, because the other reading is tempting and
    ; wrong: `margin-left` stays physically on the left in a right-to-left
    ; container. What reverses is the ORDER and the end the children pack
    ; against, not which side of a child its own left margin is on. An author
    ; who wants the margin to follow the direction says `margin-inline-start`.
    ; With symmetric margins — nearly every toolbar and panel — the two
    ; readings agree, which is exactly why picking the wrong one would have
    ; survived a long time before something looked a pixel out.
    ;
    ; Absolutely positioned children are left alone: they were placed against
    ; the edges they name, and `left: 0` means the left edge in any direction.
    fn mirrorChildren:void (parent:EVGElement) {
        if ((parent.resolvedRtl) == false) {
            return
        }
        def left:double ((parent.calculatedX + parent.box.borderWidthPx) + parent.box.paddingLeftPx)
        def right:double (left + parent.calculatedInnerWidth)
        def span:double (left + right)
        def n:int (parent.getChildCount())
        def i:int 0
        while (i < n) {
            def ch:EVGElement (parent.getChild(i))
            ; (auto margins are physical: they place a block's child the
            ; same way in either direction; a grid area is mirrored still)
            def autoX:boolean ((parent.display != "grid") && (ch.marginAutoLeft || ch.marginAutoRight))
            if ((ch.isAbsolute == false) && (autoX == false)) {
                def mL:double ch.box.marginLeftPx
                def mR:double ch.box.marginRightPx
                def marginRightEdge:double ((ch.calculatedX + ch.calculatedWidth) + mR)
                def nx:double ((span - marginRightEdge) + mL)
                this.translateSubtree(ch (nx - ch.calculatedX) 0.0)
            }
            i = (i + 1)
        }
    }

    ; The paint bounds move with the boxes they are the union of — see
    ; `EVGElement.moveSubtree`. Missing that would leave `scrollOnly` culling
    ; against where the content used to be, which is a row that scrolls into
    ; view and stays blank.
    fn translateSubtree:void (element:EVGElement dx:double dy:double) {
        element.moveSubtree(dx dy)
    }

    fn layoutAbsolute:void (element:EVGElement parentWidth:double parentHeight:double) {
        ; Position absolutely positioned element

        ; BOTH EDGES AND NO SIZE IS A STRETCH. CSS 2.1 10.3.7: with `left` and
        ; `right` both set and `width: auto`, the width is what is left of the
        ; containing block between them. Without this the box kept its
        ; content's width and `right` was simply dropped — a bar written
        ; `left: 16; right: 16` came out as wide as its five icons.
        ; (a min-content, max-content or fit-content width is not auto: the
        ; box keeps it, CSS 2.1 10.3.7 with CSS Sizing 3)
        def kwSpanW:boolean ((element.width.unitType >= 6) && (element.width.unitType <= 8))
        def kwSpanH:boolean ((element.height.unitType >= 6) && (element.height.unitType <= 8))
        if (((element.left.isSet && element.right.isSet) && (element.width.isSet == false)) && (kwSpanW == false)) {
            def spanW:double ((((parentWidth - element.left.pixels) - element.right.pixels) - element.box.marginLeftPx) - element.box.marginRightPx)
            ; (min-width wins over the insets, CSS 2.1 10.4)
            if ((element.minWidth.isSet && ((element.minWidth.isPercent()) == false)) && (element.minWidth.pixels > spanW)) {
                spanW = element.minWidth.pixels
            }
            if (spanW > 0.0) {
                element.calculatedWidth = spanW
                element.calculatedInnerWidth = (element.box.getInnerWidth(spanW))
            }
        }
        if (((element.top.isSet && element.bottom.isSet) && (element.height.isSet == false)) && (kwSpanH == false)) {
            def spanH:double ((((parentHeight - element.top.pixels) - element.bottom.pixels) - element.box.marginTopPx) - element.box.marginBottomPx)
            if ((element.minHeight.isSet && ((element.minHeight.isPercent()) == false)) && (element.minHeight.pixels > spanH)) {
                spanH = element.minHeight.pixels
            }
            if (spanH > 0.0) {
                element.calculatedHeight = spanH
                element.calculatedInnerHeight = (element.box.getInnerHeight(spanH))
                element.hasDefiniteHeight = true
            }
        }

        ; X position
        if element.left.isSet {
            element.calculatedX = element.left.pixels + element.box.marginLeftPx
        } {
            if element.x.isSet {
                element.calculatedX = element.x.pixels + element.box.marginLeftPx
            } {
                if element.right.isSet {
                    def width:double element.calculatedWidth
                    if (width == 0.0) {
                        if element.width.isSet {
                            width = element.width.pixels
                        }
                    }
                    element.calculatedX = parentWidth - element.right.pixels - width - element.box.marginRightPx
                }
            }
        }
        
        ; Y position
        if element.top.isSet {
            element.calculatedY = element.top.pixels + element.box.marginTopPx
        } {
            if element.y.isSet {
                element.calculatedY = element.y.pixels + element.box.marginTopPx
            } {
                if element.bottom.isSet {
                    def height:double element.calculatedHeight
                    if (height == 0.0) {
                        if element.height.isSet {
                            height = element.height.pixels
                        }
                    }
                    element.calculatedY = parentHeight - element.bottom.pixels - height - element.box.marginBottomPx
                }
            }
        }
    }
    
    ; How far the in-flow children reach. Out-of-flow children — absolutes and
    ; overlay surfaces — are excluded on purpose: a menu is as wide as its
    ; trigger, not as wide as the panel that hangs off it.
    fn contentExtent:double (element:EVGElement) {
        def right:double 0.0
        def i:int 0
        def n:int (element.getChildCount())
        while (i < n) {
            def c:EVGElement (element.getChild(i))
            if (c.isAbsolute == false) {
                def r:double ((c.calculatedX + c.calculatedWidth) + c.box.marginRightPx)
                if (r > right) {
                    right = r
                }
            }
            i = (i + 1)
        }
        if (right <= 0.0) {
            return 0.0
        }
        return (((right - element.calculatedX) + element.box.paddingRightPx) + element.box.borderWidthPx)
    }

    ; --- overlays --------------------------------------------------------------
    ; Four phases, of which the first is everything above: normal layout, then
    ; anchor rectangles (already computed, because the anchors are ordinary flow
    ; elements), then the overlay placement below, then the display list.
    ;
    ; The walk is top-down and places a surface BEFORE descending into it, which
    ; is what makes a submenu work without knowing it is one: by the time the
    ; Share sub-surface asks where its trigger is, the File surface that
    ; contains that trigger has already moved, so the rectangle it reads is the
    ; real one. Anchor-dependency order falls out of the tree order; there is no
    ; second mechanism for nesting.

    ; Every surface in the tree, placed against the anchor it names. This was
    ; a plain walk of every element on every layout — three milliseconds a
    ; frame on a long diary, to visit six thousand boxes and find the four
    ; that are surfaces.
    ;
    ; The saving is the one `measurePaintBounds` already makes: a subtree the
    ; layout KEPT moved whole, so a surface inside it moved with the anchor it
    ; is placed against and its placement still holds. What the subtree holds
    ; was counted the last time it was really laid out, and the answer is
    ; cached on it — `overlayScanned` is false until a real scan, so a subtree
    ; skipped in a later pass of the same layout is not taken at its word
    ; before it has been asked once.
    ;
    ; Answers whether this subtree holds a surface, which is what lets a
    ; parent cache it too.
    fn placeOverlaysIn:boolean (el:EVGElement) {
        if (el.layoutSkipped && el.overlayScanned) {
            return el.hasOverlayBelow
        }
        def any@(mutable):boolean false
        def i:int 0
        while (i < (array_length el.children)) {
            def c:EVGElement (itemAt el.children i)
            if (c.isSurface()) {
                this.placeOverlay(c el)
                any = true
            }
            if (this.placeOverlaysIn(c)) {
                any = true
            }
            i = (i + 1)
        }
        el.hasOverlayBelow = any
        el.overlayScanned = true
        return any
    }

    ; Three ways to say what a surface is positioned against, in the order
    ; they win:
    ;
    ;   * the element itself, set from code (`overlayAnchor`);
    ;   * `position-anchor`, an `anchor-name` or an `#id` — CSS's own way, and
    ;     the only one that reaches OUT of the surface's own parent, so a menu
    ;     no longer has to be declared beside its trigger;
    ;   * the sibling convention: whichever sibling declared
    ;     `overlay-anchor-role`, which is what lets a factory say
    ;     `(Menu (Trigger …) (Content …))` with nothing joining the two by hand.
    fn findOverlayAnchor@(optional):EVGElement (surface:EVGElement parent:EVGElement) {
        if surface.overlayAnchor {
            return surface.overlayAnchor
        }
        if ((strlen surface.positionAnchor) > 0) {
            def named@(optional):EVGElement (EVGConnector.lookup(surface.positionAnchor anchorNames anchorNodes))
            if (null? named) {
            } {
                return named
            }
        }
        def i:int 0
        while (i < (array_length parent.children)) {
            def c:EVGElement (itemAt parent.children i)
            if c.isOverlayAnchor {
                def hit@(optional):EVGElement c
                return hit
            }
            i = (i + 1)
        }
        def miss@(optional):EVGElement
        return miss
    }

    ; --- collisions ------------------------------------------------------------
    ; The part of a surface that falls off the page cannot be clicked and cannot
    ; be read, so a menu that ignores the edge silently loses rows. Two moves,
    ; in this order, and they are the two every real menu makes:
    ;
    ;   FLIP   the side it opens on, when the asked side does not fit and the
    ;          opposite one does. A menu at the bottom of the page opens
    ;          upwards; a submenu at the right edge opens to the left.
    ;   SHIFT  along the other axis, sliding it back onto the page. This one is
    ;          a slide and not a flip because the side was never the problem.
    ;
    ; Where NEITHER side fits — a surface taller than the page — the roomier
    ; side wins and the surface is clamped to the page. It then covers its
    ; anchor, which is what a browser does too: showing the rows is worth more
    ; than the gap.

    sfn oppositeSide:string (side:string) {
        if (side == "top")    { return "bottom" }
        if (side == "bottom") { return "top" }
        if (side == "left")   { return "right" }
        if (side == "right")  { return "left" }
        return side
    }

    ; How much room there is between the anchor and the page edge on this side,
    ; gap included. Negative means the surface does not fit.
    fn overlayRoom:double (side:string ax:double ay:double aw:double ah:double w:double h:double gap:double) {
        if (side == "top")    { return ((ay - gap) - h) }
        if (side == "bottom") { return ((pageHeight - ((ay + ah) + gap)) - h) }
        if (side == "left")   { return ((ax - gap) - w) }
        if (side == "right")  { return ((pageWidth - ((ax + aw) + gap)) - w) }
        return 0.0
    }

    sfn clampTo:double (v:double lo:double hi:double) {
        if (hi < lo) {
            ; The surface is bigger than the page on this axis. Show the start
            ; of it: the first rows of a menu are the ones it puts its
            ; most-used item in.
            return lo
        }
        if (v < lo) {
            return lo
        }
        if (v > hi) {
            return hi
        }
        return v
    }

    ; --- presentation ----------------------------------------------------------
    ;
    ; anchored | sheet | fullscreen. The one part of this that is not CSS, and
    ; the reason it is not: on a phone an anchored menu is the WRONG WIDGET
    ; rather than a badly placed one. No amount of fallback placement turns a
    ; dropdown into something usable at 390 wide; becoming a sheet along the
    ; bottom edge does. `sheet-below` is the one line that covers the common
    ; case; a `@media` block setting `presentation` is the general route, and
    ; both end up here.
    fn presentationOf:string (surface:EVGElement) {
        def p:string surface.presentation
        if ((strlen p) == 0) {
            p = "anchored"
        }
        if (surface.sheetBelow > 0.0) {
            if (pageWidth <= surface.sheetBelow) {
                p = "sheet"
            }
        }
        return p
    }

    ; A new box for a surface, and its children laid out in it again. A sheet
    ; is as wide as the page and a menu is as wide as its content, so the two
    ; are not the same layout of the same children — text rewraps, a row that
    ; was two lines becomes one. Returns the content height that came out.
    fn resizeSurface:double (surface:EVGElement w:double h:double) {
        surface.calculatedWidth = w
        surface.calculatedHeight = h
        surface.calculatedInnerWidth = (surface.box.getInnerWidth(w))
        surface.calculatedInnerHeight = (surface.box.getInnerHeight(h))
        def kid:int 0
        while (kid < (surface.getChildCount())) {
            def kc:EVGElement (surface.getChild(kid))
            kc.resetLayoutState()
            kid = (kid + 1)
        }
        if ((surface.getChildCount()) == 0) {
            return 0.0
        }
        def content:double (this.layoutChildren(surface))
        this.mirrorChildren(surface)
        return content
    }

    fn setSurfaceHeight:void (surface:EVGElement h:double) {
        surface.calculatedHeight = h
        surface.calculatedInnerHeight = (surface.box.getInnerHeight(h))
    }

    ; A sheet: the page's full width, along its bottom edge, as tall as its
    ; content needs and never taller than the page.
    fn sheetHeight:double (surface:EVGElement) {
        def chrome:double (surface.calculatedHeight - surface.calculatedInnerHeight)
        def had:double surface.calculatedHeight
        def content:double (this.resizeSurface(surface pageWidth had))
        def h:double had
        if ((surface.getChildCount()) > 0) {
            h = (content + chrome)
        }
        if surface.height.isSet {
            h = surface.height.pixels
        }
        if (h > pageHeight) {
            h = pageHeight
            surface.overlayClamped = true
        }
        this.setSurfaceHeight(surface h)
        return h
    }

    ; --- position-try ------------------------------------------------------------
    ;
    ; The areas a surface may be placed in, in the order they are tried: the
    ; one it declared, then `position-try-fallbacks`, then — always — the
    ; opposite side. That last candidate is the FLIP this pass has done since
    ; it was written, kept as the final entry so a surface that declares no
    ; fallbacks behaves exactly as it did before there were any.
    fn tryCandidates:void (surface:EVGElement sides:[string] aligns:[string]) {
        push sides surface.overlaySide
        push aligns surface.overlayAlign
        def spec:string surface.positionTryFallbacks
        if ((strlen spec) > 0) {
            def parts:[string] (EVGLayout.splitList(spec))
            def i:int 0
            while (i < (array_length parts)) {
                def area:string (itemAt parts i)
                def sd:string (EVGElement.areaSide(area))
                if ((strlen sd) == 0) {
                    this.warn(("position-try-fallbacks: \"" + area + "\" is not a position-area"))
                } {
                    push sides sd
                    push aligns (EVGElement.areaAlign(area))
                }
                i = (i + 1)
            }
        }
        push sides (EVGLayout.oppositeSide(surface.overlaySide))
        push aligns surface.overlayAlign
    }

    sfn splitList:[string] (spec:string) {
        def out:[string]
        def cur:string ""
        def i:int 0
        def n:int (strlen spec)
        while (i <= n) {
            def brk:boolean (i == n)
            if (brk == false) {
                if ((charAt spec i) == 44) {
                    brk = true
                }
            }
            if brk {
                def t:string (trim cur)
                if ((strlen t) > 0) {
                    push out t
                }
                cur = ""
            } {
                cur = (cur + (substring spec i (i + 1)))
            }
            i = (i + 1)
        }
        return out
    }

    ; Where one candidate would put the surface, and what it would cost: how
    ; many pixels of it would be off the page, and how much free room is left
    ; on that side. The first number decides whether a candidate is usable at
    ; all; the second is what `position-try-order: most-space` maximises.
    fn overlaySpot:OverlaySpot (side:string align:string ax:double ay:double aw:double ah:double w:double h:double gap:double) {
        def spot (new OverlaySpot())
        def x:double 0.0
        def y:double 0.0
        if (side == "top") {
            x = (this.overlayCross(ax aw w align))
            y = ((ay - h) - gap)
        }
        if (side == "bottom") {
            x = (this.overlayCross(ax aw w align))
            y = ((ay + ah) + gap)
        }
        if (side == "right") {
            x = ((ax + aw) + gap)
            y = (this.overlayCross(ay ah h align))
        }
        if (side == "left") {
            x = ((ax - w) - gap)
            y = (this.overlayCross(ay ah h align))
        }
        if (side == "center") {
            x = ((pageWidth - w) / 2.0)
            y = ((pageHeight - h) / 2.0)
        }
        spot.x = x
        spot.y = y
        spot.room = (this.overlayRoom(side ax ay aw ah w h gap))
        def over:double 0.0
        if (x < 0.0) {
            over = (over - x)
        }
        def right:double ((x + w) - pageWidth)
        if (right > 0.0) {
            over = (over + right)
        }
        if (y < 0.0) {
            over = (over - y)
        }
        def below:double ((y + h) - pageHeight)
        if (below > 0.0) {
            over = (over + below)
        }
        spot.over = over
        return spot
    }

    ; An edge of the anchor, in page coordinates — what `anchor(right)` means.
    sfn anchorEdgeX:double (a:EVGElement side:string) {
        if (side == "right") {
            return (a.calculatedX + a.calculatedWidth)
        }
        if (side == "center") {
            return (a.calculatedX + (a.calculatedWidth / 2.0))
        }
        return a.calculatedX
    }

    sfn anchorEdgeY:double (a:EVGElement side:string) {
        if (side == "bottom") {
            return (a.calculatedY + a.calculatedHeight)
        }
        if (side == "center") {
            return (a.calculatedY + (a.calculatedHeight / 2.0))
        }
        return a.calculatedY
    }

    ; `left: anchor(right)`, `top: calc(anchor(center) - 16px)`: the author has
    ; said where each EDGE goes, so none of the area machinery applies — there
    ; is no side to flip and no alignment to shift. Both insets on an axis
    ; stretch the box between them, the same rule `layoutAbsolute` follows for
    ; `left` and `right` together.
    fn placeByAnchorInsets:void (surface:EVGElement parent:EVGElement) {
        def maybe@(optional):EVGElement (this.findOverlayAnchor(surface parent))
        if (null? maybe) {
            push overlayErrors (surface.id + ": anchor() has no anchor — name one with `position-anchor`")
            return
        }
        def a:EVGElement (unwrap maybe)
        def w:double surface.calculatedWidth
        def h:double surface.calculatedHeight
        def x:double surface.calculatedX
        def y:double surface.calculatedY

        def hasL:boolean ((strlen surface.anchorLeftSide) > 0)
        def hasR:boolean ((strlen surface.anchorRightSide) > 0)
        def hasT:boolean ((strlen surface.anchorTopSide) > 0)
        def hasB:boolean ((strlen surface.anchorBottomSide) > 0)
        def lx:double ((EVGLayout.anchorEdgeX(a surface.anchorLeftSide)) + surface.anchorLeftOffset)
        def rx:double ((EVGLayout.anchorEdgeX(a surface.anchorRightSide)) + surface.anchorRightOffset)
        def ty:double ((EVGLayout.anchorEdgeY(a surface.anchorTopSide)) + surface.anchorTopOffset)
        def by:double ((EVGLayout.anchorEdgeY(a surface.anchorBottomSide)) + surface.anchorBottomOffset)

        if (hasL && hasR) {
            x = lx
            def spanW:double (rx - lx)
            if (spanW > 0.0) {
                this.resizeSurface(surface spanW h)
                w = spanW
            }
        } {
            if hasL {
                x = lx
            }
            if hasR {
                x = (rx - w)
            }
        }
        if (hasT && hasB) {
            y = ty
            def spanH:double (by - ty)
            if (spanH > 0.0) {
                this.setSurfaceHeight(surface spanH)
                h = spanH
            }
        } {
            if hasT {
                y = ty
            }
            if hasB {
                y = (by - h)
            }
        }

        surface.overlayPlacedSide = "anchor"
        surface.overlayPlacedAlign = ""
        surface.overlayPlacedPresentation = "anchored"
        this.finishOverlay(surface x y)
    }

    fn placeOverlay:void (surface:EVGElement parent:EVGElement) {
        def w:double surface.calculatedWidth
        def h:double surface.calculatedHeight
        def x:double 0.0
        def y:double 0.0
        surface.overlayClamped = false
        surface.overlayPlacedAlign = surface.overlayAlign

        ; EDGES BEFORE SIDES. `anchor()` in an inset is a different statement
        ; from `position-area`: it places one edge of this box on one edge of
        ; the anchor, which is what a badge hanging off a corner needs and
        ; what no area can say.
        if (surface.hasAnchorInsets()) {
            this.placeByAnchorInsets(surface parent)
            return
        }

        ; PRESENTATION FIRST, because it decides whether the anchor is
        ; consulted at all. A sheet is not positioned against anything.
        def pres:string (this.presentationOf(surface))
        if (pres == "fullscreen") {
            this.resizeSurface(surface pageWidth pageHeight)
            surface.overlayPlacedSide = "cover"
            surface.overlayPlacedPresentation = "fullscreen"
            this.finishOverlay(surface 0.0 0.0)
            return
        }
        if (pres == "sheet") {
            def sheetH:double (this.sheetHeight(surface))
            surface.overlayPlacedSide = "bottom"
            surface.overlayPlacedAlign = "start"
            surface.overlayPlacedPresentation = "sheet"
            this.finishOverlay(surface 0.0 (pageHeight - sheetH))
            return
        }
        surface.overlayPlacedPresentation = "anchored"

        if (surface.overlaySide == "cover") {
            ; The page itself: a modal's backdrop. It is sized here rather than
            ; with `width: 100%` because a percentage resolves against the
            ; PARENT, and the parent of a dialog's backdrop is whatever part of
            ; the page happened to declare the dialog — a card, a toolbar, a
            ; row. A backdrop that covers its card and not the page is the
            ; thing it exists to prevent.
            x = 0.0
            y = 0.0
            this.resizeSurface(surface pageWidth pageHeight)
            w = pageWidth
            h = pageHeight
            surface.overlayPlacedSide = "cover"
        } {
        if (surface.overlaySide == "center") {
            ; Centred on the page: a modal, which has no anchor by definition.
            if surface.fitViewport {
                if (h > pageHeight) {
                    h = pageHeight
                    this.setSurfaceHeight(surface h)
                    surface.overlayClamped = true
                }
            }
            x = ((pageWidth - w) / 2.0)
            y = ((pageHeight - h) / 2.0)
            surface.overlayPlacedSide = "center"
        } {
        if (surface.overlaySide == "free") {
            ; Wherever it was put. A window someone has dragged has no anchor
            ; and no side: its owner holds the coordinates and this pass takes
            ; them as given. It is still an overlay — out of its parent's flow,
            ; painted above the page, hit-tested in front — and that is the
            ; only reason it comes through here at all.
            ;
            ; Not clamped to the page either. Where a window is allowed to go
            ; is its controller's rule, not the layout's: `WindowCtl` keeps
            ; enough of it on screen to grab, and a different owner might want
            ; a palette that hangs off the edge.
            x = surface.overlayX
            y = surface.overlayY
            surface.overlayPlacedSide = "free"
        } {
            def maybe@(optional):EVGElement (this.findOverlayAnchor(surface parent))
            if (null? maybe) {
                ; Named, not silently at (0,0). An unanchored surface in the
                ; corner looks like a stylesheet mistake and is not one.
                push overlayErrors (surface.id + ": overlay has no anchor — give a sibling `overlay-anchor-role`, name one with `position-anchor`, or use `overlay-side: center`")
                return
            }
            def a:EVGElement (unwrap maybe)
            def ax:double a.calculatedX
            def ay:double a.calculatedY
            def aw:double a.calculatedWidth
            def ah:double a.calculatedHeight
            def gap:double surface.overlayGap

            ; Try each candidate area and take the first that is wholly on the
            ; page — or, with `position-try-order: most-space`, the one with
            ; the most room left over. When NONE fits, the one that hangs off
            ; by the least wins: a surface half off the page is worse than one
            ; that covers its anchor.
            def sides:[string]
            def aligns:[string]
            this.tryCandidates(surface sides aligns)
            def mostSpace:boolean (surface.positionTryOrder == "most-space")
            def bestFit:int (0 - 1)
            def bestFitRoom:double 0.0
            def bestOver:int 0
            def bestOverVal:double 0.0
            def ci:int 0
            while (ci < (array_length sides)) {
                def cs:string (itemAt sides ci)
                def ca:string (itemAt aligns ci)
