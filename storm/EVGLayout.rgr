        }

        ; For image elements, calculate dimensions based on aspect ratio
        ; IMPORTANT: If the parent has fixed dimensions and the image should fill the parent,
        ; use the parent dimensions as the container. The objectFit property handles 
        ; how the actual image content is scaled within this container.
        if ((element.tagName == "image") || (element.tagName == "Image") || (element.tagName == "img")) {
            def imgSrc:string element.src
            if ((strlen imgSrc) > 0) {
                def dims:EVGImageDimensions (imageMeasurer.getImageDimensions(imgSrc))
                if dims.isValid {
                    ; Store source dimensions for objectFit calculations in renderer
                    element.sourceWidth = (to_double dims.width)
                    element.sourceHeight = (to_double dims.height)
                    
                    if (element.width.isSet && (element.height.isSet == false)) {
                        ; Width is set but height is not
                        ; If parent has a fixed height, use it as the container height
                        ; This matches HTML behavior where image container fills parent
                        if (parentHeight > 0.0) {
                            height = parentHeight
                            if debug {
                                this.log(("  Image container using parent height: " + (to_string width) + "x" + (to_string height)))
                            }
                        } {
                            ; No parent height constraint - calculate from aspect ratio
                            height = (width / dims.aspectRatio)
                            if debug {
                                this.log(("  Image aspect ratio: " + (to_string dims.aspectRatio) + " -> height=" + (to_string height)))
                            }
                        }
                        autoHeight = false
                    }
                    if ((element.width.isSet == false) && element.height.isSet) {
                        ; Height is set but width is not
                        ; If parent has a fixed width, use it as the container width
                        if (parentWidth > 0.0) {
                            width = parentWidth
                            if debug {
                                this.log(("  Image container using parent width: " + (to_string width) + "x" + (to_string height)))
                            }
                        } {
                            ; No parent width constraint - calculate from aspect ratio
                            width = (height * dims.aspectRatio)
                            if debug {
                                this.log(("  Image aspect ratio: " + (to_string dims.aspectRatio) + " -> width=" + (to_string width)))
                            }
                        }
                    }
                    if ((element.width.isSet == false) && (element.height.isSet == false)) {
                        ; Neither set - if parent has dimensions, fill parent (like 100% 100%)
                        if ((parentWidth > 0.0) && (parentHeight > 0.0)) {
                            width = parentWidth
                            height = parentHeight
                            if debug {
                                this.log(("  Image filling parent: " + (to_string width) + "x" + (to_string height)))
                            }
                        } {
                            ; No parent constraints - use natural size (capped at parent)
                            width = (to_double dims.width)
                            height = (to_double dims.height)
                            if (width > parentWidth) {
                                if (parentWidth > 0.0) {
                                    def scale:double (parentWidth / width)
                                    width = parentWidth
                                    height = (height * scale)
                                }
                            }
                            if debug {
                                this.log(("  Image natural size: " + (to_string width) + "x" + (to_string height)))
                            }
                        }
                        autoHeight = false
                    }
                }
            }
        }
        
        ; Apply min/max constraints — MAX FIRST, so a min that contradicts it
        ; wins. See `clampMain`; this is the same rule for a box that is not a
        ; flex item, and it used to be the other way round here too.
        if element.maxWidth.isSet {
            if (width > element.maxWidth.pixels) {
                width = element.maxWidth.pixels
            }
        }
        if element.minWidth.isSet {
            if (width < element.minWidth.pixels) {
                width = element.minWidth.pixels
            }
        }
        ; min-width / max-width: min-content | max-content | fit-content
        width = (this.keywordWidth(element width parentWidth))
        
        ; A BOX HAS NO NEGATIVE SIDE. `width: -40%` is not a width — CSS throws
        ; the declaration away — and a box that keeps the number draws MIRRORED
        ; through its own left edge, which is how a progress bar reading "week
        ; -41 of 104" came out as a full blue bar instead of an empty one. The
        ; app's arithmetic is the app's; what this owes it is zero rather than
        ; a picture of a number nobody can see is wrong.
        if (width < 0.0) {
            width = 0.0
        }
        if (height < 0.0) {
            height = 0.0
        }
        ; (nor is it narrower than its padding and border, whatever its
        ; max-width says: CSS Sizing 3, 5.1)
        if (width < (element.box.getHorizontalChrome())) {
            width = (element.box.getHorizontalChrome())
        }

        ; Store calculated dimensions (before content layout for children to reference)
        element.calculatedWidth = width
        element.calculatedInnerWidth = (element.box.getInnerWidth(width))
        
        ; If height is explicitly set (not auto), pre-calculate inner height for children
        ; This allows children with height="100%" to resolve correctly
        element.hasDefiniteHeight = (autoHeight == false)
        if (autoHeight == false) {
            ; (within its min and max: children lay out in the height the box
            ; will have, not in the one it states, CSS 2.1 10.7)
            if (element.maxHeight.isSet && (height > element.maxHeight.pixels)) {
                height = element.maxHeight.pixels
            }
            if (element.minHeight.isSet && (height < element.minHeight.pixels)) {
                height = element.minHeight.pixels
            }
            element.calculatedHeight = height
            element.calculatedInnerHeight = (element.box.getInnerHeight(height))
        } {
            if (!null? element.css) {
                ext.autoInnerHeight(this element parentHeight)
            }
        }
        
        ; Handle absolute positioning
        if element.isAbsolute {
            this.layoutAbsolute(element parentWidth parentHeight)
            ; stretched between `top` and `bottom` it has that height, and
            ; not its content's (which the auto height below would give it)
            if ((element.top.isSet && element.bottom.isSet) && ((element.height.isSet == false) && element.hasDefiniteHeight)) {
                autoHeight = false
                height = element.calculatedHeight
            }
        }
        
        ; Layout children and get content height
        def childCount:int (element.getChildCount())
        def contentHeight:double 0.0
        
        ; (an empty grid is as tall as its rows)
        if ((childCount > 0) || (element.display == "grid")) {
            contentHeight = (this.layoutChildren(element))
            ; Right to left, after the fact.
            ;
            ; Doing it this way rather than inside the placement loops is a
            ; deliberate choice and it is the reason this is ~30 lines instead
            ; of a rewrite of both engines. Every way a container can place a
            ; child along the horizontal axis — flex row, flex row-reverse,
            ; wrapping, `justify-content` in all its values, `gap`, grid
            ; tracks, named grid lines, `dense` packing — ends with children
            ; sitting at x positions inside a content box. Reflecting those
            ; positions about that box turns ALL of it around at once, and
            ; correctly: reversed order, packed from the right, the first grid
            ; column rightmost. Anything added to either engine later is
            ; mirrored the day it lands, without knowing this exists.
            this.mirrorChildren(element)

            ; fit-content, resolved now that there is content to fit.
            ;
            ; The children were placed against the parent's width, because that
            ; is what a width-less box gets in EVG, so this measures what they
            ; actually occupy and lays them out AGAIN inside the smaller box.
            ; The second pass is not optional: justify-content, text-align and
            ; every percentage below aligned against the wider box, and keeping
            ; those positions while narrowing the box is how a "fixed" layout
            ; ends up subtly wrong instead of obviously wrong.
            if ((element.width.unitType == 6) && (keywordW == false)) {
                def fitW:double (this.contentExtent(element))
                ; no narrower than its own min-width says
                if (element.minWidth.isSet && ((element.minWidth.isPercent()) == false)) {
                    if (fitW < element.minWidth.pixels) {
                        fitW = element.minWidth.pixels
                    }
                }
                if ((fitW > 0.0) && (fitW < element.calculatedWidth)) {
                    element.calculatedWidth = fitW
                    element.calculatedInnerWidth = (element.box.getInnerWidth(fitW))
                    def kr:int 0
                    while (kr < childCount) {
                        def kc:EVGElement (element.getChild(kr))
                        kc.resetLayoutState()
                        kr = (kr + 1)
                    }
                    contentHeight = (this.layoutChildren(element))
                    this.mirrorChildren(element)
                }
            }
        } {
            ; No children - check if element has text content
            def textContent:string element.textContent
            if ((strlen textContent) > 0) {
                ; Element has text content (View with text, span, text, Label, etc.)
                def fontSize:double element.inheritedFontSize
                if element.fontSize.isSet {
                    fontSize = element.fontSize.pixels
                }
                if (fontSize <= 0.0) {
                    fontSize = 14.0
                }
                
                ; Get line height
                ; `line-height: normal` — zero here means nobody asked for a
                ; number — is the FACE's own line box, so it is asked of the
                ; thing that knows about faces. It used to be a flat 1.2, which
                ; is a number people type and not one a browser computes: the
                ; sans fallback's normal is 1.15em and monospace's is 1.164.
                ; One answer for the line box, shared with the display list:
                ; `line-height` is a number, a length or `normal`, and only
                ; `EVGElement.lineBoxFor` knows which. `normal` is the FACE's
                ; box and so comes from the engine that knows about faces.
                def lineSpacing:double (element.lineBoxFor(fontSize
                    (textEngine.lineHeightFor((element.effectiveFontFamily()) fontSize))))
                
                ; Line count comes from the shared wrap, not a second estimate,
                ; so the height reserved here matches the lines paint will draw.
                ; THE SAME WIDTH THE PAINTER BREAKS AT. `getInnerWidth` takes
                ; off the border as well as the padding, and it is what
                ; `EVGDisplayList` hands the breaker; this took off only the
                ; padding. A bordered text element was therefore counted at
                ; one width here and broken at another there — the height was
                ; reserved for the wrap the layout imagined and the painter
                ; drew a different one, which is a box the last line falls out
                ; of.
                def availableWidth:double (element.wrapWidth((element.box.getInnerWidth(width))))
                def lineCount:int (textEngine.lineCountSpaced(textContent (element.effectiveFontFamily()) fontSize availableWidth element.letterSpacing))

                contentHeight = (lineSpacing * (to_double lineCount))
                ; And the gaps between paragraphs, which are not line boxes:
                ; reserving them here is what keeps the painter's last line
                ; inside the box it was sized for.
                contentHeight = (contentHeight + (textEngine.paragraphLeading(textContent (element.effectiveFontFamily()) fontSize availableWidth element.letterSpacing element.paragraphSpacing)))

                ; Baseline of the FIRST line, measured from this element's top
                ; border edge, for align-items: baseline. The glyphs sit inside
                ; the line box, so half the leading is above the ascent.
                ;
                ; THE HALF-LEADING MAY BE NEGATIVE, and it used to be clamped at
                ; zero. `line-height: 1` gives a line box smaller than the face
                ; — 1.0em against 1.117 — and CSS lets the glyphs hang out of it
                ; equally top and bottom rather than pushing them down to fit.
                ; Measured: at line-height 1 the browser puts the baseline at
                ; 0.846em, which is exactly -0.0585 + 0.905. The clamp made that
                ; 0.905 and moved every tightly-led line down by the difference.
                def metrics:EVGTextMetrics (textEngine.measureRunSpaced(textContent (element.effectiveFontFamily()) fontSize element.letterSpacing))
                ; (a TrueType measurer gives the descender as the font
                ; table has it, below the baseline and negative)
                def descentAbs:double metrics.descent
