        }
        ; repeat(auto-fill / auto-fit) down the rows: as many as the height
        ; holds, a definite one, else max-height, else min-height
        def rowFitStart:int -1
        def rowFitOthers:int 0
        def rowFitCount:int 0
        if (((indexOf rowTemplateSpec "auto-fill") >= 0) || ((indexOf rowTemplateSpec "auto-fit") >= 0)) {
