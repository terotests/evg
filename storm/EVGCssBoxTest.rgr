; SPDX-License-Identifier: MIT

; ==============================================================================
; EVGCssBoxTest — CSS box rules the W3C WPT layout tests check
; ==============================================================================
;
; Each case is a rule a WPT check-layout test (css-grid, css-flexbox, CSS2)
; found missing, at the sizes Chromium gives:
;
;   1. justify-self / justify-items and auto margins in a grid cell
;   2. aspect-ratio: an auto height from the width
;   3. box-sizing: content-box, with a percentage padding
;   4. align-content: stretch in a wrapping row sizes each line from its
;      items and shares the free space between the lines
;   5. a baseline-aligned line is as tall as the most above the baseline
;      and the most under it
;   6. a fit-content item in a wrapping row is measured as its content,
;      not the whole line, when the row decides where to wrap
;   7. an absolutely positioned child of a flex container with no inset
;      (static-flex) is where justify-content and align-items put it
; ==============================================================================

Import "EVGElement.rgr"
Import "EVGUnit.rgr"
Import "EVGLayout.rgr"

class CssBoxCheck {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn near:boolean (a:double b:double) {
        def d:double (a - b)
        if (d < 0.0) {
            d = (0.0 - d)
        }
        return (d < 0.5)
    }

    fn layoutAt:void (root:EVGElement w:double h:double) {
        def lay (new EVGLayout())
        lay.setPageSize(w h)
        lay.layout(root)
    }

    ; a one-column 300px grid holding one item of the given width
    fn cellGrid:EVGElement (item:EVGElement) {
        def page (EVGElement.createDiv())
        page.setAttribute("width" "300px")
        def g (EVGElement.createDiv())
        g.display = "grid"
        g.setAttribute("grid-template-columns" "300px")
        g.setAttribute("grid-template-rows" "100px")
        g.addChild(item)
        page.addChild(g)
        return page
    }

    fn run:void () {
        print "EVGCssBoxTest"

        ; --- 1. placing in a grid cell -----------------------------------------
        def c1 (EVGElement.createDiv())
        c1.setAttribute("width" "50px")
        c1.setAttribute("height" "20px")
        c1.setAttribute("justify-self" "center")
        def p1:EVGElement (this.cellGrid(c1))
        this.layoutAt(p1 300.0 600.0)
        this.ok("justify-self: center puts a 50px item 125px in" (this.near(c1.calculatedX 125.0)))

        def c2 (EVGElement.createDiv())
        c2.setAttribute("height" "20px")
        c2.setAttribute("justify-self" "end")
        c2.setAttribute("display" "flex")
        c2.setAttribute("flex-direction" "column")
        def kid (EVGElement.createDiv())
        kid.setAttribute("width" "40px")
        kid.setAttribute("height" "10px")
        c2.addChild(kid)
        def p2:EVGElement (this.cellGrid(c2))
        this.layoutAt(p2 300.0 600.0)
        this.ok("justify-self: end keeps a width-less item its content's 40px, at the end" ((this.near(c2.calculatedWidth 40.0)) && (this.near(c2.calculatedX 260.0))))

        def c3 (EVGElement.createDiv())
        c3.setAttribute("width" "60px")
        c3.setAttribute("height" "20px")
        c3.setAttribute("margin" "auto")
        def p3:EVGElement (this.cellGrid(c3))
        this.layoutAt(p3 300.0 600.0)
        this.ok("margin: auto centres an item in its cell" ((this.near(c3.calculatedX 120.0)) && (this.near(c3.calculatedY 40.0))))

        ; --- 2. aspect-ratio ----------------------------------------------------
        def page4 (EVGElement.createDiv())
        page4.setAttribute("width" "400px")
        def r4 (EVGElement.createDiv())
        r4.setAttribute("width" "200px")
        r4.setAttribute("aspect-ratio" "2 / 1")
        page4.addChild(r4)
        this.layoutAt(page4 400.0 600.0)
        this.ok("aspect-ratio: 2 / 1 makes a 200px box 100px tall" (this.near(r4.calculatedHeight 100.0)))

        ; --- 3. box-sizing: content-box ----------------------------------------
        def page5 (EVGElement.createDiv())
        page5.setAttribute("width" "500px")
        def b5 (EVGElement.createDiv())
        b5.setAttribute("box-sizing" "content-box")
        b5.setAttribute("width" "50px")
        b5.setAttribute("height" "100px")
        b5.setAttribute("padding-left" "10%")
        page5.addChild(b5)
        this.layoutAt(page5 500.0 600.0)
        this.ok("content-box: 50px and 10% of 500px padding is 100px wide" ((this.near(b5.calculatedWidth 100.0)) && (this.near(b5.calculatedHeight 100.0))))

        ; --- 4. align-content: stretch -----------------------------------------
        def page6 (EVGElement.createDiv())
        page6.setAttribute("width" "200px")
        def w6 (EVGElement.createDiv())
        w6.setAttribute("display" "flex")
        w6.setAttribute("flex-direction" "row")
        w6.setAttribute("flex-wrap" "wrap")
        w6.setAttribute("align-content" "stretch")
        w6.setAttribute("width" "200px")
        w6.setAttribute("height" "100px")
        def l1 (EVGElement.createDiv())
        l1.setAttribute("width" "100%")
        def l1k (EVGElement.createDiv())
        l1k.setAttribute("height" "10px")
        l1.addChild(l1k)
        def l2 (EVGElement.createDiv())
        l2.setAttribute("width" "100%")
        w6.addChild(l1)
        w6.addChild(l2)
        page6.addChild(w6)
        this.layoutAt(page6 200.0 600.0)
        this.ok("align-content: stretch gives each line its share: 55 and 45" ((this.near(l1.calculatedHeight 55.0)) && ((this.near(l2.calculatedHeight 45.0)) && (this.near(l2.calculatedY 55.0)))))

        ; --- 5. baseline alignment sizes the line ------------------------------
        def page7 (EVGElement.createDiv())
        page7.setAttribute("width" "300px")
        def r7 (EVGElement.createDiv())
        r7.setAttribute("display" "flex")
        r7.setAttribute("flex-direction" "row")
        r7.setAttribute("align-items" "baseline")
        def a7 (EVGElement.createDiv())
        a7.setAttribute("width" "20px")
        a7.setAttribute("height" "30px")
        def b7 (EVGElement.createDiv())
        b7.setAttribute("display" "flex")
        b7.setAttribute("flex-direction" "column")
        b7.setAttribute("width" "40px")
        b7.setAttribute("height" "50px")
        def t7 (EVGElement.createSpan())
        t7.setAttribute("font-size" "10px")
        t7.textContent = "x"
        b7.addChild(t7)
        r7.addChild(a7)
        r7.addChild(b7)
        page7.addChild(r7)
        this.layoutAt(page7 300.0 600.0)
        def bb:double (b7.calculatedBaseline)
        this.ok("baseline: the picture's bottom on the text's baseline" (this.near((a7.calculatedY + 30.0) (b7.calculatedY + bb))))
        this.ok("baseline: the line holds both (30 above, the rest of 50 under)" (this.near(r7.calculatedHeight ((30.0 + 50.0) - bb))))

        ; --- 6. fit-content in a wrapping row -------------------------------------
        def page8 (EVGElement.createDiv())
        page8.setAttribute("width" "300px")
        def r8 (EVGElement.createDiv())
        r8.setAttribute("display" "flex")
        r8.setAttribute("flex-direction" "row")
        r8.setAttribute("flex-wrap" "wrap")
        def a8 (EVGElement.createDiv())
        a8.setAttribute("width" "100px")
        a8.setAttribute("height" "20px")
        def g8 (EVGElement.createDiv())
        g8.display = "grid"
        g8.setAttribute("width" "fit-content")
        g8.setAttribute("grid-template-columns" "50px")
        def k8 (EVGElement.createDiv())
        k8.setAttribute("height" "20px")
        g8.addChild(k8)
        r8.addChild(a8)
        r8.addChild(g8)
        page8.addChild(r8)
        this.layoutAt(page8 300.0 600.0)
        this.ok("fit-content: a 50px grid stays beside a 100px box" ((this.near(g8.calculatedY a8.calculatedY)) && (this.near(g8.calculatedX 100.0))))

        ; --- 7. static position in a flex container -----------------------------
        def page9 (EVGElement.createDiv())
        page9.setAttribute("width" "300px")
        def f9 (EVGElement.createDiv())
        f9.setAttribute("display" "flex")
        f9.setAttribute("flex-direction" "row")
        f9.setAttribute("justify-content" "center")
        f9.setAttribute("align-items" "flex-end")
        f9.setAttribute("width" "100px")
        f9.setAttribute("height" "50px")
        def a9 (EVGElement.createDiv())
        a9.setAttribute("position" "absolute")
        a9.setAttribute("top" "0px")
        a9.setAttribute("left" "0px")
        a9.setAttribute("static-flex" "true")
        a9.setAttribute("width" "20px")
        a9.setAttribute("height" "10px")
        f9.addChild(a9)
        page9.addChild(f9)
        this.layoutAt(page9 300.0 600.0)
        this.ok("static-flex: centred along the row, at the cross end" ((this.near((a9.calculatedX - f9.calculatedX) 40.0)) && (this.near((a9.calculatedY - f9.calculatedY) 40.0))))

        ; --- 8. implicit grid tracks ----------------------------------------------
        ; No templates: grid-column 2 makes a second auto column, and the
        ; two auto rows share a definite height (align-content stretch).
        def page10 (EVGElement.createDiv())
        page10.setAttribute("width" "300px")
        def g10 (EVGElement.createDiv())
        g10.setAttribute("display" "grid")
        g10.setAttribute("align-content" "stretch")
        g10.setAttribute("width" "200px")
        g10.setAttribute("height" "200px")
        def b10 (EVGElement.createDiv())
        b10.setAttribute("grid-row" "2")
        b10.setAttribute("grid-column" "2")
        b10.setAttribute("height" "10px")
        def c10 (EVGElement.createDiv())
        c10.setAttribute("grid-row" "1")
        c10.setAttribute("grid-column" "1")
        c10.setAttribute("height" "10px")
        g10.addChild(c10)
        g10.addChild(b10)
        page10.addChild(g10)
        this.layoutAt(page10 300.0 600.0)
        this.ok("implicit tracks: item at column 2 / row 2 sits at 100,100" ((this.near((b10.calculatedX - g10.calculatedX) 100.0)) && (this.near((b10.calculatedY - g10.calculatedY) 100.0))))

        def g11 (EVGElement.createDiv())
        g11.setAttribute("display" "grid")
        g11.setAttribute("grid-auto-rows" "30px")
        g11.setAttribute("width" "200px")
        def a11 (EVGElement.createDiv())
        def b11 (EVGElement.createDiv())
        b11.setAttribute("grid-row" "2")
        g11.addChild(a11)
        g11.addChild(b11)
        def page11 (EVGElement.createDiv())
        page11.setAttribute("width" "300px")
        page11.addChild(g11)
        this.layoutAt(page11 300.0 600.0)
        this.ok("grid-auto-rows: 30px rows" (this.near((b11.calculatedY - g11.calculatedY) 30.0)))

        print ""
        print ((("Passed: " + (to_string passed)) + "  Failed: ") + (to_string failed))
        if (failed > 0) {
            print "FAILED"
        } {
            print "OK"
        }
    }

    sfn m@(main):void () {
        def c (new CssBoxCheck())
        c.run()
    }
}
