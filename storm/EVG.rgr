; Package entry for `Import "pkg:evg"`. Individual files stay importable as
; `Import "pkg:evg/EVGColor.rgr"`. Relative imports inside this tree are
; unchanged (`Import "EVGElement.rgr"`).
;
; EVG 3.0 Storm — canonical sources live in this repository
; (github.com/terotests/evg), not in Ranger/lib/evg.

Import "EVGElement.rgr"
Import "EVGUnit.rgr"
Import "EVGLayout.rgr"
Import "EVGDisplayList.rgr"
Import "EVGStyleSheet.rgr"
Import "EVGTransition.rgr"
