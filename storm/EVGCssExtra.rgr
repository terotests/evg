; ==============================================================================
; EVGCssExtra — the flags only the CSS conformance layer reads
; ==============================================================================
;
; A CSS front end (MfdDomView) marks boxes with what a CSS layout needs and
; EVG's own model does not have: containing blocks above the parent, static
; places of absolute boxes, line rows, synthesized baselines. They live here,
; in one object an element allocates the first time one of them is set, so an
; element that has none (every element of a Lite layout) carries one pointer
; for all of them. EVGLayoutFull (EVGLayoutExt) is what reads them; the core
; layout only asks whether an element has the object at all.

class EVGCssExtra {
    ; joined to the item before it with no gap: its margin-left takes the
    ; row's column-gap back, which at the start of a wrapped line there is
    ; none to take (line-join: true)
    def lineJoin:boolean false
    ; a box that is not a containing block for percentage heights (a line):
    ; its children's percentages are of its parent's height
    ; (height-through: true)
    def heightThrough:boolean false
    ; an absolutely positioned child of a CSS flex container with no inset:
    ; its static position is where justify-content and align-self put it
    ; as the container's only item (CSS Flexbox 4.1)
    def staticFlex:boolean false
    ; in a grid area, the one axis ("x" or "y") with no inset, which
    ; justify-self / align-self place along (static-flex: x or y)
    def staticAxis:string ""
    ; an absolutely positioned child of a block with no inset: its static
    ; place is under the in-flow boxes before it (static-flow: true)
    def staticFlow:boolean false
    ; an absolutely positioned box with no positioned box around it: its
    ; insets are from the page's corner (icb: x, y or xy)
    def icbX:boolean false
    def icbY:boolean false
    ; a positioned box: the containing block of the absolute boxes inside
    ; it whose own parent is not (cb: true)
    def isCb:boolean false
    ; an absolute box whose containing block is a positioned box further
    ; up, laid out again in it along the axes with an inset (cb-outer: x, y
    ; or xy)
    def cbOuterX:boolean false
    def cbOuterY:boolean false
    ; (cb-outer with s: its percentage sizes are of that block too, its
    ; place stays where its parent put it)
    def cbOuterSize:boolean false
    ; (cb-outer with c: a grid's absolute child whose containing block is
    ; not the grid has the grid's content box for its static place)
    def cbOuterStatic:boolean false
    ; a grid with percentage rows and no definite height: its content
    ; height from the first pass, the rows sized again in it (-1: none)
    def pctRowsHeight:double -1.0
    ; a CSS flex container (flex-box: true): its baseline is its first
    ; item's, synthesized from that item's border box when it has none
    def flexBox:boolean false
    ; a line with no text: its baseline this far above its bottom
    ; (baseline-from-bottom; -1 when not said)
    def baseFromBottom:double -1.0
    ; (or this far under its top: baseline-from-top, a line of boxes at
    ; its top and the strut there)
    def baseFromTop:double -1.0
    ; an inline-block: its baseline is its last line's (baseline-last)
    def lastBase:boolean false
    ; border sides of unequal widths that the front end gave EVG as padding
    ; (EVG's border is one width): the padding edge is this far inside
    ; (folded-border: top right bottom left)
    ; text set in a vertical line: its baselines are the lines' middles,
    ; the central baseline (baseline-central: true)
    def central:boolean false
    ; a box turned over across its block axis after the layout (a vertical
    ; box in the other vertical mode than its parent's): its first and last
    ; baselines are each other's, from the other side (baseline-flip: true)
    def flipBase:boolean false
    ; a box whose first child is not one of its lines (a fieldset's
    ; legend): its baseline is the first of the others' (skip-first-baseline)
    def skipFirst:boolean false
    ; text whose lines lie the other way up (sideways in vertical-lr): its
    ; baselines are as far from each line's top as they were from its
    ; bottom (baseline-under: true)
    def under:boolean false
    ; a container in such a mode: an item with no baseline has it at its
    ; top, the line-under side (baseline-synth-top: true)
    def synthTop:boolean false
    def flipDone:boolean false
    def flipLast:double 0.0
    ; a row of floats (float-row: true) and its floats' sides
    ; (float-side: left or right): laid out by the float rules of CSS 2.1
    ; 9.5.1 instead of as wrapped flex lines
    def floatRow:boolean false
    def floatSide:string ""
    ; a box that clears the floats before it (clear-floats: true): its top
    ; goes under their bottom
    def clearFloats:boolean false
    ; (left or right: only those floats; true: both)
    def clearSide:string ""
    ; (clear-margin: the top margin of a box that clears, taken in by any
    ; clearance and kept when there is none)
    def clearMargin:double 0.0
    ; a block in the flow right after floats (beside-floats: true): its
    ; content is moved past the floats beside its top
    def besideFloats:boolean false
    ; a formatting context in the flow after floats (beside-floats: bfc):
    ; its border box goes where it fits beside them, moved down past their
    ; bottoms until it does (CSS 2.1 9.5)
    def bfcFloats:boolean false
    ; a block formatting context whose float rows take no room in its flow
    ; (float-holder: true): it is as tall as its floats reach
    def floatHolder:boolean false
    ; (pct-auto: true): its percentage height is auto while its parent's
    ; height is not known
    def pctAuto:boolean false
    ; (contain-w: px): the width its content counts as, size containment
    ; (CSS Containment 3.2); -1 when its content counts
    def containW:double -1.0
    ; a sticky box's top / left inset (sticky-top, sticky-left: px), kept
    ; from its scrollport's edge at scroll position 0; -1: none
    def stickyTop:double -1.0
    ; an absolute or fixed box out of the clips of this many boxes around
    ; it, the nearest ones: drawn after them and not moved by their scroll
    ; (escape-clip: n)
    def escapeClip:int 0
    ; an atomic inline (inline-block, inline-table): painted with the
    ; inline content of its stacking context, after the block backgrounds
    ; (inline-atomic: true)
    def inlineAtomic:boolean false
    def stickyLeft:double -1.0
    def stickyBottom:double -1.0
    def stickyRight:double -1.0
    ; border sides that differ in width or color (side-borders: top right
    ; bottom left widths, then | and each side's color): the front end
    ; folded them into the padding, the display list paints them there
    ; a positioned box (paint-late: true): painted after its in-flow
    ; siblings, as CSS 2.1 Appendix E paints positioned descendants
    def paintLate:boolean false
    ; a background picture (bg-picture: part|natural width|natural
    ; height|repeat|x y|size): the display list tiles it over the box
    def bgSrc:string ""
    ; the root's background, painted over the whole canvas (bg-canvas:
    ; the viewport's width and height); 0: not the root
    def canvasW:double 0.0
    def canvasH:double 0.0
    def bgNatW:double 0.0
    def bgNatH:double 0.0
    def bgRepeat:string ""
    def bgPos:string ""
    def bgSize:string ""
    ; background-attachment: fixed (a seventh part, `fixed vw vh`): the
    ; positioning area is the viewport, of that width and height, and not
    ; the box
    def bgFixed:boolean false
    def bgVw:double 0.0
    def bgVh:double 0.0
    def sideBorders:boolean false
    def sbW:[double]
    def sbC:[EVGColor]
    ; each side's border-style when one is dotted or dashed ("" otherwise)
    def sbS:[string]
    def foldT:double 0.0
    def foldR:double 0.0
    ; a grid-lanes container (grid-lanes: column or row, then fill-reverse
    ; and track-reverse when given): its items go down (or along) the lane
    ; that is filled least, CSS Grid 3
    def lanes:string ""
    ; its flow-tolerance (lanes-tolerance: px; -1: normal, 1em)
    def laneTol:double -1.0
    def foldB:double 0.0
    def foldL:double 0.0

    ; the attribute names that are kept here
    sfn owns:boolean (name:string) {
        return ((name == "line-join") || ((name == "height-through") || ((name == "static-flex") || ((name == "static-flow") || ((name == "icb") || ((name == "cb") || ((name == "cb-outer") || ((name == "flex-box") || ((name == "baseline-from-bottom") || ((name == "baseline-from-top") || ((name == "baseline-last") || ((name == "folded-border") || ((name == "side-borders") || ((name == "bg-picture") || ((name == "bg-canvas") || ((name == "paint-late") || ((name == "baseline-central") || ((name == "baseline-flip") || ((name == "skip-first-baseline") || ((name == "baseline-under") || ((name == "baseline-synth-top") || ((name == "float-row") || ((name == "float-side") || ((name == "clear-floats") || ((name == "beside-floats") || ((name == "float-holder") || ((name == "inline-atomic") || ((name == "clear-margin") || ((name == "escape-clip") || ((name == "sticky-top") || ((name == "sticky-left") || ((name == "sticky-bottom") || ((name == "sticky-right") || ((name == "pct-auto") || ((name == "contain-w") || ((name == "grid-lanes") || (name == "lanes-tolerance"))))))))))))))))))))))))))))))))))))))
    }

    fn set:void (name:string value:string) {
        if (name == "line-join") {
            lineJoin = (value == "true")
            return
        }
        if (name == "grid-lanes") {
            lanes = value
            return
        }
        if (name == "lanes-tolerance") {
            laneTol = (?? (to_double value) -1.0)
            return
        }
        if (name == "height-through") {
            heightThrough = (value == "true")
            return
        }
        if (name == "static-flex") {
            staticFlex = (value == "true")
            if ((value == "x") || (value == "y")) {
                staticAxis = value
            }
            return
        }
        if (name == "static-flow") {
            staticFlow = (value == "true")
            return
        }
        if (name == "icb") {
            icbX = ((indexOf value "x") >= 0)
            icbY = ((indexOf value "y") >= 0)
            return
        }
        if (name == "cb") {
            isCb = (value == "true")
            return
        }
        if (name == "cb-outer") {
            cbOuterX = ((indexOf value "x") >= 0)
            cbOuterY = ((indexOf value "y") >= 0)
            cbOuterSize = ((indexOf value "s") >= 0)
            cbOuterStatic = ((indexOf value "c") >= 0)
            return
        }
        if (name == "flex-box") {
            flexBox = (value == "true")
            return
        }
        if (name == "baseline-flip") {
            flipBase = (value == "true")
            return
        }
        if (name == "float-row") {
            floatRow = (value == "true")
            return
        }
        if (name == "clear-margin") {
            clearMargin = (?? (to_double value) 0.0)
            return
        }
        if (name == "clear-floats") {
            clearFloats = ((value == "true") || ((value == "left") || (value == "right")))
            clearSide = value
            return
        }
        if (name == "beside-floats") {
            besideFloats = (value == "true")
            bfcFloats = (value == "bfc")
            return
        }
        if (name == "pct-auto") {
            pctAuto = (value == "true")
        }
        if (name == "contain-w") {
            def cwv@(optional):double (to_double value)
            if cwv {
                containW = (unwrap cwv)
            }
        }
        if (name == "float-holder") {
            floatHolder = (value == "true")
            return
        }
        if (name == "inline-atomic") {
            inlineAtomic = (value == "true")
            return
        }
        if (name == "escape-clip") {
            escapeClip = (?? (to_int value) 0)
            return
        }
        if (name == "sticky-top") {
            stickyTop = (?? (to_double value) -1.0)
            return
        }
        if (name == "sticky-left") {
            stickyLeft = (?? (to_double value) -1.0)
            return
        }
        if (name == "sticky-bottom") {
            stickyBottom = (?? (to_double value) -1.0)
            return
        }
        if (name == "sticky-right") {
            stickyRight = (?? (to_double value) -1.0)
            return
        }
        if (name == "float-side") {
            floatSide = value
            return
        }
        if (name == "skip-first-baseline") {
            skipFirst = (value == "true")
            return
        }
        if (name == "baseline-under") {
            under = (value == "true")
            return
        }
        if (name == "baseline-synth-top") {
            synthTop = (value == "true")
            return
        }
        if (name == "baseline-central") {
            central = (value == "true")
            return
        }
        if (name == "paint-late") {
            paintLate = (value == "true")
            return
        }
        if (name == "bg-canvas") {
            def cp:[string] (strsplit (trim value) " ")
            if ((array_length cp) == 2) {
                canvasW = (EVGCssExtra.num((itemAt cp 0)))
                canvasH = (EVGCssExtra.num((itemAt cp 1)))
            }
            return
        }
        if (name == "bg-picture") {
            def bp:[string] (strsplit value "|")
            if ((array_length bp) == 7) {
                def fp:[string] (strsplit (trim (itemAt bp 6)) " ")
                if (((array_length fp) == 3) && ((itemAt fp 0) == "fixed")) {
                    bgFixed = true
                    bgVw = (EVGCssExtra.num((itemAt fp 1)))
                    bgVh = (EVGCssExtra.num((itemAt fp 2)))
                }
            }
            if ((array_length bp) >= 6) {
                bgSrc = (itemAt bp 0)
                bgNatW = (EVGCssExtra.num((itemAt bp 1)))
                bgNatH = (EVGCssExtra.num((itemAt bp 2)))
                bgRepeat = (itemAt bp 3)
                bgPos = (itemAt bp 4)
                bgSize = (itemAt bp 5)
            }
            return
        }
        if (name == "side-borders") {
            def sp:[string] (strsplit value "|")
            if ((array_length sp) >= 5) {
                def wp:[string] (strsplit (trim (itemAt sp 0)) " ")
                if ((array_length wp) == 4) {
                    sideBorders = true
                    def nw:[double]
                    def nc:[EVGColor]
                    def si:int 0
                    while (si < 4) {
                        push nw (EVGCssExtra.num((itemAt wp si)))
                        push nc (EVGColor.parse((trim (itemAt sp (si + 1)))))
                        si = (si + 1)
                    }
                    sbW = nw
                    sbC = nc
                    ; an optional sixth part: the four sides' styles
                    if ((array_length sp) == 6) {
                        def stp:[string] (strsplit (trim (itemAt sp 5)) " ")
                        if ((array_length stp) == 4) {
                            sbS = stp
                        }
                    }
                }
            }
            return
        }
        if (name == "folded-border") {
            def fp:[string] (strsplit (trim value) " ")
            if ((array_length fp) == 4) {
                foldT = (EVGCssExtra.num((itemAt fp 0)))
                foldR = (EVGCssExtra.num((itemAt fp 1)))
                foldB = (EVGCssExtra.num((itemAt fp 2)))
                foldL = (EVGCssExtra.num((itemAt fp 3)))
            }
            return
        }
        if (name == "baseline-from-bottom") {
            def bfb@(optional):double (str2double value)
            if (!null? bfb) {
                baseFromBottom = (unwrap bfb)
            }
            return
        }
        if (name == "baseline-last") {
            lastBase = (value == "true")
            return
        }
        if (name == "baseline-from-top") {
            def bft@(optional):double (str2double value)
            if (!null? bft) {
                baseFromTop = (unwrap bft)
            }
            return
        }
    }

    sfn num:double (v:string) {
        def d@(optional):double (str2double v)
        if (!null? d) {
            return (unwrap d)
        }
        return 0.0
    }

    fn copy:EVGCssExtra () {
        def c (new EVGCssExtra())
        c.lineJoin = lineJoin
        c.heightThrough = heightThrough
        c.staticFlex = staticFlex
        c.staticAxis = staticAxis
        c.staticFlow = staticFlow
        c.icbX = icbX
        c.icbY = icbY
        c.isCb = isCb
        c.cbOuterX = cbOuterX
        c.cbOuterY = cbOuterY
        c.cbOuterSize = cbOuterSize
        c.cbOuterStatic = cbOuterStatic
        c.flexBox = flexBox
        c.baseFromBottom = baseFromBottom
        c.baseFromTop = baseFromTop
        c.lastBase = lastBase
        c.central = central
        c.flipBase = flipBase
        c.skipFirst = skipFirst
        c.under = under
        c.synthTop = synthTop
        c.floatRow = floatRow
        c.floatSide = floatSide
        c.clearFloats = clearFloats
        c.clearSide = clearSide
        c.clearMargin = clearMargin
        c.besideFloats = besideFloats
        c.bfcFloats = bfcFloats
        c.floatHolder = floatHolder
        c.pctAuto = pctAuto
        c.containW = containW
        c.stickyTop = stickyTop
        c.escapeClip = escapeClip
        c.inlineAtomic = inlineAtomic
        c.stickyLeft = stickyLeft
        c.stickyBottom = stickyBottom
        c.stickyRight = stickyRight
        c.foldT = foldT
        c.paintLate = paintLate
        c.canvasW = canvasW
        c.canvasH = canvasH
        c.bgSrc = bgSrc
        c.bgNatW = bgNatW
        c.bgNatH = bgNatH
        c.bgRepeat = bgRepeat
        c.bgPos = bgPos
        c.bgSize = bgSize
        c.sideBorders = sideBorders
        c.sbW = sbW
        c.sbC = sbC
        c.sbS = sbS
        c.foldR = foldR
        c.foldB = foldB
        c.foldL = foldL
        c.lanes = lanes
        c.laneTol = laneTol
        return c
    }
}
